// строка GB: 160 px -> 240 px, сразу пишем в поток DMA
// статистика коллбэка (для диагностики кадра)
static uint32_t cbAccUs = 0, cbCalls = 0;

// Одна строка панели: собрали — отправили.
// ВАЖНО (нашёл санитайзер на стенде): буфер объявлен uint32_t[], а НЕ uint8_t[].
// Причина — строка собирается 32-битной записью (*(uint32_t*)&buf[i] = цвет).
// Массив uint8_t формально выровнен на 1 байт, и на Cortex-M0+ невыровненная
// 32-битная запись — АППАРАТНЫЙ СБОЙ. Пока везло с адресом; теперь это
// гарантировано типом. Байтовый вид — через приведение, там, где нужно.
static uint32_t tx_rowbuf[ROW_BYTES / 4];

// ============================================================ свидетели смерти (v8.8)
// Регистры ядра M0+. Обращаемся ПО АДРЕСАМ, а не через CMSIS: так этот же код
// собирается и на компьютере — в стенде адреса подменяются переменными стенда
// (сборка стенда идёт с -DGBEMU_HOST).
#ifdef GBEMU_HOST
extern volatile uint32_t gHostVtor;                        // куда записали VTOR (для проверки)
extern const uint32_t *gHostVtorSrc(void);                 // откуда читать «таблицу векторов»
extern void gHostVtorSet(const uint32_t *tab);
extern volatile uint32_t gHostCfsr, gHostHfsr, gHostMmfar, gHostBfar;
extern volatile uint32_t gHostDfsr, gHostAfsr;
extern volatile uint32_t gHostChipReset;
#define SYS_VTOR_GET()  gHostVtorSrc()
#define SYS_VTOR_SET(t) gHostVtorSet(t)
#define SYS_CFSR  ((uint32_t)gHostCfsr)
#define SYS_HFSR  ((uint32_t)gHostHfsr)
#define SYS_MMFAR ((uint32_t)gHostMmfar)
#define SYS_BFAR  ((uint32_t)gHostBfar)
#define SYS_DFSR  ((uint32_t)gHostDfsr)
#define SYS_AFSR  ((uint32_t)gHostAfsr)
#else
// На устройстве — настоящие регистры ядра M0+ (SCB), по адресам: так этот же код
// собирается и на компьютере (в стенде адреса подменяются, см. выше).
#define SYS_VTOR_GET()  ((const uint32_t *)(uintptr_t)(*(volatile uint32_t *)0xE000ED08u))
#define SYS_VTOR_SET(t) (*(volatile uint32_t *)0xE000ED08u = (uint32_t)(uintptr_t)(t))
#define SYS_CFSR  ((uint32_t)(*(volatile uint32_t *)0xE000ED28u))   // SCB->CFSR
#define SYS_HFSR  ((uint32_t)(*(volatile uint32_t *)0xE000ED2Cu))   // SCB->HFSR
#define SYS_MMFAR ((uint32_t)(*(volatile uint32_t *)0xE000ED34u))   // SCB->MMFAR
#define SYS_BFAR  ((uint32_t)(*(volatile uint32_t *)0xE000ED38u))   // SCB->BFAR
#define SYS_DFSR  ((uint32_t)(*(volatile uint32_t *)0xE000ED30u))   // SCB->DFSR
#define SYS_AFSR  ((uint32_t)(*(volatile uint32_t *)0xE000ED3Cu))   // SCB->AFSR
#endif

static void blkWrite(void);                    // объявлен заранее: нужен при смерти
static void blkFlush(bool allowErase);         // сброс кольца ОЗУ во flash (выключение/смерть)
static volatile uint32_t gDieA = 0, gDieB = 0, gDieC = 0, gDieD = 0;   // подробности смерти
static bool gInDieReport = false;              // пишем ящик из отчёта о смерти (тогда звук не трогаем)
static uint32_t gFaultPc = 0, gFaultLr = 0;    // где именно зацепило (для лога)
// Свидетели стека. Кадр исключения испорчен (CFSR=0, HFSR=0) ровно тогда, когда
// сбой случился на УКЛАДКЕ стека — то есть когда указатель стека был плохой.
// Поэтому записываем сам SP, оба указателя (MSP/PSP) и «глубину» стека.
static uint32_t gFaultSp = 0, gFaultMsp = 0, gFaultPsp = 0, gFaultXpsr = 0;
static uint32_t gStackTop = 0;                 // MSP на старте = верх стека
static uint32_t gStackMin = 0;                 // самый глубокий MSP за сеанс
#define STACK_PAINT     512u                   // сколько красить ниже верхушки (для проверки)
static uint32_t gStackPaintLo = 0;             // докуда закрасили

static inline uint32_t readMsp(void) {         // без CMSIS: MRS есть в Thumb-1 на M0+
#ifndef GBEMU_HOST
  uint32_t v; __asm volatile ("mrs %0, msp" : "=r"(v)); return v;
#else
  return 0;
#endif
}
static inline uint32_t readPsp(void) {
#ifndef GBEMU_HOST
  uint32_t v; __asm volatile ("mrs %0, psp" : "=r"(v)); return v;
#else
  return 0;
#endif
}
static inline void stackWitness(void) {        // позвать в глубоких местах
#ifndef GBEMU_HOST
  const uint32_t sp = readMsp() & ~3u;
  if (!gStackMin || sp < gStackMin) gStackMin = sp;
#endif
}
static uint32_t stackUseBytes(void) {          // сколько байт стека ушло за сеанс
  if (!gStackTop || !gStackMin) return 0;
  return (gStackTop > gStackMin) ? (gStackTop - gStackMin) : 0;
}

static const char *faultWhy(uint32_t cfsr, uint32_t hfsr) {
  if (cfsr & (1u << 9))  return "чтение из запретной области (ошибка шины)";
  if (cfsr & (1u << 10)) return "запись в запретную область (ошибка шины)";
  if (cfsr & (1u << 1))  return "обращение по нечётному адресу (M0+ так не умеет)";
  if (cfsr & (1u << 16)) return "непонятная инструкция";
  if (hfsr & (1u << 30)) return "сбой выдан из-за другого сбоя";
  return "неизвестно";
}

// Что печатать в момент смерти
static void printWhere(void) {
  Serial.print(F("   фаза "));         Serial.print(phaseName(gPhase));
  Serial.print(F(", кадр "));         Serial.print(gFramesTotal);
  Serial.print(F(", прожили "));      Serial.print(millis() / 1000); Serial.println(F(" с"));
  Serial.print(F("   игра: PC=0x"));   Serial.print((uint32_t)gb.cpu_reg.pc.reg, HEX);
  Serial.print(F(" SP=0x"));          Serial.print((uint32_t)gb.cpu_reg.sp.reg, HEX);
  Serial.print(F("  строка ЖК "));     Serial.print((unsigned)gb.hram_io[IO_LY]);
  Serial.print(F("  ЖК "));           Serial.print(gLcdOn ? F("включён") : F("ВЫКЛЮЧЕН"));
  Serial.print(F("  строк на панель ")); Serial.print(frameRows);
  Serial.print(F(" (пропущено ")); Serial.print(frameSkip);
  Serial.print(F(")  строк от ядра ")); Serial.println(frameLineCore);
  if (gFaultSp || gFaultMsp || gFaultPsp) {
    Serial.print(F("   стек: SP=0x"));  Serial.print(gFaultSp, HEX);
    Serial.print(F(" MSP=0x"));         Serial.print(gFaultMsp, HEX);
    Serial.print(F(" PSP=0x"));         Serial.print(gFaultPsp, HEX);
    Serial.print(F(" xPSR=0x"));        Serial.println(gFaultXpsr, HEX);
    Serial.print(F("   стек: верх 0x")); Serial.print(gStackTop, HEX);
    Serial.print(F(", ушло "));          Serial.print(stackUseBytes()); Serial.println(F(" байт"));
    if (gFaultXpsr && !(gFaultXpsr & (1u << 24)))
      Serial.println(F("   !! в кадре нет бита Thumb — кадр исключения испорчен: похоже на переполнение стека"));
  }
  Serial.print(F("   SPI: sr=0x"));    Serial.print(spi_get_hw(spi0)->sr, HEX);
  Serial.print(F("  сбоев "));         Serial.print(spiStuck);
  Serial.print(F(", неудачных строк ")); Serial.print(txRowsFail);
  Serial.print(F(", байт всего "));    Serial.println(txBytes);
}

// Смерть: печатаем всё, что знаем, кладём в чёрный ящик и гасим консоль САМИ
// (иначе через 4 с придёт сторож, питание уйдёт — и мы ничего не увидим).
static void dieReport(uint32_t phase, uint32_t a, uint32_t b, uint32_t c, uint32_t d) {
  gDieA = a; gDieB = b; gDieC = c; gDieD = d;
  gInDieReport = true;
  mark(phase);
  Serial.println();
  Serial.println(F("================================================================"));
  Serial.print(F("!!! "));
  if (phase == PH_FAULT) Serial.println(F("АППАРАТНЫЙ СБОЙ (HardFault): печатаю, где и почему."));
  else                   Serial.println(F("ЦИКЛ ЗАЛИП (а прерывание звука шло) — это не сбой, а вечное ожидание."));
  printWhere();
  if (phase == PH_FAULT) {
    Serial.print(F("   причина: ")); Serial.println(faultWhy(a, d));
    Serial.print(F("   CFSR=0x")); Serial.print(a, HEX);
    Serial.print(F(" HFSR=0x"));   Serial.print(d, HEX);
    Serial.print(F(" MMFAR=0x"));  Serial.print(c, HEX);
    Serial.print(F(" BFAR=0x"));   Serial.print(c, HEX); Serial.println();
    Serial.print(F("   адрес сбоя 0x")); Serial.print(b, HEX);
    Serial.print(F(" (LR=0x")); Serial.print(gFaultLr, HEX); Serial.println(F(")"));
    Serial.println(F("   сравните адрес с картой функций из начала лога"));
  }
  blkWrite();                                  // отметка в чёрный ящик (он всё переживёт)
  blkFlush(true);                              // и всё кольцо ОЗУ — во flash (последний шанс)
  Serial.flush(); delay(150);
  Serial.println(F("=== пикну и погашу консоль сама — так вы увидите этот лог ==="));
  pwm_set_gpio_level(PIN_AUDIO, 620);
  mark(PH_POWERCUT);
  watchdog_hw->scratch[5] = WD_POWER;
  Serial.flush(); delay(150);
  digitalWrite(PIN_PWR_HOLD, LOW);
  for (int i = 0; i < 8; i++) { delay(100); wdtFeed(); }
  digitalWrite(PIN_PWR_HOLD, HIGH);            // питание не снялось — остаёмся живы
  mark(phase);
  gInDieReport = false;
  pwm_set_gpio_level(PIN_AUDIO, APU_PWM_IDLE);
  Serial.println(F("=== питание не снялось (GPIO1 не ключ?) — остаюсь в этом состоянии ==="));
  Serial.flush();
}

// ДОКЛАД ИЗ ОБЫЧНОГО ПОТОКА (v8.9d). Здесь и только здесь можно печатать:
// мы уже вернулись из обработчика, прерывания работают, USB выгружает буфер.
// Сюда попадаем и при сбое ядра, и при залипании цикла (см. faultTriggerNow()).
#ifndef GBEMU_HOST
static void __attribute__((noreturn)) faultAftermath(void) {
  stackWitness();
  dieReport(gPhase == PH_STALL ? PH_STALL : PH_FAULT,
            gDieA, gDieB, gDieC, gDieD);          // печать + запись в ящик
  Serial.println(F("=== (этот текст напечатан ИЗ ОБЫЧНОГО ПОТОКА: до вас он доходит) ==="));
  Serial.flush(); delay(200);
  // Пищим, снимаем питание — чтобы лог дошёл и консоль погасла сама.
  pwm_set_gpio_level(PIN_AUDIO, 620);
  mark(PH_POWERCUT);
  watchdog_hw->scratch[5] = WD_POWER;
  Serial.flush(); delay(150);
  digitalWrite(PIN_PWR_HOLD, LOW);
  for (int i = 0; i < 12; i++) { delay(100); wdtFeed(); }
  digitalWrite(PIN_PWR_HOLD, HIGH);               // не снялось — остаёмся живы и кормим сторожа
  pwm_set_gpio_level(PIN_AUDIO, APU_PWM_IDLE);
  Serial.println(F("=== питание не снялось (GPIO1 не ключ?) — остаюсь в этом состоянии, сторож кормлю ==="));
  Serial.flush();
  watchdog_enable(WD_MS, false);
  for (;;) { wdtFeed(); Serial.flush(); tight_loop_contents(); }
}
#endif

// ДЫРА, из-за которой отчётов не было видно: у HardFault приоритет -1, ВЫШЕ всех
// обычных прерываний. Сидя в обработчике, мы блокируем USB — то есть всё, что в нём
// напечатано, физически не может уехать в терминал и пропадает при сбросе сторожем.
// Поэтому обработчик ничего не печатает: он сохраняет состояние, пишет запись в
// чёрный ящик, выключает сторожа и ПОДМЕНЯЕТ адрес возврата в кадре исключения на
// faultAftermath(). Возврат `bx lr` уводит нас в обычный поток, где всё работает.
extern "C" uint32_t __attribute__((used)) gbHardFaultC(uint32_t *frame, uint32_t excReturn) {
  stackWitness();
  gFaultPc = frame[6]; gFaultLr = frame[5];
  gFaultXpsr = frame[7];
  gFaultSp = (uint32_t)(uintptr_t)frame;          // SP на входе = адрес кадра
#ifndef GBEMU_HOST
  gFaultMsp = readMsp(); gFaultPsp = readPsp();
  // Залипание приходит сюда «по умыслу» (см. faultTriggerNow) — и тогда подробности
  // сбоя НЕ затирают подробности залипания, ведь сбоя как такового нет.
  if (gPhase != PH_STALL) {
    gDieA = SYS_CFSR; gDieB = gFaultPc;
    gDieC = (SYS_CFSR & (1u << 10)) ? SYS_BFAR : SYS_MMFAR;
    gDieD = SYS_HFSR;
  }
  // Снять бит ENABLE (бит 30) сторожа АТОМАРНЫМ CLR-алиасом (+0x3000). Так не нужно
  // ни hw_clear_bits(), ни риск задеть поле TIME обычной «читай-пиши».
  *(volatile uint32_t *)((uintptr_t)&watchdog_hw->ctrl + 0x3000u) = 0x40000000u;  // сторож выкл
  (void)excReturn;                                // возвращаем свою константу: уходим в поток
  blkWrite();                                     // запись в ящик — ДО печати
  frame[6] = ((uint32_t)(uintptr_t)&faultAftermath) | 1u;    // вернёмся сюда (бит Thumb)
  // Возвращаемся В ПОТОК с MSP: 0xFFFFFFF9. Так доклад печатается при включённых
  // прерываниях, даже если сбой случился внутри прерывания звука.
  return 0xFFFFFFF9u;
#else
  (void)excReturn;
  gDieA = SYS_CFSR; gDieB = gFaultPc;
  gDieC = (SYS_CFSR & (1u << 10)) ? SYS_BFAR : SYS_MMFAR;
  gDieD = SYS_HFSR;
  dieReport(PH_FAULT, gDieA, gDieB, gDieC, gDieD);
  return excReturn;
#endif
}
// Вход в обработчик. Кадр исключения (R0..R3, R12, LR, PC, xPSR) процессор кладёт в
// стек, и SP в этот момент — указатель на него; прочитать его из C нельзя. Поэтому
// здесь две инструкции ассемблера, и ТОЛЬКО такие, какие умеет Thumb-1 (Cortex-M0+):
//   mov r0, sp   — указатель на кадр в первый аргумент
//   bl  gbHardFaultC — вызов (bl в Thumb всегда есть; он же несёт бит Thumb сам)
// Чего здесь НЕЛЬЗЯ (на этом и упала сборка): orr r1, r1, #1 — «ORR с числом» в
// Thumb-1 не существует (ошибка ассемблера «unshifted register required»), а широкое
// ветвление b.w на M0+ тоже недоступно (дальность b.n всего ±2 КБ).
// Если ваш компилятор и к этому отнесётся плохо — поставьте FAULT_TRAP_ASM 0: тогда
// вектор указывает прямо на C-функцию (в логе не будет PC сбоя, причина и регистры
// CFSR/HFSR/BFAR останутся), и ассемблера в сборке не будет вовсе.
#define FAULT_TRAP_ASM 1
#ifndef GBEMU_HOST
#if FAULT_TRAP_ASM
extern "C" void __attribute__((naked)) gbHardFaultEntry(void) {
  // r0 = кадр исключения (SP), r1 = EXC_RETURN (куда возвращаться),
  // gbHardFaultC возвращает EXC_RETURN (подменённый на «в поток»), bx r0 уносит нас
  // туда. Только Thumb-1-инструкции: mov/bl/bx — всё это на M0+ есть всегда.
  __asm volatile ("mov r0, sp\n\tmov r1, lr\n\tbl gbHardFaultC\n\tbx r0\n");
}
#define FAULT_VECTOR_TARGET ((uint32_t)(uintptr_t)&gbHardFaultEntry)
#else
extern "C" void __attribute__((used)) gbHardFaultNoFrame(void) {
  gFaultPc = 0; gFaultLr = 0;                   // кадр стека недоступен без ассемблера
  dieReport(PH_FAULT, SYS_CFSR, 0,
            (SYS_CFSR & (1u << 10)) ? SYS_BFAR : SYS_MMFAR, SYS_HFSR);
  for (;;) { wdtFeed(); tight_loop_contents(); }
}
#define FAULT_VECTOR_TARGET ((uint32_t)(uintptr_t)&gbHardFaultNoFrame)
#endif
#else
extern "C" void gbHardFaultEntry(void) { }      // на компьютере вход не нужен
#define FAULT_VECTOR_TARGET ((uint32_t)(uintptr_t)&gbHardFaultEntry)
#endif
static uint32_t gVecSave[64] __attribute__((aligned(512)));

// Ставим ловушку: копируем таблицу векторов в ОЗУ и подменяем в ней HardFault.
// Без этого сбой на M0+ — молчаливое зависание (вектор ведёт на инструкцию BKPT).
static void faultTrapInstall(void) {
  const uint32_t *src = SYS_VTOR_GET();
  for (int i = 0; i < 64; i++) gVecSave[i] = src[i];
  gVecSave[3] = FAULT_VECTOR_TARGET | 1u;                        // HardFault (бит Thumb обязателен)
  gVecSave[2] = gVecSave[3];                                     // NMI — тем же путём
  SYS_VTOR_SET(gVecSave);
}

void loop(void);                                // объявлен заранее: печатаем её адрес в карте
static void GB_RAM cb_lcd_line(struct gb_s *g, const uint8_t *pixels, const uint_fast8_t line) {
  frameLineCore = line;                        // свидетель: до этой строки ядро дошло
  if (!frameOpen) return;                      // кадр не открыт (пропущен или был занят) — панель не трогаем
  mark(PH_DRAW);
  cbCalls++;
  if (diagFrames) { diagCount(g, pixels); drawDiagLine(g, pixels, (int)line); }

  // 160 точек игры -> 240 точек панели (как в v8: две точки дважды и одна один раз).
  // ВАЖНО (нашли санитайзером): раньше это делалось «32-битной записью по ходу», но
  // 6 байт на итерацию (два пикселя + один) НЕ кратны 4 — и каждая вторая запись
  // попадала на адрес, не кратный 4. На Cortex-M0+ невыровненная 32-битная запись —
  // АППАРАТНЫЙ СБОЙ, к тому же это неопределённое поведение в C.
  // Теперь шаг 4 пикселя игры = 6 пикселей панели = ровно 3 слова по 4 байта:
  //   [p0 p0] [p1 p2] [p2 p3]  — все три записи строго выровнены.
  uint32_t *w = tx_rowbuf;
  for (int sx = 0; sx < 160; sx += 4) {
    const uint16_t c0 = colTab[pixels[sx]],     c1 = colTab[pixels[sx + 1]];
    const uint16_t c2 = colTab[pixels[sx + 2]], c3 = colTab[pixels[sx + 3]];
    *w++ = (uint32_t)c0 | ((uint32_t)c0 << 16);
    *w++ = (uint32_t)c1 | ((uint32_t)c2 << 16);
    *w++ = (uint32_t)c2 | ((uint32_t)c3 << 16);
  }

  // одна строка игры = 1..3 строки панели (1,5x: 216 строк на 144) — шлём каждую
  const int y0 = (line * VB_STEP) >> 8;
  const int y1 = (((line + 1) * VB_STEP) >> 8) - 1;
  const uint32_t c0 = micros();
  for (int y = y0; y <= y1; y++) {
    if (frameY >= MEM_H) break;
    if (!txRowY((const uint8_t *)tx_rowbuf)) return;       // сбой SPI уже посчитан и назван в логе
  }
  const uint32_t c1 = micros();
  cbAccUs += c1 - c0;
  rowLoopAcc += c1 - c0;
  rowLoopN++;
}

// --- строки интерфейса (меню, тесты, заставка) ---
// Тот же путь: собрали строку в буфер — сразу отправили. Никаких «влезло/не влезло».
static uint8_t uiRowBuf[ROW_BYTES] __attribute__((aligned(4)));   // выравнивание: см. tx_rowbuf
static uint8_t *uiRow(void) { return frameOpen ? uiRowBuf : nullptr; }
static void uiRowSend(void) {
  if (!frameOpen) return;
  txRowY(uiRowBuf);                                        // v9.5: с диффом — неизменившаяся строка молчит
}

// ============================================================ сохранения (flash)
extern char __flash_binary_end;              // конец образа (ставит линкер)
static uintptr_t flashBase = 0x10000000UL;   // начало flash (в тесте на хосте подменяется)
static uintptr_t flashEnd = 0;               // абсолютный адрес конца образа
#define FLASH_TOTAL   0x200000UL
#define FLASH_RESERVE 0x1000UL               // последний сектор — служебный (EEPROM ядра)
// Два последних сектора (8 КиБ) занимает «чёрный ящик» (см. ниже): 32 записи по
// 256 байт, поэтому область сейвов и сейвстейтов заканчивается перед ними.
#define BLK_SECTOR    0x1000UL
#define BLK_SECTORS   2
#define FLASH_LIMIT   (FLASH_TOTAL - FLASH_RESERVE - BLK_SECTOR * BLK_SECTORS)
#define SAVE_MAGIC 0x314C4153UL             // "SAL1"
#define SAVE_HDR   256                      // заголовок занимает первую страницу
// v8.9o: в первую страницу добавлены клеймо игры и «поколение» ячейки:
//   0: magic, 4: длина, 8: свёртка данных, 12: ~свёртка,
//   16: CRC32 образа (ключ игры), 20: ~ключ, 24: поколение (для выбора старой ячейки)
#define SAVE_HDR_KEY 16
#define SAVE_HDR_SEQ 24
#define SAVE_BANKS   4                      // ячеек под сейвы SRAM (по одной на игру)

static uint32_t saveOff = 0;                 // смещение ТЕКУЩЕЙ ячейки от начала flash
static int      saveLen = 0;                 // размер одной ячейки (кратно 4096)
static int      saveData = 0;                // объём сохраняемых данных (<= sizeof(cartRam))
static uint32_t saveHash = 0;
static int      bankCount = 0;               // сколько ячеек выделено (1..SAVE_BANKS)
static uint32_t bankOff[SAVE_BANKS] = {0};   // их смещения
static int      saveBank = -1;               // какая ячейка у текущей игры
static uint32_t saveGameCrc = 0;             // ключ игры, которой принадлежит ячейка
static uint32_t saveSeqMax = 0;              // «поколение» записей: по нему выбираем старую ячейку
static bool     saveActive = false;          // у ЭТОЙ игры есть память сохранений (иначе писать нечего)
static uint32_t lastSaveMs = 0;
// ИЗНОС FLASH (v8.9l): считаем стирания секторов — у flash ресурс ~100 000 на сектор.
// Пишем мало и по делу: сейвы — только изменившиеся сектора, ящик — только переиспользуемые.
static uint32_t saveErases = 0;              // стираний секторов под сейвы SRAM
static uint32_t ssErases   = 0;              // стираний секторов под сейвстейты

// ============================================================ ПРИБОР: питание (АЦП)
// В стоковой прошивке АЦП используется: сначала инициализация блока (сброс, затем в
// регистр управления пишется 1 = «включить», то есть канал 0 = GPIO26), а потом
// чтение: пишется 4 (START_ONCE = «начать одно преобразование»), ожидание бита
// «готово» и чтение результата. То есть датчик питания у стока — канал 0 (GP26).
//   ВАЖНО: в RP2040 каналы АЦП 0..3 — это GP26..GP29, а канал 4 — ВНУТРЕННИЙ
//   термодатчик (не вывод платы!).
// Читаем три источника сразу — так по одному логу видно, где что:
//   • канал 0 (GP26) — как в стоке: это и считаем датчиком питания;
//   • канал 3 (GP29) — «как на Pico» (там сюда заведён VSYS через делитель 1:3);
//   • канал 4 — термодатчик: он всегда есть, поэтому служит самопроверкой АЦП
//     (должно быть около 700-800 мВ и расти, если плата греется).
#define PIN_BATT_A    26                // GP26 — канал 0 (в стоке читался он; у нас ВИСИТ)
#define PIN_BATT_B    29                // GP29 — канал 3: ПО ЗАМЕРАМ ЭТО И ЕСТЬ БАТАРЕЯ
#define ADC_CH_A      0
#define ADC_CH_B      3

// ЛОВУШКА ПРОСАДКИ. Батарея (A3) читается прямо в прерывании звука — 2 777 раз в
// секунду (каждый 8-й тик таймера 45 мкс). Это нужно потому, что просадка питания
// длится миллисекунды, и увидеть её опросом раз в запись чёрного ящика невозможно.
// Значения (в отсчётах АЦП, 4095 = 3,3 В на выводе, то есть 6,6 В батареи при 1:2):
//   gDipMin   — минимум за текущее окно (окно закрывается записью в чёрный ящик)
//   gDipMax   — максимум за окно
//   gDipWorst — самый глубокий провал за весь сеанс
static volatile uint16_t gDipMin = 4095, gDipMax = 0, gDipWorst = 4095;
static volatile uint8_t  gAdcTick = 0;
static volatile bool     gDipWarn = false;         // просадку надо напечатать из цикла
static volatile bool     gAdcSweep = false;        // идёт перебор каналов (не мешать!)
static volatile uint8_t  gDipSkip  = 0;           // пропустить один отсчёт (после перебора каналов)
static volatile uint8_t  gDipLowRun = 0;          // v8.9r: сколько замеров ПОДРЯД ниже порога
static volatile uint32_t gDipRunStartMs = 0;      // v8.9t: с какого момента идёт низкий участок
static volatile uint16_t gDipRunMin = 4095;       // v8.9t: его минимум
static uint32_t          gDipEvents = 0;           // сколько раз ловили просадку
static uint32_t          gGuardDefers = 0;         // сколько автозаписей во flash отложено
static uint32_t          gDipLastMs = 0;
#define DIP_WARN_RAW   2150                        // ~3,46 В на батарее (норма 3,77 В)
// v8.9t: что вообще можно считать «просадкой».
//   DIP_PLAUSIBLE_RAW — 2,0 В. При таком питании 3,3-В регулятор и сам чип давно бы
//     выключились, значит отсчёт — грязь от переключения канала АЦП. Раньше такая
//     «просадка до 1,12 В» попадала в отчёт и в статистику.
//   DIP_RUN_MS — низкий участок короче 10 мс просадкой не считается: настоящая
//     просадка под нагрузкой держится десятки миллисекунд, а выброс от переключения
//     канала — 1–2 отсчёта (доли миллисекунды).
#define DIP_PLAUSIBLE_RAW 1240                     // ~2,0 В: ниже — не батарея, а помеха
#define DIP_RUN_MS        10                       // мс: столько должен длиться низкий участок
#define DIP_COOLDOWN_MS 2000
// v8.9p: ниже этого значения АВТОМАТИЧЕСКИЕ записи во flash откладываются. Смысл:
// запись во flash — это всплеск тока и остановка выборки кода; делать её на
// просевшем питании нельзя (именно так консоль умирала в v8.9j: запись в ящик и
// сброс по RUN). Явные команды пользователя (w, сейвстейты, выключение) пишут всегда.
#define BATT_GUARD_RAW 2200                        // ~3,55 В на батарее
#define SAG_WINDOW_MS  2500                        // сколько меряем просадку после запуска игры

// МЕРКА ПРОСАДКИ: минимум и максимум батареи за окно после запуска игры. Печатается
// один раз — по ней видно, насколько питание «клюёт» под нагрузкой (и виновато ли оно).
static volatile uint16_t gSagMin = 4095, gSagMax = 0;
static uint32_t          gSagT0 = 0;
static bool              gSagDone = true;
// ============================================================ подсветка (яркость экрана)
// v9.2: потолков яркости БОЛЬШЕ НЕТ (ни по заряду, ни при просадке — батареей
// яркость не трогаем вообще). На экран всегда идёт lightUser (крутилка LIGHT).
// Переменные lightCap/lightShed оставлены равными 255, чтобы не трогать lightApply.
static uint8_t backlight  = 255;               // применённое значение (0..255)
static uint8_t lightUser  = 255;               // крутилка пользователя
static uint8_t lightCap   = 255;               // v9.2: всегда 255 (потолок удалён)
static uint8_t lightShed  = 255;               // v9.2: всегда 255 (автосброс удалён)
static void lightApply(void) {
  uint8_t m = lightUser;
  if (lightCap < m) m = lightCap;
  if (lightShed < m) m = lightShed;
  backlight = m;
  analogWrite(PIN_BL, backlight);
}
static void setBacklight(int v) {              // крутилка пользователя
  if (v < 0) v = 0;
  if (v > 255) v = 255;
  lightUser = (uint8_t)v;
  lightApply();
}
static void lightRaw(int v) {                  // мимо всех потолков (проба звука)
  if (v < 0) v = 0;
  if (v > 255) v = 255;
  backlight = (uint8_t)v;
  analogWrite(PIN_BL, backlight);
}

// v9.2: АВТОСБРОС НАГРУЗКИ УДАЛЁН (ниже — пустые заглушки shedLoad/shedTick,
// оставленные ради прерывания ловушки; дальше — история для памяти).
static bool              gShedAuto = true;
static uint32_t          gShedLastMs = 0;
// ОПЫТ v8.9p, УБРАННЫЙ В v8.9q. Я отложил выгрузку чёрного ящика на «пару секунд после
// просадки, когда питание выправится». Итог: сброс по RUN пришёлся РОВНО на эту выгрузку —
// в логе все пять смертей оборвались на строке «ящик: выгружаю во flash отметок …».
// Значит, запись во flash в игре опасна не «в момент просадки», а вообще: стирание
// сектора — это ~50 мс, за которые батарея уходит ниже порога внешней схемы. Поэтому
// в игре во flash НЕ ПИШЕМ ВООБЩЕ, а след уходит при выключении (экран там уже погашен).
// Что осталось полезного — АВТОСБРОС НАГРУЗКИ, но теперь он работает ЗАРАНЕЕ, по
// мягкому порогу. v8.9s: ступень ровно одна (125 -> 62,5 МГц) с проверкой пользы —
// до 41,7 МГц прошивка сама не опускается никогда.
static volatile bool     gShedAsk = false;         // прерывание просит сбросить нагрузку
static uint8_t           gShedSteps = 0;           // на сколько ступеней нагрузка опущена
static uint32_t          gShedUps = 0;             // сколько раз яркость возвращали наверх
static bool              gShedUseless = false;     // v8.9s: проверено — тут снижение яркости не помогает
static uint32_t          gShedCheckMs = 0;         // v8.9s: когда проверить пользу ступени
static uint32_t          gDipAtShed = 0;           // v8.9s: сколько просадок было при снижении
#define SHED_WARN_RAW   2200                       // ~3,55 В: отсюда уже роняем нагрузку
#define SHED_COOLDOWN_MS 10000                     // не чаще раза в 10 с
// v8.9s: опустив яркость, НАДО проверить, помогло ли это питанию. Через 45 с смотрим,
// сколько просадок случилось ПОСЛЕ снижения: если их всё равно много, причина не в
// яркости — возвращаем её и больше подсветку не трогаем (v8.9y: раньше речь шла о панели).
#define SHED_CHECK_MS   45000UL
#define SHED_CHECK_DIPS 3
#define WEAK_BATT_RAW   2170                       // v8.9x: ~3,50 В (было 2260 = 3,64 — срабатывало на норме 3,61 В)
// v8.9r: ВОЗВРАТ НАГРУЗКИ НАВЕРХ. Без него автосброс — дорога в одну сторону: яркость
// упала и там осталась навсегда. Теперь: если 2 минуты тихо (ни просадок, ни шагов)
// и холостая батарея не ниже 3,50 В — возвращаем яркость. После просадки возврат
// запрещён на 2 минуты (иначе дёргалось бы). v8.9y: раньше речь шла о частоте панели.
#define SHED_QUIET_MS    120000UL                  // сколько тишины нужно для возврата
#define SHED_RESTORE_RAW WEAK_BATT_RAW                      // v8.9y: 3,50 В (было 3,62 — при норме 3,61 возврат не наступал)
static uint32_t          gShedHealthyMs = 0;       // с какого момента питание выглядит здоровым
static uint32_t          gShedBlockMs = 0;         // до этого времени возврат запрещён

// Опустить нагрузку. v8.9y: СКОРОСТЬ ИГРЫ НЕ ТРОГАЕМ (панель всегда на выбранной
// частоте) — временно опускаем яркость подсветки, главного потребителя, до 50 %.
// Через 45 с проверяем пользу: не помогло — возвращаем и больше не трогаем (см. shedTick).
static void shedLoad(bool afterDip) {
  // v9.2: АВТОСБРОС ЯРКОСТИ УДАЛЁН — батареей яркость не трогаем вообще
  // (ни потолков, ни временных 50 %). Функция оставлена пустой, чтобы не трогать
  // прерывание ловушки и главный цикл: они по-прежнему ставят/сбрасывают флаг.
  (void)afterDip;
  (void)gShedAuto; (void)gShedSteps; (void)gShedUps; (void)gShedUseless;
  (void)gShedLastMs; (void)gShedHealthyMs; (void)gShedBlockMs;
  (void)gShedCheckMs; (void)gDipAtShed;
}

#define ADC_CH_TEMP   4                 // внутренний термодатчик (не вывод!)
#define BATT_SAMPLES  8                 // усредняем: у АЦП шум в младших битах

// ВАЖНО (грабли Arduino IDE): IDE сама вставляет прототипы всех функций в начало
// скетча, поэтому функция НЕ МОЖЕТ возвращать тип, объявленный в этом же файле
// (иначе: «'AdcSrc' does not name a type»). Поэтому никаких собственных структур в
// подписях — только простые переменные и обычные типы.
static uint16_t battARaw, battANoise;   // GP26 — отсчёты и «дрожание» (в стоке канал 0)
static uint16_t battBRaw;               // GP29 — отсчёты (на Pico здесь VSYS/3)
static uint16_t battTRaw;               // внутренний термодатчик — самопроверка АЦП
static uint32_t battAMv, battBMv, battTMv;   // те же значения в милливольтах
static uint32_t battTrip;               // самое низкое значение на GP26 за сеанс
static bool     battOk;                 // датчик «шевелится» (не прибит к краю и не шумит)
// СТОРОЖ ПИТАНИЯ: все четыре внешних канала АЦП (GP26..GP29) и их значения НА СТАРТЕ.
// По падению относительно старта видно, садится ли питание перед смертью консоли.
static uint16_t battCh[4];              // отсчёты каналов 0..3 прямо сейчас
static uint16_t battChBoot[4] = {0,0,0,0};   // и в момент включения (для сравнения)
static bool     battChBootDone = false;

// Средний отсчёт по каналу + (необязательно) разброс. Возвращает обычный uint16_t,
// поэтому прототип от Arduino IDE собирается без вопросов.
static uint16_t battAdcAvg(uint ch, uint16_t *noiseOut) {
  uint32_t sum = 0; uint16_t mn = 4095, mx = 0;
  adc_select_input(ch);
  for (int i = 0; i < BATT_SAMPLES; i++) {
    const uint16_t v = (uint16_t)(adc_read() & 0x0FFFu);
    sum += v; if (v < mn) mn = v; if (v > mx) mx = v;
  }
  if (noiseOut) *noiseOut = (uint16_t)(mx - mn);
  return (uint16_t)(sum / BATT_SAMPLES);
}

static void battInit(void) {
  adc_init();                          // включает и сбрасывает блок АЦП (как сток)
  adc_gpio_init(PIN_BATT_A);           // GP26 — в аналоговый режим
  adc_gpio_init(PIN_BATT_B);           // GP29 — тоже (если не используется платой)
  battARaw = battBRaw = battTRaw = 0;
  battAMv = battBMv = battTMv = battTrip = 0;
  battANoise = 0; battOk = false;
}

static void battPrintBattery(void);      // объявлен заранее: печатается из прибора питания

// v8.9p: «питание в норме» — можно ли трогать flash автоматически (автосейв, ящик,
// «какая игра»). Явные команды пользователя эту проверку не проходят: они пишут всегда.
static uint32_t gGuardMsgMs = 0;
static bool battGuardOk(void) {
  if (!battChBootDone || battBRaw == 0) return true;    // ещё не мерили — не мешаем
  if (gDipWarn) return false;                           // просадка только что была
  if (battBRaw < BATT_GUARD_RAW) {
    if ((uint32_t)(millis() - gGuardMsgMs) > 30000) {    // в лог — не чаще раза в 30 с
      gGuardMsgMs = millis(); gGuardDefers++;
      Serial.print(F("запись во flash отложена: батарея "));
      Serial.print((uint32_t)battBRaw * 2u * 3300u / 4096u / 1000.0f, 2);
      Serial.print(F(" В (порог "));
      Serial.print(BATT_GUARD_RAW * 2u * 3300u / 4096u / 1000.0f, 2);
      Serial.println(F(" В) — сначала заряд; сейвы уйдут при выключении"));
    }
    return false;
  }
  return true;
}
static void battRead(void) {
  // На время перебора каналов ловушка просадки молчит: иначе прерывание звука
  // переставит АЦП на свой канал и значения чужих каналов смешаются.
  gAdcSweep = true;
  for (int i = 0; i < 4; i++) battCh[i] = battAdcAvg((uint)i, (i == 0) ? &battANoise : NULL);
  if (!battChBootDone) { for (int i = 0; i < 4; i++) battChBoot[i] = battCh[i]; battChBootDone = true; }
  battARaw  = battCh[0];
  battBRaw  = battCh[3];
  battTRaw  = battAdcAvg(ADC_CH_TEMP, NULL);
  battAMv   = (uint32_t)battARaw * 3300u / 4096u;
  battBMv   = (uint32_t)battBRaw * 3300u / 4096u;
  battTMv   = (uint32_t)battTRaw * 3300u / 4096u;
  if (!battTrip || battAMv < battTrip) battTrip = battAMv;
  // «живой» датчик: значение не прибито к краям и не скачет как сумасшедшее
  battOk = (battARaw > 20 && battARaw < 4070 && battANoise <= 120);
  // Перебор закончен. Первый отсчёт ловушки после него мог достаться чужому каналу
  // (результат в АЦП остался от термодатчика) — просим пропустить его, а не портить
  // окно мусором: минимум/максимум за прошедшее окно должны дойти до чёрного ящика.
  gDipSkip = 4; gAdcSweep = false;   // v8.9t: пропускаем 4 отсчёта (одного не хватало — после
                                     // перебора каналов АЦП «догоняет» ещё пару миллисекунд)
}

// ============================================================ ТЕМПЕРАТУРА ЧИПА (v8.9r)
// Единственная реальная опасность разгона до 250 МГц — перегрев кристалла. У RP2040
// датчик встроенный; формула из даташита: T = 27 - (V - 0,706)/0,001721 (V — с датчика).
// ВАЖНО: первое значение после переключения канала — мусор (именно из-за него мы раньше
// печатали 0,57 В, что по формуле давало «~100 °C» — это был не нагрев, а грязь первого
// отсчёта). Поэтому читаем дважды с паузой и берём второе.
// v8.9t: ЧЕСТНЫЙ НАГРЕВ ВМЕСТО ВРАНЬЯ ДАТЧИКА.
// Датчик этой платы даёт 0,566 В сразу после включения. По формуле даташита это 108 °C,
// но за секунду после подачи питания кристалл нагреться до 108 °C не может — значит у
// датчика смещение (типовая беда RP2040). Поэтому:
//   – запоминаем САМЫЙ ХОЛОДНЫЙ замер сеанса (обычно при включении) как «базу»;
//   – нагре = (база - текущий)/1,721 мВ на градус: это и есть реальный рост температуры;
//   – абсолютную цифру показываем только для справки и всегда с оговоркой.
static uint16_t tempBaseMv = 0;           // база = самый холодный замер этого сеанса

static int tempReadMv(int *riseC) {
  gAdcSweep = true;                       // ловушка просадки молчит, пока мы лезем в АЦП
  (void)battAdcAvg(ADC_CH_TEMP, NULL);    // «разогревочное» значение — выбрасываем
  delayMicroseconds(1500);                // датчику нужно устояться
  const uint32_t mv = (uint32_t)battAdcAvg(ADC_CH_TEMP, NULL) * 3300u / 4096u;
  gAdcSweep = false;
  if (!mv) return 0;                      // не читается
  if (!tempBaseMv || mv < tempBaseMv) tempBaseMv = (uint16_t)mv;   // холоднее не станет
  if (riseC) {
    int r = (int)((((int)tempBaseMv - (int)mv) / 1.721f) + 0.5f);  // мВ -> °C
    if (r < 0) r = 0;                    // «холоднее базы» не бывает: это шум датчика
    *riseC = r;
  }
  return (int)mv;
}

static int tempDegC(void) {               // справочная «абсолютная» оценка (датчику не верить)
  const int mv = tempReadMv(NULL);
  if (!mv) return 999;
  const int t = (int)(27.0f - ((float)mv - 706.0f) / 1.721f + 0.5f);
  if (t < -30 || t > 150) return 999;
  return t;
}

// Предупреждение о перегреве: считаем по НАГРЕВУ относительно базы, а не по врущему
// абсолютному значению. Порог +55 °C: если чип греется на столько выше комнатной
// температуры — это уже повод сбавить нагрузку (или поставить переключатель ядра).
#define TEMP_RISE_WARN 55

// Переменная «сколько замеров подряд ниже порога» и сама функция возврата частоты
// объявлены НИЖЕ по файлу (после чтения батареи): тут ещё нет battBRaw.
// v8.9r: возврат яркости НАВЕРХ, когда питание опять в порядке. Вызывается каждый цикл
// (это дешёво: только сравнения), поэтому в игре возврат случается сразу, как стало тихо.
static void shedTick(void) {
  // v9.2: пусто (см. shedLoad выше) — вызывать можно, ничего не делает.
}

static void battPrint(void) {
  Serial.print(F("сторож питания — все каналы АЦП (GP26..GP29): "));
  for (int i = 0; i < 4; i++) {
    Serial.print(F("A")); Serial.print(i); Serial.print(F("=")); Serial.print(battCh[i]);
    Serial.print(F(" (")); Serial.print((uint32_t)battCh[i] * 3300u / 4096u); Serial.print(F(" мВ)"));
    if (i < 3) Serial.print(F("  "));
  }
  Serial.println();
  {
    int rise = 0;
    const int mv = tempReadMv(&rise);
    Serial.print(F("   термодатчик (внутренний) = ")); Serial.print(mv ? mv : battTMv); Serial.print(F(" мВ"));
    if (!mv) Serial.print(F("  (не читается)"));
    else {
      const int tc = tempDegC();
      Serial.print(F("  нагрев +")); Serial.print(rise); Serial.print(F(" °C к базовому ("));
      Serial.print(tempBaseMv); Serial.print(F(" мВ)"));
      if (tc < 999 && tc >= 90) Serial.print(F("  — абсолютная цифра врёт, см. подсказку ниже"));
    }
  }
  Serial.print(F("   дрожание A0 = ")); Serial.print(battANoise); Serial.println();
  Serial.println(F("   подсказка: A3 (GP29) — батарея через делитель 1:2 (замерено: 3,76 В при полной); A0 (GP26) висит."));
  Serial.println(F("   температура: датчик этой платы врёт (у него смещение ~140 мВ: сразу после"));
  Serial.println(F("   включения он показывает 0,57 В, что по формуле = 108 °C). Следим за РОСТОМ:"));
  Serial.println(F("   база — самый холодный замер сеанса, предупреждение придёт при +55 °C к ней."));
  battPrintBattery();
  if (battANoise > 200)
    Serial.println(F("   (A0 (GP26) сильно дрожит — он ни к чему не подключён; батарею читаем с A3)"));
  if (battBRaw < 100)
    Serial.println(F("   (канал A3 молчит — если у вас батарея читается иначе, ориентируемся на динамику каналов)"));
  else if (battBMv * 2 < 3300)
    Serial.println(F("!! БАТАРЕЯ НИЗКО (меньше 3,3 В). Если консоль выключается сама — зарядите и повторите."));
}

// Батарея: по замерам это канал 3 (GP29) через делитель 1:2 (2332 отсч. = 1878 мВ ->
// 3,76 В — ровно заряженный литий). Печатаем в вольтах и предупреждаем, только если
// напряжение реально упало.
// Один замер батареи (A3) для ловушки просадки — вызывается из прерывания звука.
// Работает БЕЗ ОЖИДАНИЯ: просим одно преобразование и читаем ПРЕДЫДУЩИЙ результат
// (так же читает сток). Ждать готовности в прерывании нельзя: не ответит АЦП — консоль
// залипнет, и снаружи это будет неотличимо от нынешней смерти через 3 секунды.
// Отсчёт отстаёт на одно преобразование (0,36 мс при обычном темпе звука) — неважно.
static void dipSample(void) {
  // Читаем-изменяем-пишем: не затираем чужие биты (EN, включение термодатчика),
  // а только переключаем канал и просим одно преобразование.
  uint32_t cs = adc_hw->cs;
  cs &= ~(7u << ADC_CS_AINSEL_LSB);
  cs |= ((uint32_t)ADC_CH_B << ADC_CS_AINSEL_LSB) | ADC_CS_EN_BITS | ADC_CS_START_ONCE_BITS;
  adc_hw->cs = cs;
  if (gDipSkip) { gDipSkip--; return; }      // после перебора каналов: в АЦП ещё чужой канал
  const uint16_t v = (uint16_t)(adc_hw->result & 0x0FFFu);
  // v8.9t: заведомая помеха — не данные. Ниже 2,0 В на батарее этот чип работать не может,
  // значит отсчёт пришёл от переключения канала (раньше из-за него в отчёте о смерти
  // появлялись «провалы до 1,1 В» и «просадка 2583 мВ» при живой батарее).
  if (v < DIP_PLAUSIBLE_RAW) return;
  if (v < gDipMin)   gDipMin = v;            // окно закрывается записью в чёрный ящик
  if (v > gDipMax)   gDipMax = v;
  if (v < gDipWorst) gDipWorst = v;          // самый глубокий провал за сеанс
  if (!gSagDone) {                           // v8.9p: окно «как питание живёт после запуска игры»
    if (v < gSagMin) gSagMin = v;
    if (v > gSagMax) gSagMax = v;
  }
  // Ниже порога — просим главный цикл напечатать: печатать из прерывания нельзя
  // (пока мы в прерывании, USB не выгружается).
  // v8.9t: решение принимаем по ДЛИТЕЛЬНОСТИ низкого участка (>= 10 мс), а не по числу
  // «низких» отсчётов. Одиночный выброс АЦП (шум, переключение канала) — ещё не просадка;
  // из-за таких выбросов панель опускалась без нужды, и вы видели «производительность
  // упала» и «просадку до 1,12 В» на живой батарее. Настоящая просадка под нагрузкой
  // держится десятки мс — её мы так не пропустим.
  if (v < SHED_WARN_RAW) {
    if (!gDipRunStartMs) gDipRunStartMs = millis() ? millis() : 1u;
    if (v < gDipRunMin) gDipRunMin = v;
    gDipLowRun = (uint8_t)((gDipLowRun < 250) ? gDipLowRun + 1 : 250);
  } else {
    gDipRunStartMs = 0; gDipRunMin = 4095;
    gDipLowRun = 0;
  }
  const bool sure = (gDipRunStartMs != 0)
                 && ((uint32_t)(millis() - gDipRunStartMs) >= DIP_RUN_MS);
  if (sure && gDipRunMin < DIP_WARN_RAW && !gDipWarn && (uint32_t)(millis() - gDipLastMs) > DIP_COOLDOWN_MS) {
    gDipWarn = true; gDipLastMs = millis();
  }
  // ЗАРАНЕЕ просим сбросить нагрузку — по мягкому порогу. Ждать обрыва поздно: внешняя
  // схема сбрасывает чип раньше, чем мы успеем что-то сделать.
  // Печатать отсюда нельзя (мы в прерывании), поэтому только флаг — печатает цикл.
  if (sure && gShedAuto && !gShedAsk
      && (uint32_t)(millis() - gShedLastMs) > SHED_COOLDOWN_MS) gShedAsk = true;
}

static void battPrintBattery(void) {
  const uint32_t mv = battBMv * 2;                 // делитель 1:2
  Serial.print(F("батарея: A3=")); Serial.print(battBRaw);
  Serial.print(F(" -> "));         Serial.print(battBMv); Serial.print(F(" мВ -> "));
  Serial.print(mv / 1000.0f, 2);   Serial.print(F(" В (делитель 1:2)"));
  if (mv >= 4000) Serial.print(F("  — полная"));
  else if (mv >= 3600) Serial.print(F("  — норма"));
  else if (mv >= 3300) Serial.print(F("  — разряжается"));
  else                 Serial.print(F("  — НИЗКО, пора заряжать"));
  Serial.println();
}

// v8.9u: ИНДИКАТОР БАТАРЕИ НА ЭКРАНЕ. Раньше напряжение было видно только
// в serial. Читаем ТОЛЬКО канал 3 (GP29/A3) — тот же, что ловушка просадки
// в прерывании звука, поэтому гонки с прерыванием нет в принципе: оба читают
// один канал, «чужой» отсчёт нам не страшен, канал не переключаем и gDipSkip
// не трогаем.
// v8.9w: шкала иконки, мВ. Полная по замерам ЭТОЙ платы — 3,61..3,76 В, поэтому
// 100 % = 3620 (было 3800 — свежая батарея казалась полупустой). Больше —
// clamp в 100 %, так что и 3,76, и 4,1 с зарядки покажут полную корректно.
#define BATT_UI_FULL_MV  3620
#define BATT_UI_EMPTY_MV 3300   // пусто и LOW (как в serial: «меньше 3,3 В»)
static uint16_t battUiRaw(void) {
  if (!battChBootDone) return 0;   // АЦП ещё не настроен (самый ранний setup) — молчим
  return battAdcAvg(ADC_CH_B, NULL);
}
// милливольты батареи (делитель 1:2) из отсчётов; 0 — нет данных
static uint32_t battUiMv(uint16_t raw) {
  if (raw < 100) return 0;
  return (uint32_t)raw * 2u * 3300u / 4096u;
}
// v8.9x: СГЛАЖИВАНИЕ. Шина батареи гуляет ±100 мВ (в логе: A3 2188..2312),
 // а мгновенный замер раз в секунду ловил случайную фазу — иконка скакала
 // снизу доверху. EMA с tau ~8 с; нет данных — возвращаем что было.

static uint32_t battUiEma = 0;          // сглаженные милливольты (0 = замеров ещё не было)
static uint32_t battUiMvSmooth(void) {
  const uint32_t mv = battUiMv(battUiRaw());
  if (!mv) return battUiEma;
  if (!battUiEma) battUiEma = mv;       // первый замер — сразу
  else battUiEma = (uint32_t)((int32_t)battUiEma + ((int32_t)mv - (int32_t)battUiEma) / 8);

  return battUiEma;
}
// уровень 0..4 по СГЛАЖЕННЫМ милливольтам, с гистерезисом 25 мВ.
// Сегменты по 80 мВ: 0: <=3300, 1: 3301..3380, 2: 3381..3460, 3: 3461..3540, 4: >=3541.
static int8_t battLvlShown = -1;        // показанный уровень (-1 = ещё не показывали)
static int battUiLevel(uint32_t mv) {
  int raw;
  if (mv <= BATT_UI_EMPTY_MV) raw = 0;
  else { raw = (int)((mv - BATT_UI_EMPTY_MV + 79) / 80); if (raw > 4) raw = 4; }
  if (battLvlShown < 0 || battLvlShown > 4) { battLvlShown = (int8_t)raw; return raw; }
  if (raw == battLvlShown) return raw;
  // граница между нижним из двух уровней и следующим: EMPTY + lo*80 + 1
  const int lo = (raw < battLvlShown) ? raw : battLvlShown;
  const uint32_t edge = BATT_UI_EMPTY_MV + (uint32_t)lo * 80 + 1;
  if (raw > battLvlShown) { if (mv >= edge + 25) battLvlShown = (int8_t)raw; }
  else if (mv < edge - 25) battLvlShown = (int8_t)raw;
  return battLvlShown;
}
// v9.2: потолок яркости по заряду УДАЛЁН (см. выше) — функция стёрта целиком.
// "3.68V" или "--" — только целочисленная математика (float в snprintf не тянем)
static void battUiText(char *dst, size_t n, uint32_t mv) {
  if (!mv) snprintf(dst, n, "--");
  // v8.9v: разряжена — дописываем LOW (влезает: "3.12V LOW" = 9 знаков)
  else if (mv < 3300) snprintf(dst, n, "%u.%02uV LOW", (unsigned)(mv / 1000), (unsigned)((mv % 1000) / 10));
  else snprintf(dst, n, "%u.%02uV", (unsigned)(mv / 1000), (unsigned)((mv % 1000) / 10));
}
// иконка батареи 22x10: рамка + носик + 4 сегмента (v8.9x: была сплошная заливка
 // от мгновенного замера — прыгала; теперь уровень сглажен и с гистерезисом).
 // mv — СГЛАЖЕННЫЕ милливольты (battUiMvSmooth).
static void battUiIcon(int x, int y, uint32_t mv) {
  uiRect(x, y, 20, 1, 3); uiRect(x, y + 9, 20, 1, 3);
  uiRect(x, y, 1, 10, 3); uiRect(x + 19, y, 1, 10, 3);
  uiRect(x + 20, y + 3, 2, 4, 3);                       // носик
  const int lvl = battUiLevel(mv);
  for (int s = 0; s < lvl; s++)
    uiRect(x + 2 + s * 4, y + 2, 3, 6, 3);              // сегменты 3 px + 1 px зазор
}

// v8.9v: батарея в шапке (иконка + вольты), блок прижат вправо к MEM_W-6.
// y — верх блока (высота 10 px).
static void battUiHeader(int y) {
  const uint32_t mv = battUiMvSmooth();   // v8.9x: сглаженные (не прыгают)
  char vb[12]; battUiText(vb, sizeof(vb), mv);
  const int vlen = !mv ? 2 : (mv < 3300 ? 9 : 5);
  const int tw = vlen * 4 * 2, iw = 22, gap = 6;
  const int x1 = MEM_W - 6;
  battUiIcon(x1 - tw - gap - iw, y, mv);
  uiText(x1 - tw, y, 2, vb, 2);
}

// v8.9v: ИНДИКАТОР БАТАРЕИ В ИГРЕ — живёт в нижней чёрной полосе
// (строки 229..238), игровые пиксели не трогаем вообще.
// Замер — не чаще раза в секунду (АЦП дёргать каждый кадр незачем).
static uint32_t battHudMv = 0;
static uint32_t battHudNextMs = 0;
static uint16_t battHudFg = 0xFFFFu;   // цвет индикатора в порядке отправки
static void battHudSample(void) {
  const uint32_t now = millis();
  if ((int32_t)(now - battHudNextMs) < 0) return;
  battHudNextMs = now + 1000;
  battHudMv = battUiMvSmooth();   // v8.9x: сглаженные (не прыгают)
  // v8.9w: цвет — приглушённый светлый цвет ТЕКУЩЕЙ палитры (30 %): под каждую
  // игру свой оттенок, из картинки не выбивается. Разряд — красным.
  if (battHudMv && battHudMv < 3300)
    battHudFg = (uint16_t)((0xF800u >> 8) | (0xF800u << 8));   // красный в порядке отправки
  else {
    const uint16_t c = curPal[0];
    uint16_t r = (uint16_t)((((c >> 11) & 31) * 3 + 5) / 10);
    uint16_t g = (uint16_t)((((c >> 5) & 63) * 3 + 5) / 10);
    uint16_t b = (uint16_t)(((c & 31) * 3 + 5) / 10);
    if (r < 2 && g < 4 && b < 2) { r = 9; g = 18; b = 9; }   // инверсия: был бы чёрный на чёрном
    const uint16_t dim = (uint16_t)((r << 11) | (g << 5) | b);
    battHudFg = (uint16_t)((dim >> 8) | (dim << 8));
  }
}
// одна строка индикатора (r = 0..9): собираем в общий строковый буфер tx_rowbuf.
// txRow копирует данные синхронно (memcpy в DMA-буфер), поэтому буфером можно
// пользоваться тут же — ровно так делает cb_lcd_line для строк игры.
// v8.9x: иконка 22x8 (была 22x10 вплотную к картинке): в полосе 12 строк
// сверху и снизу по 2 px чёрного. Только иконка, 4 сегмента.
static void battHudRow(int r) {
  uint16_t *w = (uint16_t *)tx_rowbuf;
  for (int x = 0; x < MEM_W; x++) w[x] = 0;   // фон полосы — чёрный
  const uint16_t fg = battHudFg;
  const int ix = MEM_W - 6 - 22;              // иконка прижата вправо
  if (r == 0 || r == 7) { for (int x = 0; x < 20; x++) w[ix + x] = fg; }
  else { w[ix] = fg; w[ix + 19] = fg; }
  if (r >= 2 && r <= 5) { w[ix + 20] = fg; w[ix + 21] = fg; }   // носик
  if (r >= 2 && r <= 5) {
    const int lvl = battUiLevel(battHudMv);
    for (int s = 0; s < lvl; s++)
      for (int x = 0; x < 3; x++) w[ix + 2 + s * 4 + x] = fg;
  }
}
// низ кадра: чёрные строки + индикатор батареи в нижней полосе.
// Полоса — 12 строк (228..239); индикатор 8 строк (230..237) + отступы (v8.9x).
static void rowBlTail(int n) {
  battHudSample();                                  // раз в секунду обновит вольты
  if (n < 12) { rowBl(n); return; }                 // короткий кадр — просто чёрное
  rowBl(n - 12);
  rowBl(2);                                         // 228..229: отступ от картинки
  for (int r = 0; r < 8; r++) {                     // 230..237: индикатор
    battHudRow(r);
    if (!txRowY((const uint8_t *)tx_rowbuf)) return;
  }
  rowBl(2);                                         // 238..239
}

// Сравнение с замером при включении: садится ли что-нибудь.
static void battCompare(void) {
  for (int i = 0; i < 4; i++) {
    if (battChBoot[i] < 100) continue;                    // канал «пустой» — не о чем говорить
    if (battCh[i] * 100u < (uint32_t)battChBoot[i] * 85u) {
      Serial.print(F("!! канал A")); Serial.print(i); Serial.print(F(" просел: было "));
      Serial.print(battChBoot[i]); Serial.print(F(", стало ")); Serial.print(battCh[i]);
      Serial.println(F(" — похоже на разряд или просадку питания"));
    }
  }
}

// ============================================================ «чёрный ящик» во flash
// Пишем в отдельный кусок flash (ДВА сектора = 32 записи по 256 байт) фазу, номер
// кадра, сколько прожили, состояние шины и PC игры. Кусок не боится ни
// перезагрузки, ни исчезновения питания — по нему видно, что было в момент смерти.
//
// ИСПРАВЛЕНО в v8.7: номер записи раньше начинался с нуля в каждом запуске, и
// «самая свежая» запись могла оказаться старой записью прошлого сеанса (в вашем
// логе стенд так и показал чужую запись — «кадров 0, а байт 230400»). Теперь при
// загрузке ящик очищается целиком, и нумерация внутри запуска сквозная.
//
// ЛОВУШКА ДЛЯ ЗАВИСАНИЯ: первые BLK_TRAP кадров пишем ДВЕ записи на кадр — перед
// ядром и после. Два сектора специально затем, чтобы ни одно СТИРАНИЕ сектора не
// попало в эти первые полсекунды (стирание занимает десятки миллисекунд и
// подвешивает игру — раньше оно как раз и случалось на 10-12-м кадре).
// Дальше пишем редко: 0,5 с первые 10 секунд, потом раз в 5 с.
#define BLK_OFF       (FLASH_TOTAL - FLASH_RESERVE - BLK_SECTOR * BLK_SECTORS)
#define BLK_MAGIC     0x314B4C42UL             // "BLK1"
#define BLK_PAGES     16                       // страниц по 256 байт в секторе
#define BLK_SLOTS     (BLK_PAGES * BLK_SECTORS)
#define BLK_FIELD     53                       // слов в записи (212 байт из 256)
                                               // v8.9r: было 52, добавилось поле о частоте панели
#define BLK_TRAP      12                       // кадров «следа» (по две записи на кадр)

static bool     blkOn = true;
static uint32_t blkLastMs = 0, blkWrites = 0, blkSeq = 0, blkWipes = 0, blkErases = 0;
static uint32_t gPowerCutBy = 0;               // сколько раз прошивка сама снимала питание
static int      blkNewestSlot = -1;            // где лежит самая свежая запись
static uint8_t  blkFree[BLK_SECTORS];          // сколько страниц ещё свободно в секторе

// Смещение записи с номером seq: секторы по кругу, внутри сектора — по страницам
static inline uint32_t blkSlotOff(uint32_t seq) {
  const uint32_t sec  = (seq / BLK_PAGES) % BLK_SECTORS;
  const uint32_t page = seq % BLK_PAGES;
  return BLK_OFF + sec * BLK_SECTOR + page * 256u;
}

// Разбор того, что осталось от прошлого запуска: где самая свежая запись
static uint32_t blkFlashOps = 0, blkFlashUs = 0, blkLastOpUs = 0, blkLastOpMs = 0;
static bool     blkLogFlash = false;            // первые 20 с печатать каждую операцию flash

// Полная очистка ящика при загрузке (в setup, до игры — там стирание безвредно):
// после этого ЛЮБАЯ запись в ящике относится к этому запуску, старое не «прикинется»
// свежим, и в первые полсекунды работы стирать уже не придётся.
// ---- v8.9j: ВО ВРЕМЯ ИГРЫ FLASH НЕ ТРОГАЕМ -----------------------------------
// Опыт на консоли: с выключенным ящиком (режим DOWN) игра идёт нормально, а с
// включённым — перезагрузка по выводу RUN через доли секунды после начала игры.
// Единственное, что ящик делал: ЛЕЗ В FLASH ВО ВРЕМЯ ИГРЫ — раз в 0,25 с запись
// страницы и раз в ~4 с СТИРАНИЕ СЕКТОРА (сотни миллисекунд с выключенным доступом
// к flash, плюс всплеск тока). Теперь:
//   * отметки идут в КОЛЬЦО В ОЗУ (быстро, без flash);
//   * во flash уходит страница отметки, если в кольце ящика есть место, и БЕЗ СТИРАНИЙ;
//   * всё кольцо ОЗУ сбрасывается во flash при ВЫКЛЮЧЕНИИ и в отчёте о смерти.
#define BLK_RAM_N     16                        // сколько отметок держим в ОЗУ
static uint32_t blkRam[BLK_RAM_N][BLK_FIELD];
static uint32_t blkRamHead = 0, blkRamN = 0;
// ВАЖНО (v8.9k): по умолчанию во время ИГРЫ во flash не пишем вообще ничего — отметки
// копятся в кольце ОЗУ и уходят во flash при выключении / в отчёте о смерти.
// Причина: опыт показал, что смерть приходит от flash-операции ВНУТРИ кадра (окно панели
// открыто), а операции между кадрами (автосейв, сейвстейт) безопасны.
static bool     blkSafeFlush = false;           // режим START: выгружать кольцо между кадрами
static bool     blkEraseInPlay = false;         // режим A: как раньше — со стираниями (контроль)
static bool     blkRingFull = false;            // во flash больше нет места под отметки
static uint32_t blkTotal = 0, blkFlushed = 0;   // сколько отметок сделано / уже ушло во flash
static uint32_t blkLastFlushMs = 0;             // когда последний раз выгружали

static void blkPushRam(const uint32_t *v) {
  memcpy(blkRam[blkRamHead], v, BLK_FIELD * sizeof(uint32_t));
  blkRamHead = (blkRamHead + 1) % BLK_RAM_N;
  if (blkRamN < BLK_RAM_N) blkRamN++;
}

// Собрать запись. Отдельно от записи — потому что она нужна и кольцу ОЗУ, и flash.
static void blkPrepare(uint32_t *v) {
  memset(v, 0, BLK_FIELD * sizeof(uint32_t));
  v[0]  = BLK_MAGIC;
  v[1]  = gPhase;
  v[2]  = gFramesTotal;
  v[3]  = millis() / 1000;
  v[4]  = watchdog_hw->scratch[6];       // отметка прерывания звука (0 = в норме)
  v[5]  = txRowsFail; v[6] = spiStuck; v[7] = gateSkips;
  v[8]  = frameUs;
  v[9]  = (uint32_t)gb.cpu_reg.pc.reg;   // ГДЕ была игра: по этому видно зависание в ядре
  v[10] = (uint32_t)gb.cpu_reg.sp.reg;
  v[11] = frameRows; v[12] = txBytesFrame;
  v[13] = drawThisDbg ? 1u : 0u;
  v[14] = millis(); v[15] = txBytes;
  v[16] = blkSeq;                        // сквозной номер записи
  v[17] = spi_get_hw(spi0)->sr;          // что говорит шина прямо сейчас
  v[18] = spiRestarts;
  v[19] = txDroppedLines;                // сколько строк следа не напечаталось
  v[20] = gDieA; v[21] = gDieB; v[22] = gDieC; v[23] = gDieD;   // подробности смерти
  v[24] = battARaw;                       // питание в момент записи (GP26, как в стоке)
  v[25] = watchdog_get_count();           // сколько МКС оставалось до сброса сторожем
  v[26] = battAMv;                        // то же в милливольтах
  v[27] = battANoise | ((uint32_t)battBRaw << 16);     // дрожание + значение GP29
  v[28] = gFaultSp;                       // SP на входе в обработчик сбоя
  v[29] = gFaultMsp;                      // MSP сбоя
  v[30] = gFaultPsp;                      // PSP сбоя
  v[31] = gFaultXpsr;                     // xPSR из кадра исключения (бит 24 = Thumb)
  v[32] = stackUseBytes();                // сколько байт стека ушло за сеанс
  v[33] = gStackTop;                      // верх стека (MSP на старте)
  v[34] = SYS_DFSR;                       // регистр debug-сбоя
  v[35] = SYS_AFSR;                       // регистр внешнего сбоя
  v[36] = ((uint32_t)battCh[0] << 16) | battCh[1];      // АЦП: GP26 и GP27 в момент записи
  v[37] = ((uint32_t)battCh[2] << 16) | battCh[3];      // АЦП: GP28 и GP29
  v[38] = gPowerCutBy;                    // сколько раз НАША прошивка снимала питание
  v[39] = (uint32_t)digitalRead(PIN_PWR_HOLD);          // состояние ключа питания прямо сейчас
  v[40] = (uint32_t)digitalRead(PIN_EN12);              // и EN12 (сток гасит его при выключении)
  v[41] = battChBoot[0] | ((uint32_t)battChBoot[3] << 16);   // что было на АЦП при включении
  // v8.9p: в это поле теперь упаковано три вещи — залипание (бит 0), сколько раз
  // ловили просадку питания (биты 1..16) и сколько автоматических записей во flash
  // из-за этого отложено (биты 17..31). По ним после смерти видно, было ли питание.
  v[42] = (gStalled ? 1u : 0u) | ((gDipEvents & 0xFFFFu) << 1) | ((gGuardDefers & 0x7FFFu) << 17);
  v[52] = (uint32_t)(spiHzIdx & 0xFFu) | ((uint32_t)(gShedSteps & 0xFFu) << 8)
        | ((uint32_t)(gShedUps & 0xFFFFu) << 16);         // v8.9r: на какой частоте панель и сколько шагов
  v[43] = gInDieReport ? 1u : 0u;         // запись делается из доклада о смерти?
  v[44] = SYS_CHIP_RESET;                 // причина сброса от чипа (HAD_POR и прочее)
  v[45] = gDipMin;                        // питание: минимум за окно (≈0,25 с) — просадка!
  v[46] = gDipMax;                        // питание: максимум за окно
  v[47] = gDipWorst;                      // самый глубокий провал за сеанс
  gDipMin = 4095; gDipMax = 0;            // окно закрыто: начинаем новое
  v[48] = blkErases;                      // сколько раз СТИРАЛИ flash за сеанс
  v[49] = blkWrites;                       // сколько отметок сделано
  v[50] = blkFlashOps;                     // операций с flash (запись+стирание)
  v[51] = blkLastOpUs;                     // сколько заняла последняя операция (мкс)
}

// Запись одной страницы во flash. Обратите внимание: здесь НЕТ стирания — только запись,
// и только если страница ещё чистая (это проверяют вызывающие).
static void blkProgramPage(uint32_t off, const uint32_t *v) {
  uint8_t page[256];
  memset(page, 0xFF, sizeof(page));
  memcpy(page, v, BLK_FIELD * sizeof(uint32_t));
  const uint32_t t0 = micros();
  flash_range_program(off, page, 256);
  const uint32_t dt = micros() - t0;
  blkFlashOps++; blkFlashUs += dt; blkLastOpUs = dt; blkLastOpMs = millis();
  if (blkLogFlash && !gInDieReport) {
    Serial.print(F("флеш: запись страницы №")); Serial.print((off - BLK_OFF) / 256);
    Serial.print(F(", заняло ")); Serial.print(dt); Serial.println(F(" мкс"));
  }
}

// Одна отметка. ПО УМОЛЧАНИЮ во flash не пишем вовсе: отметка идёт в кольцо ОЗУ,
// а во flash её отправит выгрузка — при выключении, в отчёте о смерти или (режим START)
// между кадрами. В игре пишем только в контрольном режиме A — чтобы видеть разницу.
// Занят ли слот (в нём уже лежит запись)?
static bool blkSlotUsed(uint32_t idx) {
  const uint32_t *q = (const uint32_t *)(flashBase + blkSlotOff(idx % BLK_SLOTS));
  return q[0] == BLK_MAGIC;
}

// Освободить слот: если он занят — стираем ВЕСЬ сектор, в котором он лежит (это
// единственный способ записать в него снова). Так стирание происходит не при каждом
// включении, а только когда кольцо слотов действительно вернулось к занятому месту.
// Возвращает false, если стирать нельзя (тогда запись не делаем).
static bool blkEnsureSlot(uint32_t idx, bool allowErase) {
  if (!blkSlotUsed(idx)) return true;
  if (!allowErase) return false;
  const uint32_t sec = (idx / BLK_PAGES) % BLK_SECTORS;   // сектор по кругу (номер слота растёт)
  const uint32_t base = BLK_OFF + sec * BLK_SECTOR;
  const uint32_t t0 = micros();
  flash_range_erase(base, BLK_SECTOR);
  blkErases++; blkFree[sec] = BLK_PAGES;
  blkFlashOps++; blkLastOpUs = micros() - t0; blkLastOpMs = millis(); blkFlashUs += blkLastOpUs;
  if (blkLogFlash) {
    Serial.print(F("флеш: СТИРАНИЕ сектора №")); Serial.print(sec);
    Serial.print(F(", заняло ")); Serial.print(blkLastOpUs); Serial.println(F(" мкс"));
  }
  return true;
}

static void blkInit(void) {
  blkNewestSlot = -1; blkSeq = 0;
  uint32_t best = 0; bool have = false;
  uint32_t used[BLK_SECTORS] = {0, 0};
  for (uint32_t s = 0; s < BLK_SLOTS; s++) {
    const uint32_t *p = (const uint32_t *)(flashBase + blkSlotOff(s));
    if (p[0] != BLK_MAGIC) continue;
    used[s / BLK_PAGES]++;
    if (!have || p[16] >= best) { best = p[16]; blkNewestSlot = (int)s; have = true; }
  }
  blkSeq = have ? (best + 1) : 0;
  // v8.9l: НИЧЕГО НЕ СТИРАЕМ при включении. Свободные слоты используем как есть,
  // а занятые освобождаются стиранием только когда до них дойдёт очередь.
  for (uint32_t i = 0; i < BLK_SECTORS; i++) blkFree[i] = BLK_PAGES - used[i];
  blkRingFull = (blkFree[0] == 0 && blkFree[1] == 0);
}

static void blkWrite(void) {
  if (!blkOn) return;
  // Счётчики и время отметки — ВСЕГДА, даже когда во flash не пишем: по blkLastMs
  // работает расписание дежурства (иначе дежурство «залипло бы» и писало каждый кадр).
  blkLastMs = millis(); blkWrites++; blkTotal++;
  const uint32_t phSave = gPhase;
  uint32_t v[BLK_FIELD];
  blkPrepare(v);
  blkPushRam(v);
  if (!blkEraseInPlay) { mark(phSave); return; }   // ОСНОВНОЙ режим: во flash не лезем
  // (в контрольном режиме A полное кольцо не помеха: занятый слот освобождаем стиранием)
  const uint32_t off = blkSlotOff(blkSeq);
  const uint32_t sec = (blkSeq / BLK_PAGES) % BLK_SECTORS;
  if (!blkEnsureSlot(blkSeq, blkEraseInPlay)) {
    blkRingFull = true;
    Serial.println(F("ящик: возвращаться к занятым слотам нельзя — дальше пишу только в ОЗУ"));
    return;
  }
  mark(PH_BB);
  if (!gInDieReport) soundSuspend();       // чтобы запись не щёлкнула в динамике
  blkProgramPage(off, v);
  if (!gInDieReport) soundResume();
  blkFree[sec]--;
  blkNewestSlot = (int)(blkSeq % BLK_SLOTS);
  blkSeq++;
  blkFlushed++;                        // эта отметка теперь и во flash
  mark(phSave);                        // вернуть фазу как было (раньше её портили)
}

// Выгрузка НОВЫХ отметок из кольца ОЗУ во flash. Вызывается ВНЕ кадра: при выключении,
// в отчёте о смерти и (режим START) между кадрами — там это безопасно (так же пишет
// автосейв, и он ни разу не сбил консоль).
// allowErase: разрешено ли стирать сектор (при выключении — да, в игре — нет).
static void blkFlushGuarded(void);        // v8.9p: выгрузка ящика только при живом питании

static void blkFlush(bool allowErase) {
  if (!blkOn || blkFlushed >= blkTotal) return;
  if (blkTotal - blkFlushed > BLK_RAM_N) blkFlushed = blkTotal - BLK_RAM_N;   // старое уже потеряно
  const uint32_t n = blkTotal - blkFlushed;
  if (!gInDieReport) { Serial.print(F("ящик: выгружаю во flash отметок ")); Serial.print(n); Serial.println(F("...")); }
  if (!gInDieReport) quietFlashBegin();     // v8.9q: глушим звук и гасим свет на время записи
  for (uint32_t i = 0; i < n; i++) {
    const uint32_t idx = (blkRamHead + BLK_RAM_N - n + i) % BLK_RAM_N;   // от старых к новым
    const uint32_t off = blkSlotOff(blkSeq);
    const uint32_t sec = (blkSeq / BLK_PAGES) % BLK_SECTORS;
    if (!blkEnsureSlot(blkSeq, allowErase)) break;
    uint32_t v[BLK_FIELD];
    memcpy(v, blkRam[idx], sizeof(v));
    v[16] = blkSeq;                       // в flash запись получает свой сквозной номер
    blkProgramPage(off, v);
    blkFree[sec]--;
    blkNewestSlot = (int)(blkSeq % BLK_SLOTS);
    blkSeq++; blkFlushed++;
  }
  if (!gInDieReport) quietFlashEnd();
  blkLastFlushMs = millis();
}

// Безопасная точка: вызывается в начале цикла, когда панель между кадрами свободна.
// Работает только в режиме START и только если панель действительно молчит.
// Выгрузка ящика из автоматики (раз в 5 с в режиме START): только при живом питании.
static void blkFlushGuarded(void) {
  if (!battGuardOk()) return;
  blkFlush(true);
}

static void blkSafeTick(void) {
  if (!blkOn || !blkSafeFlush || blkEraseInPlay) return;
  if (blkFlushed >= blkTotal) return;
  if (spi_is_busy(spi0)) return;                       // панель ещё занята — отложим
  if ((uint32_t)(millis() - blkLastFlushMs) < 5000UL) return;
  blkFlushGuarded();          // v8.9p: при просевшем питании выгрузку откладываем
}

static void blkWipe(void) {
  if (!blkOn) return;
  noInterrupts();
  for (uint32_t s = 0; s < BLK_SECTORS; s++)
    flash_range_erase(BLK_OFF + s * BLK_SECTOR, BLK_SECTOR);
  interrupts();
  blkWipes++; blkErases += BLK_SECTORS;
  for (uint32_t i = 0; i < BLK_SECTORS; i++) blkFree[i] = BLK_PAGES;   // оба сектора пусты
  blkSeq = 0; blkNewestSlot = -1; blkRingFull = false;
  blkTotal = 0; blkFlushed = 0; blkRamN = 0; blkLastFlushMs = millis();
}



// Частота записей: первые 10 с — раз в 0,5 с, дальше раз в 5 с.
// Дежурство: пока консоль молодая — пишем ЧАСТО (0,25 с), чтобы смерть оставила
// след с точностью до четверти секунды. Дальше реже (5 с), чтобы не пилить flash.
static void blkTick(void) {
  if (!blkOn) return;
  const uint32_t gap = (millis() < 60000UL) ? 250UL : 5000UL;
  if ((millis() - blkLastMs) >= gap) { battRead(); blkWrite(); }
}

// ЛОВУШКА: первые кадры — запись в ящик на каждый кадр (по две на кадр).
static inline void blkTrap(void) {
  if (blkOn && gFramesTotal <= BLK_TRAP) blkWrite();
}

static void blkRead(void) {
  if (blkNewestSlot < 0) {
    Serial.println(F("--- чёрный ящик: записей от прошлого запуска нет ---"));
    return;
  }
  const uint32_t *p = (const uint32_t *)(flashBase + blkSlotOff((uint32_t)blkNewestSlot));
  Serial.println(F("--- чёрный ящик (запись из прошлого запуска) ---"));
  Serial.print(F("   запись №")); Serial.print(p[16]);
  Serial.print(F(" (слот ")); Serial.print(blkNewestSlot);
  Serial.print(F(" из ")); Serial.print(BLK_SLOTS); Serial.println(F(")"));
  Serial.print(F("   фаза: "));            Serial.print(phaseName(p[1]));
  Serial.print(F(", кадров "));            Serial.print(p[2]);
  Serial.print(F(", прожили "));           Serial.print(p[3]); Serial.print(F(" с (запись в "));
  Serial.print(p[14] / 1000);              Serial.println(F(" с)"));
  Serial.print(F("   в игре: PC=0x"));     Serial.print(p[9], HEX);
  Serial.print(F(" SP=0x"));               Serial.print(p[10], HEX);
  Serial.print(F("   кадр "));             Serial.print(p[8] / 1000.0f, 1); Serial.print(F(" мс, строк "));
  Serial.print(p[11]);                     Serial.print(F(", байт в панель ")); Serial.println(p[12]);
  Serial.print(F("   не ушло строк "));    Serial.print(p[5]);
  Serial.print(F(", сбоев SPI "));         Serial.print(p[6]);
  Serial.print(F(", пропущено кадров "));  Serial.print(p[7]);
  Serial.print(F(", звук (0=норма) "));    Serial.print(p[4]);
  Serial.print(F(", байт всего "));        Serial.println(p[15]);
  // v8.9r: на какой частоте была панель и сколько раз нагрузку роняли/возвращали.
  // v8.9t: в записи СТАРОГО формата (до v8.9r) этого поля не было — там лежит 0xFFFFFFFF,
  // и раньше в лог печаталось «панель: МГц, ступеней вниз 255, возвратов 65535».
  {
    const uint32_t hz = p[52];
    if (hz == 0xFFFFFFFFu || (hz & 0xFFu) >= (sizeof(SPI_HZ_NAME) / sizeof(SPI_HZ_NAME[0]))) {
      Serial.println(F("   панель: в этой записи частота не сохранялась (запись старого формата)"));
    } else {
      Serial.print(F("   панель: ")); Serial.print(SPI_HZ_NAME[hz & 0xFFu]); Serial.print(F(" МГц"));
      Serial.print(F(", ступеней вниз ")); Serial.print((hz >> 8) & 0xFFu);
      Serial.print(F(", возвратов наверх ")); Serial.println((hz >> 16) & 0xFFFFu);
    }
  }
  Serial.print(F("   шина: sr=0x"));       Serial.print(p[17], HEX);
  Serial.print(F(", перезапусков "));      Serial.print(p[18]);
  Serial.print(F(", строк следа не напечатано ")); Serial.println(p[19]);
  // v8.9p: сколько раз за сеанс ловили просадку питания и сколько автозаписей отложили
  Serial.print(F("   просадок питания за сеанс: ")); Serial.print((p[42] >> 1) & 0xFFFFu);
  Serial.print(F(", отложенных автозаписей во flash: ")); Serial.println((p[42] >> 17) & 0x7FFFu);
  if (p[20] || p[21] || p[22] || p[23]) {
    Serial.print(F("   подробности: 0x")); Serial.print(p[20], HEX);
    Serial.print(F(", 0x")); Serial.print(p[21], HEX);
    Serial.print(F(", 0x")); Serial.print(p[22], HEX);
    Serial.print(F(", 0x")); Serial.println(p[23], HEX);
  }
  if (p[1] == PH_FAULT) Serial.println(F("   (это АППАРАТНЫЙ СБОЙ: см. причину и адрес выше)"));
  if (p[1] == PH_STALL) Serial.println(F("   (это ЗАЛИПАНИЕ: цикл встал, звук продолжал идти)"));
  Serial.print(F("   питание: GP26 "));  Serial.print(p[24]);
  Serial.print(F(" отсч. = "));     Serial.print(p[26]);
