  for (int i = 0; i < 4; i++) {
    uint16_t c = curPal[i];
    Serial.print(F("rgb(")); Serial.print((c >> 11 & 31) * 255 / 31);
    Serial.print(',');       Serial.print((c >> 5 & 63) * 255 / 63);
