    Serial.print(F("  панель ")); Serial.print(SPI_HZ_NAME[spiHzIdx]); Serial.print(F(" МГц"));
  }
  Serial.print(F("  эмуляция=")); Serial.print(avgEmuUs); Serial.print(F(" мкс"));
  Serial.print(F("  кадр="));     Serial.print(avgAllUs); Serial.print(F(" мкс"));
  Serial.print(F("  цель="));     Serial.print(FRAME_US); Serial.print(F(" мкс"));
  Serial.println();
  Serial.print(F("   игра: ")); Serial.print(romTitle);
  Serial.print(F(" ("));
  if (romCur >= 0) { Serial.print(F("картридж ")); Serial.print(romCur + 1); Serial.print(F(" из ")); Serial.print(romCount); }
  else Serial.print(F("встроенная rom.h"));
  Serial.print(F("), ключ сейва 0x")); Serial.print(romFingerprint(), HEX);
  if (saveLen) { Serial.print(F(", ячейка ")); Serial.print(saveBank + 1); Serial.print(F("/")); Serial.print(bankCount); }
  Serial.println();
  Serial.print(F("   кадр с выводом "));  Serial.print(avgDrawUs / 1000.0f, 1);
  Serial.print(F(" мс = ядро "));         Serial.print(avgCoreUs / 1000.0f, 1);
  Serial.print(F(" (в нём наш вывод "));  Serial.print(avgCbUs / 1000.0f, 1);
  Serial.print(F(" мс = "));              Serial.print(avgCbUsPer); Serial.print(F(" мкс/вызов"));
  Serial.print(F("), остальное "));       Serial.print((avgDrawUs - avgCoreUs) / 1000.0f, 1);
  Serial.print(F(", вызовов/кадр "));     Serial.print(avgCbCalls);
  Serial.print(F(", ожидание SPI "));     Serial.print(avgWaitUs / 1000.0f, 1);
  Serial.print(F(" мс, отправка "));       Serial.print(avgSpiUs / 1000.0f, 2);
  Serial.print(F(" мс ("));                Serial.print(avgSpiCalls); Serial.print(F("/кадр)"));
  if (txUseDma && txDmaReady) {
    Serial.print(F(", вывод DMA ")); Serial.print(avgDmaRows);
    Serial.print(F("/кадр, ожидание DMA ")); Serial.print(avgDmaWaitUs);
    Serial.print(F(" мкс/кадр"));
    if (txDmaAborts) { Serial.print(F(" (сбросов канала ")); Serial.print(txDmaAborts); Serial.print(F(")")); }
  } else if (avgSpiSyncUs) {
    Serial.print(F(", из них синхронно ")); Serial.print(avgSpiSyncUs / 1000.0f, 1); Serial.print(F(" мс"));
  }

  Serial.println();
  Serial.print(F("   строки: запись "));   Serial.print(avgRowUs); Serial.print(F(" мкс/строка"));
  Serial.print(F(", отдано "));            Serial.print(avgRowsW); Serial.print(F("/кадр"));
  Serial.print(F(", не влезло "));         Serial.print(avgRowsL);
  Serial.print(F(", сбоев SPI "));         Serial.print(avgDmaBad);
  Serial.print(F(", кадров всего "));      Serial.print(gFramesTotal);
  Serial.print(F(", медленных "));         Serial.print(gSlowFrames);
  Serial.print(F(", вывод "));             Serial.print(txPathName());
  Serial.print(F(" @ "));                  Serial.print(spi_get_baudrate(spi0) / 1000000.0f, 1); Serial.print(F(" МГц"));

  Serial.print(F(", звук-прерывание "));   Serial.print(avgIrqUs); Serial.print(F(" мкс x "));
  Serial.print(avgIrqN); Serial.print(F(" шт/с"));
  Serial.print(F(", SPI "));               Serial.print(spi_get_baudrate(spi0) / 1000000.0f, 1); Serial.print(F(" МГц"));
  if (gateSkips) { Serial.print(F(", пропущено кадров панелью ")); Serial.print(gateSkips); }
  if (gGuardDefers) { Serial.print(F(", автозаписей отложено (питание) ")); Serial.print(gGuardDefers); }
  if (spiRestarts) { Serial.print(F(", перезапусков шины ")); Serial.print(spiRestarts); }
  Serial.print(F(", просадка за сеанс мин ")); Serial.print(gDipWorst);
  Serial.print(F(" / сработала "));           Serial.print(gDipEvents); Serial.print(F(" раз"));
  { int rise = 0;
    const int mv = tempReadMv(&rise);
    Serial.print(F(", нагрев чипа +")); Serial.print(rise); Serial.print(F(" °C"));
    if (mv) { Serial.print(F(" (датчик ")); Serial.print(mv); Serial.print(F(" мВ, база "));
              Serial.print(tempBaseMv); Serial.print(F(" мВ — абсолютной цифре не верим)")); }
    else Serial.print(F(" (датчик не читается)")); }
  Serial.print(F(", питание A0="));         Serial.print(battCh[0]);
  Serial.print(F(" A3="));                   Serial.print(battCh[3]);
  Serial.print(F(", сторожу оставалось "));  Serial.print(watchdog_get_count() / 1000); Serial.print(F(" мс"));
  Serial.print(F(", чёрный ящик "));
  if (!blkOn) Serial.print(F("выкл"));
  else if (blkEraseInPlay) Serial.print(F("как раньше (пишет в игре)"));
  else if (blkSafeFlush) Serial.print(F("ОЗУ + выгрузка между кадрами"));
  else Serial.print(F("только в ОЗУ (во flash — при выключении)"));
  Serial.print(F(" (отметок "));             Serial.print(blkTotal);
  Serial.print(F(", во flash "));            Serial.print(blkFlushed);
  Serial.print(F(", стираний "));            Serial.print(blkErases);
  Serial.print(F(", операций с flash "));    Serial.print(blkFlashOps);
  if (blkRingFull) Serial.print(F(", кольцо ящика полно"));
  Serial.print(F(")"));
  Serial.println();
  Serial.print(F("   износ flash: сейвы ")); Serial.print(saveErases);
  Serial.print(F(" стираний секторов, сейвстейты ")); Serial.print(ssErases);
  Serial.print(F(", ящик ")); Serial.print(blkErases);
  Serial.print(F(" (ресурс сектора ~100000 стираний; сейвы пишем только изменившимися секторами, автосейв раз в 2 мин)"));
  if (txDroppedLines) { Serial.print(F(", строк следа пропущено ")); Serial.print(txDroppedLines); }
  Serial.println();
  Serial.print(F("  CPU="));      Serial.print(F_CPU / 1000000U); Serial.print(F(" МГц"));
  Serial.print(F("  палитра="));  Serial.print(PALS[palIdx].name);

  if (emuInited && gb.direct.interlace) Serial.print(F("  [интерлейс]"));
  if (paused) Serial.print(F("  [ПАУЗА]"));
  if (emuInited && gb.direct.frame_skip) Serial.print(F("  [30 fps]"));
  if (cartDirty) Serial.print(F("  [есть несохранённое]"));
  Serial.print(F("  звук=")); Serial.print(soundOn ? volPct : 0);
  if (!soundOn) Serial.print(F("%(выкл)"));
  else {
    Serial.print(F("%"));
    Serial.print(F(" AMP=LOW"));
    Serial.print(F(" темп=")); Serial.print(soundSync ? F("GAME(") : F("REAL("));
    Serial.print(apuTmrUs); Serial.print(F(" мкс)"));
  }
  Serial.print(F("  ядро=")); Serial.print(((uintptr_t)&gb_run_frame >= 0x20000000UL) ? F("ОЗУ") : F("FLASH"));
  if (emuInited) {
    Serial.print(F("  BGP=")); Serial.print(gb.hram_io[0x47], HEX);
    Serial.print(F(" OBP0=")); Serial.print(gb.hram_io[0x48], HEX);
    Serial.print(F(" OBP1=")); Serial.print(gb.hram_io[0x49], HEX);
  }
  Serial.println();
}

// применить изменение палитры и сообщить о нём
static void palChanged(void) {
  rebuildPalette();                          // перестраивает и таблицу цветов
