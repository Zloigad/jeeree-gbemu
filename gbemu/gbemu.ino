// ============================================================ Serial
static void handleSerial(void) {
  mark(PH_SERIAL);
  while (Serial.available()) {
    int c = Serial.read();
    if (c == '\n' || c == '\r') continue;

    if (ui == UI_LEARN) {
      if (c == 'x' || c == 'X') { ui = emuInited ? UI_GAME : UI_NOROM; Serial.println(F("Обучение прервано.")); if (!emuInited) drawNoRom(); }
      continue;
    }
    if (ui == UI_TONE) { toneStop(); continue; }      // любая клавиша останавливает тест
    switch (c) {
      case 't': case 'T':
        ui = (ui == UI_TEST) ? UI_GAME : UI_TEST;
        Serial.println(ui == UI_TEST ? F("ТЕСТ КНОПОК: номера GPIO на экране и в Serial.")
                                     : F("Назад в игру."));
        if (ui == UI_TEST) drawButtonScreen("TEST", readMask(), "GPIO NUMBERS");
        break;
      case 'l': case 'L':
        if (!emuInited) { Serial.println(F("Сначала вставьте ROM (rom.h) и пересоберите.")); break; }
        ui = UI_LEARN; learnStep = 0; learnPrev = 0; learnT0 = millis(); paused = false;
        Serial.println(F("=== ОБУЧЕНИЕ (fps не печатается, выход — x) ==="));
        learnPrompt();
        break;
      case 'a': case 'A':
        Serial.println(F("автосброс яркости удалён в v9.2: батареей яркость не трогаем никогда."));
        break;
      case 'c': case 'C':
        if (romCount) romMenuOpen();                 // список игр: выбор и запуск на ходу
        else Serial.println(F("Списка игр нет: соберите make_roms_uf2.py и залейте games.uf2."));
        break;
      case 'p': case 'P':
        paused = !paused;
        Serial.println(paused ? F("ПАУЗА.") : F("Продолжаем."));
        break;
      case 'r': case 'R':
        if (emuInited) { saveStore(false); gb_reset(&gb); gb.direct.joypad = 0xFF; Serial.println(F("Сброс игры.")); }
        break;
      case 'f': case 'F':
        if (emuInited) {
          gb.direct.frame_skip = !gb.direct.frame_skip;
          Serial.println(gb.direct.frame_skip ? F("Режим 30 кадр/с (логика остаётся 60 Гц).")
                                              : F("Полные 60 кадр/с."));
        }
        break;
      case 'g': case 'G':
        palIdx = (uint8_t)((palIdx + 1) % PAL_COUNT);
        palChanged();
        break;
      case 'k': case 'K':
        ui = (ui == UI_SHADES) ? UI_GAME : UI_SHADES;
        if (ui == UI_SHADES) drawShades();
        break;
      case 'i': case 'I':
        invertShades = !invertShades;
        Serial.println(invertShades ? F("Оттенки инвертированы.") : F("Оттенки как обычно."));
        palChanged();
        break;
      case '[': bright = (bright > 50) ? bright - 5 : 50;  palChanged(); break;
      case ']': bright = (bright < 150) ? bright + 5 : 150; palChanged(); break;
      case '-': contr  = (contr > 50)  ? contr - 10 : 50;   palChanged(); break;
      case '=': contr  = (contr < 200) ? contr + 10 : 200;  palChanged(); break;
      case 'm': case 'M':
        if (emuInited && ui != UI_MENU) menuOpen();
        break;
      case '1': if (emuInited) { Serial.println(ssSave(0) ? F("Сейвстейт 1 сохранён.") : F("Слот недоступен.")); } break;
      case '2': if (emuInited) { Serial.println(ssSave(1) ? F("Сейвстейт 2 сохранён.") : F("Слот недоступен.")); } break;
      case '3': if (emuInited) { Serial.println(ssLoad(0) ? F("Сейвстейт 1 загружен.") : F("Слот 1 пуст/от другой игры.")); } break;
      case '4': if (emuInited) { Serial.println(ssLoad(1) ? F("Сейвстейт 2 загружен.") : F("Слот 2 пуст/от другой игры.")); } break;
      case 'z': case 'Z':                              // v8.9t: проба спрятана за двойным нажатием
        if (probeArmMs && (uint32_t)(millis() - probeArmMs) < 5000UL) {
          probeArmMs = 0;
          toneStart();                                 // проба звука работает и без ROM
        } else {
          probeArmMs = millis() ? millis() : 1u;
          Serial.println(F("проба звука СПРЯТАНА: нажмите z ещё раз в течение 5 секунд, чтобы запустить."));
          Serial.println(F("   (громкие опыты со звуком; выход — кнопка A или B, любая клавиша,"));
          Serial.println(F("    либо 20 с без действий: проба конечная, ресет для выхода не нужен)"));
        }
        break;
      case 'j': case 'J':                      // тест панели: залить экран оттенками
        panelTest();
        break;
      case 'n': case 'N':                      // диагностика: что отдаёт ядро и уходят ли строки
        drawDiagStart();
        break;
      case 'd': case 'D':                      // чёрный ящик (запись состояния во flash)
        blkOn = !blkOn;
        Serial.print(F("чёрный ящик во flash: ")); Serial.println(blkOn ? F("включён") : F("выключен"));
        if (blkOn) { blkWrite(); Serial.println(F("сделал первую запись (клавиша d — выключить).")); }
        else Serial.println(F("записей было ")), Serial.println(blkWrites);
        break;
      case 'u': case 'U':                      // вывод строк: DMA / синхронно (сравнить)
        if (txUseDma) {
          if (txDmaArmed) { txDmaWait(TX_GUARD_US); txDmaArmed = false; }
          txUseDma = false;
          Serial.println(F("вывод: СИНХРОННАЯ запись строк (как было раньше) — сравните fps и звук."));
        } else {
          txUseDma = true; txDmaInit();
          Serial.println(txDmaReady
            ? F("вывод: DMA (строка уезжает сама, ядро считает дальше) — сравните fps и звук.")
            : F("DMA недоступен — остаюсь на синхронной записи."));
        }
        break;

      case 'e': case 'E':                      // починить шину и панель, если картинка пропала
        Serial.println(F("переинициализирую шину и панель (яркость и палитра не меняются)..."));
        txWaitIdle(TX_GUARD_US);
        SPI.endTransaction();
        SPI.beginTransaction(SPISettings(SPI_HZ, MSBFIRST, SPI_MODE0));
        { uint32_t x = 0; while (spi_is_readable(spi0) && x++ < 64) (void)spi_get_hw(spi0)->dr; }
        txDmaArmed = false;                    // шину перезапускали: старых передач нет
        txDmaInit();                           // и канал DMA привязываем заново
        lcdInit();                             // сброс + снятие спящего режима, окно — на весь экран
        Serial.print(F("частота SPI сейчас ")); Serial.print(spi_get_baudrate(spi0) / 1000000.0f, 1);
        Serial.println(F(" МГц (клавиша o — переключить)"));
        uiClear(0); uiPush();
        Serial.println(F("панель инициализирована заново (картинка не вернулась — сообщите)."));
        break;
      case 'o': case 'O':                      // частота SPI панели
        spiHzIdx = (uint8_t)((spiHzIdx + 1) % (sizeof(SPI_HZ_TAB) / sizeof(SPI_HZ_TAB[0])));
        spiSetClock(SPI_HZ_TAB[spiHzIdx]);
        break;
      case 'y': case 'Y':                      // темп звука: за игрой или реальное время
        soundSync = !soundSync;
        Serial.print(F("темп звука: "));
        Serial.print(soundSync ? F("GAME — синхронно с игрой (медленнее, если игра тормозит)")
                               : F("REAL — всегда реальное время"));
        Serial.println();
        break;
      case 'x': case 'X':
        soundSetOn(!soundOn);
        Serial.print(F("звук ")); Serial.print(soundOn ? F("включён") : F("выключен"));
        Serial.println(F(", усилитель: GP20 = LOW на время звука, тишина 2 с — глушим"));
        break;
      case 'v': case 'V':
        diagFrames = 3;
        Serial.println(F("снимаю статистику кадра (3 кадра)..."));
        break;
      case 'w': case 'W':
        saveStore(true);
        break;
      case 's': case 'S':
        printStatus(); printSaveState(); printFlashMap(); printSlotState();
        break;
      case 'b': case 'B':
        Serial.println(F("Уходим в режим загрузчика (RPI-RP2)..."));
        Serial.flush();
        rp2040.rebootToBootloader();
        break;
      case 'q': case 'Q':
        powerOff();
        break;
      case 'h': case 'H': case '?':
        printHelp();
        break;
      default:
        ui = emuInited ? UI_GAME : UI_NOROM;
        break;
    }
  }
}

// ============================================================ удержание START / MENU
int holdIdx = -1;                 // 0 = START, 1 = MENU (какая кнопка сейчас удерживается)
static uint32_t holdT0 = 0;
static int      offCount = -1;
#define HOLD_MS      1500         // с этого момента показываем отсчёт 3-2-1
#define HOLD_OFF_MS  3000         // всего 3 секунды удержания — и питание снимается
#define STEP_MS      500

static bool holdTick(uint16_t mask) {
  int idx = -1;
  // v9.7: держать для выключения можно не только в игре: список игр, меню и
  // «NO ROM» — тоже (вопрос «как выключить, не заходя в игру»).
  if (ui == UI_GAME || ui == UI_MENU || ui == UI_ROMS || ui == UI_NOROM) {
    if (mask & (1u << IDX_START)) idx = IDX_START;
    else if (mask & (1u << IDX_MENU)) idx = IDX_MENU;
  }
  if (idx >= 0) {
    if (holdIdx != idx) { holdIdx = idx; holdT0 = millis() ? millis() : 1; offCount = -1; }
    const uint32_t held = millis() - holdT0;
    if (held >= HOLD_OFF_MS) powerOff();
    if (held >= HOLD_MS) {
      if (offCount < 0) {                     // пишем в лог: видно, кто включил отсчёт
        Serial.print(F("удержание "));
        Serial.print(idx == IDX_START ? F("START") : F("MENU"));
        Serial.println(F(" — отсчёт 3 с (отпустите кнопку, чтобы отменить)"));
        mark(PH_HOLD);
      }
      int n = 3 - (int)((held - HOLD_MS) / STEP_MS);
      if (n < 1) n = 1;
      if (n != offCount) { offCount = n; drawPowerCountdown(n); }
      return true;
    }
    return false;
  }
  if (holdIdx >= 0) {
    const uint32_t held = millis() - holdT0;
    const int was = holdIdx;
    holdIdx = -1;
    if (offCount >= 0) { offCount = -1; Serial.println(F("Выключение отменено.")); }
    else if (held < HOLD_MS && was == IDX_MENU && emuInited) {
      menuOpen();                     // короткое нажатие MENU — меню (как в стоке)
    }
  }
  return false;
}


// ============================================================ сейвстейты
// В слот пишем: заголовок (256 Б) + всю структуру gb_s (вся память и регистры
// эмулятора) + картриджную RAM. Всё сразу и целиком — «половинок» не бывает.
#define SS_SLOTS 2
#define SS_MAGIC 0x33545353UL          // "SST3" (v7: + состояние APU, выравненные страницы)

static uint32_t ssOff[SS_SLOTS] = {0, 0};
static int      ssLen = 0;             // размер слота (кратно 4096)
static bool     ssReady = false;

static uint32_t romFingerprint(void) {
  // Ключ игры. Для картриджа из списка это CRC32 образа, который посчитал упаковщик
  // (его же мы храним в заголовке сейва). Для встроенной игры ключа нет — 0.
  if (romSaveKey) return romSaveKey;
  return 0;
}

static void ssInit(void) {
  uintptr_t end = (flashEnd + 4095u) & ~(uintptr_t)4095u;
  if (end < flashBase) end = flashBase;
  // база сейвстейтов тоже должна быть кратна сектору (иначе первая страница
  // записи съезжает — именно на это и указал хостовый стенд)
  uint32_t base = (uint32_t)(end - flashBase) + (uint32_t)saveLen * (uint32_t)(bankCount > 0 ? bankCount : 1);
  base = (base + 4095u) & ~(uint32_t)4095u;
  const uint32_t need = (uint32_t)(SAVE_HDR + sizeof(struct gb_s) + sizeof(cartRam)
                                   + sizeof(struct ApuState));
  ssLen = (int)((need + 4095u) & ~4095u);
  ssReady = true;
  // v8.9o: при залитом наборе игр сейвстейты тоже держим НИЖЕ области картриджей
  const uint32_t ssLimit = romCount ? ROMS_TABLE_OFF : FLASH_LIMIT;
  for (int i = 0; i < SS_SLOTS; i++) {
    if (base + (uint32_t)ssLen <= ssLimit) { ssOff[i] = base; base += (uint32_t)ssLen; }
    else { ssOff[i] = 0; ssReady = false; }
  }
}

// ВАЖНО (это и был баг «SAVED SLOT 1 -> EMPTY SLOT 1»): pico-sdk требует,
// чтобы flash_range_program() получал смещение, кратное 256, и длину, кратную
// 256 (ровно одна страница). Структура gb_s = 16916 Б странице не кратна,
// поэтому запись «каждую часть со своего смещения» уезжала: последняя страница
// структуры затиралась началом следующего куска (SRAM), хеш не сходился —
// сейв писался, а при загрузке отвергался.
// Теперь весь слот пишется ОДНИМ потоком: собираем байты в буфер страницы и
// отдаём во flash только целые страницы, начиная с выровненного ssOff[slot].
static uint8_t  ssPage[256];
static uint32_t ssPageBase = 0;
static size_t   ssPageFill = 0;

static void flashPageWrite(void) {                 // записать собранную страницу
  wdtFeed();
  if (ssPageFill < 256) memset(ssPage + ssPageFill, 0xFF, 256 - ssPageFill);
  flash_range_program(ssPageBase, ssPage, 256);
  ssPageBase += 256;
  ssPageFill = 0;
}

static void flashStreamBegin(uint32_t alignedOff) { // off обязан быть кратен 256
  ssPageBase = alignedOff & ~(uint32_t)0xFF;
  ssPageFill = 0;
}

static void flashStream(const uint8_t *src, size_t n) {
  while (n) {
    const size_t room = 256 - ssPageFill;
    const size_t take = n < room ? n : room;
    memcpy(ssPage + ssPageFill, src, take);
    ssPageFill += take;
    src += take;
    n -= take;
    if (ssPageFill == 256) flashPageWrite();
  }
}

static void flashStreamEnd(void) { if (ssPageFill) flashPageWrite(); }

static bool ssSave(int slot) {
  if (!ssReady || slot < 0 || slot >= SS_SLOTS || !emuInited) return false;
  const uint32_t t0 = millis();
  const uint32_t gbBytes  = (uint32_t)sizeof(struct gb_s);
  const uint32_t apuBytes = (uint32_t)sizeof(struct ApuState);

  uint8_t hdr[256];
  memset(hdr, 0xFF, sizeof(hdr));
  const uint32_t magic = SS_MAGIC, len = (uint32_t)ssLen;
  const uint32_t romH = romFingerprint();
  const uint32_t h = fnv1a((const uint8_t *)&gb, (int)gbBytes)
                   ^ fnv1a(cartRam, (int)sizeof(cartRam))
                   ^ fnv1a((const uint8_t *)&apu, (int)apuBytes);
  memcpy(hdr, &magic, 4); memcpy(hdr + 4, &len, 4);
  memcpy(hdr + 8, &romH, 4); memcpy(hdr + 12, &gbBytes, 4);
  memcpy(hdr + 16, &apuBytes, 4); memcpy(hdr + 20, &h, 4);

  mark(PH_SSAVE);
  quietFlashBegin();                    // v8.9q: тихая запись (свет гаснет, звук молчит)
  noInterrupts();
  flash_range_erase(ssOff[slot], (size_t)ssLen); ssErases++;
  flashStreamBegin(ssOff[slot]);        // слот выровнен на 4096 -> страницы ровные
  flashStream(hdr, 256);
  flashStream((const uint8_t *)&gb, gbBytes);
  flashStream(cartRam, sizeof(cartRam));
  flashStream((const uint8_t *)&apu, apuBytes);
  flashStreamEnd();
  interrupts();
  quietFlashEnd();
  mark(PH_LOOP);
  Serial.print(F("сейвстейт ")); Serial.print(slot + 1); Serial.print(F(": "));
  Serial.print(millis() - t0); Serial.print(F(" мс, ")); Serial.print(ssLen / 1024); Serial.println(F(" КиБ"));
  return true;
}

static bool ssLoad(int slot) {
  if (!ssReady || slot < 0 || slot >= SS_SLOTS || !emuInited) return false;
  const uint8_t *p = (const uint8_t *)(flashBase + ssOff[slot]);
  uint32_t magic, len, romH, gbBytes, apuBytes, h;
  memcpy(&magic, p, 4); memcpy(&len, p + 4, 4); memcpy(&romH, p + 8, 4);
  memcpy(&gbBytes, p + 12, 4); memcpy(&apuBytes, p + 16, 4); memcpy(&h, p + 20, 4);
  if (magic != SS_MAGIC || len != (uint32_t)ssLen) return false;
  if (gbBytes != sizeof(struct gb_s)) return false;
  if (apuBytes != sizeof(struct ApuState)) return false;
  if (romH != romFingerprint()) return false;                 // сейв от другой игры
  const uint32_t h2 = fnv1a(p + 256, (int)gbBytes)
                    ^ fnv1a(p + 256 + gbBytes, (int)sizeof(cartRam))
                    ^ fnv1a(p + 256 + gbBytes + (uint32_t)sizeof(cartRam), (int)apuBytes);
  if (h2 != h) return false;

  soundSuspend();
  memcpy(&gb, p + 256, gbBytes);
  memcpy(cartRam, p + 256 + gbBytes, sizeof(cartRam));
  memcpy(&apu, p + 256 + gbBytes + (uint32_t)sizeof(cartRam), apuBytes);
  // указатели на колбэки и настройки вывода — наши, а не из сейва
  gb.gb_rom_read = cb_rom_read;
  gb.gb_cart_ram_read = cb_cart_read;
  gb.gb_cart_ram_write = cb_cart_write;
  gb.gb_error = cb_error;
  gb.display.lcd_draw_line = cb_lcd_line;
  gb.direct.frame_skip = true;
  gb.direct.joypad = 0xFF;
  cartDirty = false;
  soundResume();
  return true;
}

// v9.1: ЧЕСТНЫЕ СЕЙВЫ. Ничего не удаляем молча: перед вытеснением чужого сейва
// спрашиваем, в списке игр показываем, у кого сейв уже есть.
static int saveCellKey(int i, uint32_t *keyOut) {   // 0 — сейв читается, -1 — пусто/нет, -2 — старый формат, -3 — не прочитать
  if (i < 0 || i >= bankCount || !saveLen) return -1;
  const uint8_t *p = (const uint8_t *)(flashBase + bankOff[i]);
  uint32_t magic = 0, len = 0, k = 0, nk = 0;
  memcpy(&magic, p, 4); memcpy(&len, p + 4, 4);
  memcpy(&k, p + SAVE_HDR_KEY, 4); memcpy(&nk, p + SAVE_HDR_KEY + 4, 4);
  if (magic != SAVE_MAGIC) return -1;
  if (k == 0xFFFFFFFFu) return -2;                  // «безымянная» ячейка прежних версий
  if (keyOut) *keyOut = k;
  return (len == (uint32_t)saveLen && nk == ~k) ? 0 : -3;
}

static bool saveHasGame(uint32_t key) {             // есть ли загружаемый сейв этой игры
  if (!key || !saveLen || bankCount <= 0) return false;
  for (int i = 0; i < bankCount; i++) {
    uint32_t k = 0;
    if (saveCellKey(i, &k) == 0 && k == key) return true;
  }
  return false;
}

// Что будет, если привязать игру key: true — жертва занята ЧУЖИМ сейвом (надо спросить).
// Выбор жертвы — ровно тот же, что в saveBind (ранги по пустоте и давности).
static bool saveEvictPending(uint32_t key, int *victimOut, uint32_t *victimKeyOut) {
  if (!key || !saveLen || bankCount <= 0) return false;
  int victim = 0;
  uint32_t best = 0xFFFFFFFFu;
  for (int i = 0; i < bankCount; i++) {
    const uint8_t *p = (const uint8_t *)(flashBase + bankOff[i]);
    uint32_t magic = 0, len = 0, k = 0, nk = 0, seq = 0xFFFFFFFFu;
    memcpy(&magic, p, 4); memcpy(&len, p + 4, 4);
    memcpy(&k, p + SAVE_HDR_KEY, 4); memcpy(&nk, p + SAVE_HDR_KEY + 4, 4);
    memcpy(&seq, p + SAVE_HDR_SEQ, 4);
    bool legacy = false;
    if (k == 0xFFFFFFFFu) { k = 0; nk = 0xFFFFFFFFu; legacy = true; }
    if (magic == SAVE_MAGIC && len == (uint32_t)saveLen && k == key && nk == ~key) return false;
    uint32_t rank;
    if (magic != SAVE_MAGIC) rank = 0u;
    else if (legacy) rank = 0xFFFFFFFEu;
    else { if (seq > 0xFFFFFFFDu) seq = 0xFFFFFFFDu; rank = 1u + (0xFFFFFFFDu - seq); }
    if (rank < best) { best = rank; victim = i; }
  }
  const uint8_t *p = (const uint8_t *)(flashBase + bankOff[victim]);
  uint32_t magic = 0, k = 0;
  memcpy(&magic, p, 4); memcpy(&k, p + SAVE_HDR_KEY, 4);
  if (magic != SAVE_MAGIC) return false;            // жертва пустая — спрашивать не о чем
  if (victimOut) *victimOut = victim;
  if (victimKeyOut) *victimKeyOut = k;
  return true;
}

static void saveKillBank(int i) {                   // мгновенно убить ячейку: зануляем магию
  if (i < 0 || i >= bankCount || !saveLen) return;  // (программирование 1->0, стирание не нужно)
  uint8_t page[256];
  memcpy(page, (const void *)(flashBase + bankOff[i]), sizeof(page));
  page[0] = page[1] = page[2] = page[3] = 0;
  flash_range_program(bankOff[i], page, sizeof(page));
  Serial.print(F("сейвы: ячейка ")); Serial.print(i + 1);
  Serial.println(F(" стёрта (пользователь подтвердил вытеснение)"));
}

static void romNameByCrc(uint32_t crc, char *out, size_t outLen) {  // имя игры по ключу сейва
  for (int i = 0; i < romCount; i++)
    if (romList[i].crc == crc) { snprintf(out, outLen, "%s", romList[i].name); return; }
  snprintf(out, outLen, "OLD GAME");
}

static char ssSlotMark(int slot) {                  // ' ' пусто, '*' мой, 'X' чужой
  if (!ssReady || slot < 0 || slot >= SS_SLOTS || !ssOff[slot]) return ' ';
  uint32_t magic = 0, romH = 0;
  memcpy(&magic, (const void *)(flashBase + ssOff[slot]), 4);
  memcpy(&romH, (const void *)(flashBase + ssOff[slot] + 8), 4);
  if (magic != SS_MAGIC) return ' ';
  return (romH == romFingerprint()) ? '*' : 'X';
}

static bool ssSlotForeign(int slot, uint32_t *romHOut) {  // слот занят ЧУЖОЙ игрой?
  if (!ssReady || slot < 0 || slot >= SS_SLOTS || !ssOff[slot]) return false;
  uint32_t magic = 0, romH = 0;
  memcpy(&magic, (const void *)(flashBase + ssOff[slot]), 4);
  memcpy(&romH, (const void *)(flashBase + ssOff[slot] + 8), 4);
  if (magic != SS_MAGIC || romH == romFingerprint()) return false;
  if (romHOut) *romHOut = romH;
  return true;
}

// (подсветка backlight/setBacklight переехала выше, перед powerOff — v8.9u)

// ============================================================ ТИХАЯ ЗАПИСЬ ВО FLASH (v8.9q)
// Стирание сектора — ~50 мс. Если в этот момент работает ещё и всё остальное (ядро 100 %,
// панель, звук с усилителем), батарея уходит ниже порога внешней схемы контроля питания,
// и та сбрасывает чип по RUN. Именно так умирала консоль: в логе все смерти оборвались на
// строке «ящик: выгружаю во flash отметок …». Поэтому КАЖДУЮ запись делаем «тихо»:
// глушим звук с усилителем и гасим подсветку (главные потребители) на время стирания.
// Экран при этом на 0,1–0,6 с темнеет — это плата за то, что консоль не выключается.
static void quietFlashBegin(void) {
  if (gQuietBusy) return;                   // уже внутри тихой записи — не считаем дважды
  gQuietBusy = true; gQuietN++;
  soundSuspend();                           // звук — прочь
  gAmpOn = 0; gAmpSil = 0;                  // v9.4: и усилитель глушим явно (GP20 = HIGH)
  digitalWrite(PIN_AMP, HIGH);
  if (!gQuietNoLight) { analogWrite(PIN_BL, 0); digitalWrite(PIN_BL, LOW); delay(2); }
}
static void quietFlashEnd(void) {
  if (!gQuietBusy) return;
  gQuietBusy = false; gQuietBack++;
  if (!gQuietNoLight) analogWrite(PIN_BL, backlight);
  soundResume();
  ampApply();                               // v9.3: вернуть GP20 = LOW при включённом звуке
}

// ============================================================ быстрое меню (MENU)
enum { MI_LIGHT, MI_CONTRAST, MI_PALETTE, MI_INVERT,
       MI_SOUND, MI_VOLUME, MI_GAMES,
       MI_SAVE1, MI_LOAD1, MI_SAVE2, MI_LOAD2, MI_RESET, MI_PROBE, MI_RESUME, MI_COUNT };
#define MI_ROWH 14                     // 15 строк по 14 px влезают в экран 240

static int      menuSel = 0;
static char     menuMsg[26] = "";
static uint16_t menuPrev = 0xFFFF;
static int      menuConfirmSlot = -1;                               // v9.1: вопрос про чужой стейт
static uint32_t menuConfirmHash = 0;

static void drawMenu(void) {
  char row[28];
  uiClear(0);
  uiTextCentered(2, 2, "MENU", 3);
  battUiHeader(4);   // v8.9v: иконка + вольты справа
  for (int i = 0; i < MI_COUNT; i++) {
    const int y = 20 + i * MI_ROWH;
    switch (i) {
      case MI_LIGHT:    snprintf(row, sizeof(row), "LIGHT     %3d%%%s", (backlight * 100) / 255, (backlight < lightUser) ? " BAT" : ""); break;
      case MI_CONTRAST: snprintf(row, sizeof(row), "CONTRAST  %3d%%", contr); break;
      case MI_PALETTE:  snprintf(row, sizeof(row), "PALETTE   %s", PALS[palIdx].name); break;
      case MI_INVERT:   snprintf(row, sizeof(row), "INVERT    %s", invertShades ? "ON" : "OFF"); break;
      case MI_SOUND:    snprintf(row, sizeof(row), "SOUND     %s", soundOn ? "ON" : "OFF"); break;
      case MI_VOLUME:   snprintf(row, sizeof(row), "VOLUME    %3d%%", volPct); break;
      case MI_GAMES:    snprintf(row, sizeof(row), "GAMES     %d IN FLASH", romCount); break;
      case MI_SAVE1:    snprintf(row, sizeof(row), "SAVE TO SLOT 1 %c", ssSlotMark(0)); break;
      case MI_LOAD1:    snprintf(row, sizeof(row), "LOAD SLOT 1 %c", ssSlotMark(0)); break;
      case MI_SAVE2:    snprintf(row, sizeof(row), "SAVE TO SLOT 2 %c", ssSlotMark(1)); break;
      case MI_LOAD2:    snprintf(row, sizeof(row), "LOAD SLOT 2 %c", ssSlotMark(1)); break;
      case MI_RESET:    snprintf(row, sizeof(row), "RESET GAME"); break;
      case MI_PROBE:    snprintf(row, sizeof(row), "SOUND PROBE (6 TESTS)"); break;
      default:          snprintf(row, sizeof(row), "RESUME GAME"); break;
    }
    if (i == menuSel) uiRect(2, y - 2, MEM_W - 4, 13, 1);
    uiText(8, y, 2, row, 3);
  }
  uiTextCentered(232, 2, menuMsg[0] ? menuMsg : "A=OK  B=EXIT  UP/DN  L/R", 1);
  uiPush();
}

static void menuAdjust(int dir) {
  switch (menuSel) {
    case MI_LIGHT:    setBacklight((int)lightUser + dir * 25);   // v9.2: потолков нет — крутилка правит напрямую
                      break;
    case MI_CONTRAST: contr = (uint8_t)((dir > 0) ? (contr < 200 ? contr + 10 : 200) : (contr > 50 ? contr - 10 : 50));
                      rebuildPalette(); break;
    case MI_PALETTE:  palIdx = (uint8_t)((palIdx + (dir > 0 ? 1 : PAL_COUNT - 1)) % PAL_COUNT);
                      rebuildPalette(); break;
    case MI_INVERT:   invertShades = !invertShades; rebuildPalette(); break;
    case MI_SOUND:    soundSetOn(!soundOn); break;
    case MI_VOLUME:   {
                        // v9.7: мягкий лимит 10% (выше — мерцание подсветки от тока
                        // усилителя; громче в этой консоли не нужно), шаг 2
                        int v = (int)volPct + dir * 2;
                        if (v < 0) v = 0;
                        if (v > 10) v = 10;
                        volPct = (uint8_t)v;
                      } break;
    default: return;
  }
  drawMenu();
}

static void menuConfirmDraw(void) {                  // v9.1: вопрос «слот занят чужой игрой»
  char nm[17], line[26], full[25];
  romNameByCrc(menuConfirmHash, full, sizeof(full));
  snprintf(nm, sizeof(nm), "%s", full); nm[16] = 0;
  uiClear(0);
  snprintf(line, sizeof(line), "SLOT %d BUSY", menuConfirmSlot + 1);
  uiTextCentered(36, 2, line, 3);
  snprintf(line, sizeof(line), "'%s'", nm);
  uiTextCentered(66, 2, line, 3);
  uiTextCentered(96, 2, "IS SAVED HERE", 2);
  uiTextCentered(132, 2, "A=OVERWRITE", 3);
  uiTextCentered(158, 2, "B=BACK", 1);
  uiPush();
}

static void menuActivate(void) {
  switch (menuSel) {
    case MI_GAMES:
      romMenuOpen();
      return;
    case MI_SAVE1: case MI_SAVE2: {
      const int slot = (menuSel == MI_SAVE1) ? 0 : 1;
      uint32_t fh = 0;                                          // v9.1: чужой стейт затираем только с вопросом
      if (ssSlotForeign(slot, &fh)) { menuConfirmSlot = slot; menuConfirmHash = fh; menuConfirmDraw(); return; }
      snprintf(menuMsg, sizeof(menuMsg), ssSave(slot) ? "SAVED SLOT %d" : "SAVE FAILED", slot + 1);
      Serial.println(menuMsg);
      break; }
    case MI_LOAD1: case MI_LOAD2: {
      const int slot = (menuSel == MI_LOAD1) ? 0 : 1;
      snprintf(menuMsg, sizeof(menuMsg), ssLoad(slot) ? "LOADED SLOT %d" : "EMPTY SLOT %d", slot + 1);
      Serial.println(menuMsg);
      break; }
    case MI_RESET:
      saveStore(false);
      gb_reset(&gb); gb.direct.joypad = 0xFF;
      snprintf(menuMsg, sizeof(menuMsg), "RESET DONE");
      break;
    case MI_PROBE:
      toneStart();
      return;
    case MI_RESUME:
      ui = UI_GAME;
      return;
    default: return;
  }
  drawMenu();
}

static void menuOpen(void) {
  ui = UI_MENU; menuSel = 0; menuMsg[0] = 0; menuPrev = 0xFFFF;
  drawMenu();
  Serial.println(F("Меню: UP/DOWN — выбор, LEFT/RIGHT — значение, A — выполнить, B — выход."));
}

static void menuTick(uint16_t mask) {
  const uint16_t press = (uint16_t)(mask & ~menuPrev);
  menuPrev = mask;
  if (menuConfirmSlot >= 0) {                                  // v9.1: вопрос про чужой стейт
    if (press & (1u << 4)) {
      const int sl = menuConfirmSlot; menuConfirmSlot = -1;
      snprintf(menuMsg, sizeof(menuMsg), ssSave(sl) ? "SAVED SLOT %d" : "SAVE FAILED", sl + 1);
      Serial.println(menuMsg); drawMenu();
    } else if (press & ((1u << 5) | (1u << 8))) {
      menuConfirmSlot = -1; Serial.println(F("запись отменена: чужой стейт цел.")); drawMenu();
    }
    return;
  }
  if (press & (1u << 0)) { menuSel = (menuSel + MI_COUNT - 1) % MI_COUNT; menuMsg[0] = 0; drawMenu(); }
  if (press & (1u << 1)) { menuSel = (menuSel + 1) % MI_COUNT;          menuMsg[0] = 0; drawMenu(); }
  if (press & (1u << 2)) menuAdjust(-1);
  if (press & (1u << 3)) menuAdjust(+1);
  if (press & (1u << 4)) menuActivate();                       // A
  if (press & ((1u << 5) | (1u << 8))) { ui = UI_GAME; }        // B или MENU — выход
}

// ============================================================ ЗВУК: APU + ШИМ
// Из дампа стока: звук выводится ШИМ-ом на GPIO17 (слайс 0), TOP = 689 —
// это 690 уровней, «тишина» = 344. Кормится он прерыванием по PWM, а данные
// берёт из кольцевого буфера (400 семплов в ОЗУ). Мы делаем так же, только
// семплы считает APU Game Boy (apu_gb.h) по регистрам, которые отдаёт ядро.
//
// GP20: сток держит его в 1 при старте, но ПЕРЕД «писком» опускает в 0 —
// это разрешение усилителя (проба: LOW = звук, HIGH = тишина).
// v9.3: GP20 = LOW всё время, пока звук включён. Переключений по тишине больше
// нет (они щёлкали усилителем — «треск» — и мигали подсветкой); режим AMP из
// меню убран.
static void ampApply(void) {
  // v9.4: стартовое состояние — «звук идёт»; о тишине позаботится прерывание
  gAmpSil = 0;
  gAmpOn  = soundOn ? 1 : 0;
  digitalWrite(PIN_AMP, gAmpOn ? LOW : HIGH);
}

static void audioHwInit(void) {
  gpio_set_function(PIN_AUDIO, GPIO_FUNC_PWM);
  const uint slice = pwm_gpio_to_slice_num(PIN_AUDIO);
  pwm_config cfg = pwm_get_default_config();
  pwm_config_set_clkdiv(&cfg, 1.0f);
  pwm_config_set_wrap(&cfg, APU_PWM_TOP);
  pwm_init(slice, &cfg, true);
  pwm_set_gpio_level(PIN_AUDIO, APU_PWM_IDLE);
}

// прерывание таймера: 45 мкс = 22222 Гц — считаем один семпл и пишем в ШИМ.
// Считаем и его стоимость: 22 000 прерываний в секунду — это заметная доля
// процессора, и её полезно видеть в статистике (а не догадываться).
static uint32_t apuIrqUs = 0, apuIrqN = 0;

// v8.9p: ЧЕСТНАЯ СТАТИСТИКА. Раньше окно накопления начиналось в момент предыдущего
// доклада, и если между докладами консоль стояла в меню (или в списке игр) 30 секунд,
// то по строкам «звук-прерывание N шт/с», «ожидание DMA» и «fps» было видно не игру,
// а меню: например «fps=1 (1 %)» и «звук 152755 шт/с» сразу после запуска игры. Теперь
// окно сбрасывается, как только мы возвращаемся из меню/списка в игру.
static void statsClear(void) {
  statFrames = 0; statEmuUs = statAllUs = 0; statN = 0;
  statDrawUs = statDrawN = statSkipUs = statSkipN = statSpiWaitUs = 0;
  statCoreUs = statCoreN = 0;
  cbAccUs = cbCalls = 0; spiCallAcc = 0; spiCalls = 0; spiWaitAcc = 0; txRowAcc = 0;
  txDmaRows = 0; txDmaWaitAcc = 0;
  rowLoopAcc = rowLoopN = 0; txRowsOk = txRowsFail = 0;
  apuIrqUs = 0; apuIrqN = 0;
  statT0 = millis();
}

// v9.6: МЯГКИЙ ОГРАНИЧИТЕЛЬ ПИКОВ. Ток усилителя (и «дыхание» питания с мерцанием
// подсветки) пропорциональны РАЗМАХУ сигнала. Громче 120 уровней ШИМ сжимаем 3:1:
// тише становятся только пики, основная громкость музыки не трогается.
#define APU_LIM_K 120
static inline int32_t limSwing(int32_t sw) {
  if (sw >  APU_LIM_K) return APU_LIM_K + (sw - APU_LIM_K) / 3;
  if (sw < -APU_LIM_K) return -APU_LIM_K + (sw + APU_LIM_K) / 3;
  return sw;
}

static bool __attribute__((section(".time_critical.gbapu"))) apuIsr(repeating_timer_t *) {
  // Отметки прохождения прерывания (scratch[6]) — по ним в отчёте после зависания
  // видно, встал главный цикл или само прерывание звука, и на каком шаге.
  //   1 = вошли, 2 = перед синтезом семпла, 3 = синтез прошёл, пишем в ШИМ
  watchdog_hw->scratch[6] = 1;
  const uint32_t t = micros();
  int32_t lvl = APU_PWM_IDLE;
  if (soundOn && !soundPause) {
    watchdog_hw->scratch[6] = 2;
    if (gFade < 256) gFade++;                        // v9.3: плавный вход (анти-щелчок)
    // v9.3: цифровой «разделительный конденсатор» (apuDcBlock): смещение каналов
    // и ступеньки вкл/выкл не доходят до динамика, фейд гасит меню/паузу за ~12 мс.
    const int32_t s = (apuDcBlock(apuTick()) * gFade) >> 8;
    lvl = apuLevelVol(s, volNow(), 280);
  } else if (gFade) {
    watchdog_hw->scratch[6] = 2;
    gFade--;                                         // v9.3: затухание, а не обрыв на IDLE
    lvl = apuLevelVol((apuDcBlock(0) * gFade) >> 8, volNow(), 280);
    if (!gFade) { apuDcReset(); lvl = APU_PWM_IDLE; }
  }
  watchdog_hw->scratch[6] = 3;
  lvl = (uint16_t)(APU_PWM_IDLE + limSwing((int32_t)lvl - APU_PWM_IDLE));   // v9.6: пики под контролем
  pwm_set_gpio_level(PIN_AUDIO, lvl);
  // v9.4: усилитель — только на время звука (как в стоке): тишина 2 с подряд —
  // глушим (заодно гасим gFade, чтобы следующий звук вошёл мягко, без щелчка).
  if (soundOn) {
    if (lvl != APU_PWM_IDLE) {
      gAmpSil = 0;
      if (!gAmpOn) { gAmpOn = 1; digitalWrite(PIN_AMP, LOW); }
    } else if (gAmpOn && ++gAmpSil >= AMP_MUTE_TICKS) {
      gAmpOn = 0; gAmpSil = 0; gFade = 0;
      digitalWrite(PIN_AMP, HIGH);
    }
  }
  apuIrqUs += micros() - t;
  apuIrqN++;
  watchdog_hw->scratch[6] = 0;

  // ЛОВУШКА ПРОСАДКИ ПИТАНИЯ (v8.9h): каждый 8-й тик — один замер батареи.
  // Подробности в dipSample() ниже; здесь только расписание.
  if ((++gAdcTick & 7u) == 0u && !gAdcSweep) dipSample();

  // ДЕТЕКТОР ЗАЛИПАНИЯ (v8.8). Прерывание звука продолжает идти, даже если
  // главный цикл встал намертво. Значит по пропавшему «пульсу» цикла видно: это
  // НЕ сбой ядра, а вечное ожидание внутри кадра. Сообщаем и уходим.
  if (gBeatArm && !gStalled && (uint32_t)(micros() - gBeat) > STALL_US) {
    gStalled = true;
    // ВАЖНО: печатать из прерывания БЕСПОЛЕЗНО (по той же причине, что и из
    // обработчика сбоя: пока мы в прерывании, USB не выгружается). Поэтому:
    // подробности — в чёрный ящик, а печать — в обычном потоке: зажигаем сбой,
    // штатный обработчик вернёт управление в faultAftermath(), и он всё расскажет.
    gDieA = (uint32_t)spi_get_hw(spi0)->sr;
    gDieB = (uint32_t)gb.cpu_reg.pc.reg;
    gDieC = (uint32_t)frameLineCore;
    gDieD = (uint32_t)millis();
    mark(PH_STALL);
#ifndef GBEMU_HOST
    if (blkOn) blkWrite();
    faultTriggerNow();
#else
    dieReport(PH_STALL, gDieA, gDieB, gDieC, gDieD);
#endif
  }
  return true;
}

// v8.9p: МЯГКИЙ СТАРТ ЗВУКА. Сразу после смены игры громкость входит не скачком, а
// за 2 с. Усилитель (GP20) при этом включается постепенно — шаг нагрузки вверх меньше.
static uint32_t volRampMs = 0, volRampT0 = 0;
#define VOL_RAMP_MS 2000

// Громкость прямо сейчас (с учётом мягкого входа). Вызывается из прерывания звука,
// поэтому только арифметика: ни millis-циклов, ни печати.
static uint8_t volNow(void) {
  if (!volRampMs) return volPct;
  const uint32_t dt = (uint32_t)(millis() - volRampT0);
  if (dt >= volRampMs) { volRampMs = 0; return volPct; }
  return (uint8_t)((uint32_t)volPct * dt / volRampMs);
}

// Намеренный сбой: пишем в несуществующую периферию. Нужен только для того,
// чтобы «вынырнуть» из прерывания в обычный поток (см. доклад о залипании).
static void faultTriggerNow(void) {
#ifndef GBEMU_HOST
  __asm volatile ("dsb sy" ::: "memory");
  *(volatile uint32_t *)0x50000000u = 1u;         // 0x5000_0000 — пусто на RP2040
#endif
}

static void soundResume(void) {
  if (!soundOn || apuTimerOn) return;
  apuTimerOn = add_repeating_timer_us(-(int64_t)apuTmrUs, apuIsr, NULL, &apuTmr);
}

// Сменить период семпла (перезапускает таймер, если он идёт).
static void soundSetPeriod(uint16_t us) {
  if (us < 45) us = 45;                        // 45 мкс = 22222 Гц (норма для DMG)
  if (us > 130) us = 130;                      // медленнее 7.7 кГц не нужно
  if (us == apuTmrUs) return;
  apuTmrUs = us;
  if (apuTimerOn) { cancel_repeating_timer(&apuTmr); apuTimerOn = false; }
  soundResume();
}

static void soundSuspend(void) {
  if (apuTimerOn) { cancel_repeating_timer(&apuTmr); apuTimerOn = false; }
  pwm_set_gpio_level(PIN_AUDIO, APU_PWM_IDLE);
  apuDcReset();                              // v9.3: фильтр/фейд — в ноль (возврат без щелчка)
  gFade = 0;
}

// Раз в секунду подстраиваем темп звука под реальную скорость эмуляции.
static void soundSyncTick(void) {
  if (statFps) syncEmaFps = (syncEmaFps * 3 + statFps) / 4;    // сглаживание, чтобы не «плыло»
  if (soundSync) soundSetPeriod((uint16_t)((45UL * 60UL + syncEmaFps / 2) / syncEmaFps));
  else           soundSetPeriod(45);
}

static void soundSetOn(uint8_t on) {
  soundOn = on ? 1 : 0;
  if (soundOn) { audioHwInit(); soundResume(); }
  else soundSuspend();
  ampApply();
}

static void soundInit(void) {
#ifndef GBEMU_HOST
  gStackTop = readMsp() & ~3u;                  // верх стека — по нему считаем глубину
#endif
  pinMode(PIN_AMP, OUTPUT);
  irq_set_priority(TIMER_IRQ_0, 0x40);       // v9.3: прерывание таймера звука выше USB — меньше джиттер
  audioHwInit();
  apuReset();
  ampApply();
  soundResume();
  Serial.print(F("звук: ")); Serial.print(soundOn ? F("вкл") : F("выкл"));
  Serial.print(F(", громкость ")); Serial.print(volPct);
  Serial.print(F("%, усилитель: GP20 = LOW на время звука (v9.4: 2 с тишины — глушим)"));
  Serial.println();
}

// когда открыто меню/пауза — молчим, иначе залипнет последняя нота
static void soundUpdatePause(void) {
  soundPause = (ui != UI_GAME || paused) ? 1 : 0;
}

// ============================================================ ПРОБА ЗВУКА (ручная)
// Шесть опытов, которые нужно слушать. Переключение — только вручную:
//   короткое нажатие MENU — следующий опыт,
//   удержание MENU >= 0,8 с — повторить текущий,
//   любая клавиша в Serial — выйти из пробы.
// Перед каждым опытом подсветка мигает N+1 раз (N — номер опыта), как вы просили.
// Сам сигнал длится 3 с и генерируется «плотно» (микросекундные задержки), иначе
// на 1,25 кГц и 4 кГц частота бы «плыла» из-за медленного loop().
#define PROBE_N 6
// 0 = меандр 1,25 кГц (ровно как стоковый «писк»), 1 = ШИМ 440 Гц (качели 60..630),
// 2 = меандр 4 кГц (для пьезо-пищалки), 3 = развёртка 300 Гц..3 кГц
static const uint8_t PROBE_KIND[PROBE_N] = { 0, 0, 1, 1, 2, 3 };
static const uint8_t PROBE_AMP[PROBE_N]  = { HIGH, LOW, HIGH, LOW, HIGH, LOW };

static int      probeIdx = 0;
static uint8_t  probePhase = 0;         // 0 мигаем, 1 играем, 2 ждём MENU, 3 выход
static int      probeBlink = 0;
static uint32_t probeT0 = 0;
static bool     probeMenuDown = false;
static uint32_t probeMenuT0 = 0;


static const char *probeName(int i) {
  switch (PROBE_KIND[i]) {
    case 0: return "SQUARE";
    case 1: return "PWM 290k";
    case 2: return "SQUARE 4k";
    default: return "SWEEP";
  }
}
static const char *probeDesc(int i) {
  switch (PROBE_KIND[i]) {
    case 0: return "1.25 kHz, raw GPIO";
    case 1: return "440 Hz on 290 kHz";
    case 2: return "4 kHz, raw GPIO";
    default: return "300 Hz -> 3 kHz";
  }
}

static void probeSignalStop(void) {
  if (PROBE_KIND[probeIdx] == 1) pwm_set_gpio_level(PIN_AUDIO, APU_PWM_IDLE);
  else { digitalWrite(PIN_AUDIO, LOW); pinMode(PIN_AUDIO, INPUT); }
  digitalWrite(PIN_AMP, HIGH);
}

static void probeSignalStart(void) {
  digitalWrite(PIN_AMP, PROBE_AMP[probeIdx]);
  if (PROBE_KIND[probeIdx] == 1) {
    audioHwInit();                       // ШИМ как в стоке: TOP = 689
  } else {
    pinMode(PIN_AUDIO, OUTPUT);
    digitalWrite(PIN_AUDIO, LOW);
  }
}

// Три секунды сигнала: блокируем loop(), но слушаем Serial (любая клавиша — стоп).
static void probePlaySignal(void) {
  mark(PH_PROBE);
  const uint32_t t0 = millis();
  const uint8_t  kind = PROBE_KIND[probeIdx];
  uint32_t edge = micros();
  uint8_t  high = 0;
  while ((millis() - t0) < 3000) {
    wdtFeed();
    if (Serial.available()) { probePhase = 3; return; }
    uint32_t half;
    if (kind == 0)      half = 400;                       // 1,25 кГц
    else if (kind == 1) half = 1136;                      // 440 Гц
    else if (kind == 2) half = 125;                       // 4 кГц
    else {                                                // развёртка 300..3000 Гц
      const uint32_t f = 300 + (millis() - t0) * 900;
      half = 500000UL / f;
    }
    while ((int32_t)(micros() - edge) < (int32_t)half) { }
    edge += half;
    high ^= 1;
    if (kind == 1) pwm_set_gpio_level(PIN_AUDIO, high ? 630 : 60);
    else           digitalWrite(PIN_AUDIO, high ? HIGH : LOW);
  }
}

static void drawTone(void) {
  char b[34];
  uiClear(0);
  uiTextCentered(10, 3, "SOUND PROBE", 3);
  snprintf(b, sizeof(b), "%d / %d", probeIdx + 1, PROBE_N);
  uiTextCentered(50, 3, b, 3);
  uiTextCentered(84, 3, probeName(probeIdx), 3);
  uiTextCentered(118, 2, probeDesc(probeIdx), 2);
  snprintf(b, sizeof(b), "AMP: GP20 = %s", PROBE_AMP[probeIdx] ? "HIGH" : "LOW");
  uiTextCentered(146, 2, b, 2);
  uiTextCentered(174, 2, probePhase == 0 ? "BLINKS = TEST NUMBER" : "LISTEN 3 SECONDS", 1);
  uiTextCentered(190, 2, "SHORT MENU = NEXT TEST", 1);
  uiTextCentered(202, 2, "HOLD MENU  = REPEAT", 1);
  uiTextCentered(214, 2, "A / B = EXIT (NO RESET NEEDED)", 1);
  uiPush();
}

static void probeBegin(int idx) {
  probeIdx = ((idx % PROBE_N) + PROBE_N) % PROBE_N;
  probePhase = 0; probeBlink = 0; probeT0 = millis(); probeMenuDown = false;
  probeLastMs = probeT0;
  Serial.print(F("=== опыт ")); Serial.print(probeIdx + 1); Serial.print(F("/")); Serial.print(PROBE_N);
  Serial.print(F(": ")); Serial.print(probeName(probeIdx)); Serial.print(F(", "));
  Serial.print(probeDesc(probeIdx)); Serial.print(F(", GP20="));
  Serial.print(PROBE_AMP[probeIdx] ? F("HIGH") : F("LOW"));
  Serial.print(F(" (миганий: ")); Serial.print(probeIdx + 2); Serial.println(F(")"));
  drawTone();
}

static uint8_t toneBlSaved = 255;       // v8.9u: подсветка до пробы (после — вернём её)
static void toneStart(void) {
  soundSuspend();                       // ШИМ звука игры выключаем — пин свободен
  toneBlSaved = backlight;              // мигаем родной яркостью, а не насильными 200
  probeBegin(0);
  ui = UI_TONE;
  Serial.println(F("Слушайте динамик. Перед опытом подсветка мигает N+1 раз (N — номер опыта)."));
  Serial.println(F("выход в любой момент: кнопка A или B, любая клавиша здесь, либо 20 с тишины."));
  Serial.println(F("ресет для выхода не нужен — проба конечная и закрывается сама."));
}

static void toneStop(void) {
  probeSignalStop();
  lightRaw(toneBlSaved);   // v8.9y: вернуть как было (крутилку не трогаем)
  audioHwInit();
  soundSetOn(soundOn);                  // вернуть звук эмулятора
  ui = emuInited ? UI_GAME : UI_NOROM;
  if (!emuInited) drawNoRom();
  Serial.println(F("Проба звука остановлена."));
}

static void toneTick(uint16_t mask) {
  const uint32_t now = millis();

  if (probePhase == 3) { toneStop(); return; }

  // v8.9t: ВЫЙТИ ИЗ ПРОБЫ МОЖНО ВСЕГДА — кнопкой A или B. Раньше выход был только по
  // клавише в терминале, и случайно нажавший z искал зубочистку для ресета.
  if (mask & ((1u << 4) | (1u << 5))) {              // A или B
    Serial.println(F("выход из пробы по кнопке — ресет не нужен."));
    toneStop(); return;
  }
  // и сама кончается, если её оставили без внимания
  if (probeLastMs && (uint32_t)(now - probeLastMs) > 20000UL) {
    Serial.println(F("проба звука: 20 с без действий — выхожу сама (ресет не нужен)."));
    toneStop(); return;
  }
  if (mask) probeLastMs = now;                       // любое нажатие — это «занят»

  if (probePhase == 0) {                               // подсветка мигает N+1 раз
    const int total = (probeIdx + 2) * 2;              // N+1 миганий = 2*(N+1) переключений
    if (probeBlink < total) {
      lightRaw(((now - probeT0) < 140) ? toneBlSaved : 0);   // v8.9y: мимо потолков
      if ((now - probeT0) >= 280) { probeT0 = now; probeBlink++; }
      return;
    }
    lightRaw(toneBlSaved);
    probeSignalStart();
    drawTone();
    Serial.println(F("  сигнал пошёл (3 с)..."));
    probePlaySignal();                                 // блокирующие 3 с
    if (probePhase == 3) { toneStop(); return; }
    probeSignalStop();
    probePhase = 2;
    Serial.println(F("  тишина. MENU: коротко — дальше, удержать — повторить."));
    drawTone();
    return;
  }

  // probePhase == 2: ждём MENU (коротко — дальше, удержание — повтор)
  const bool down = (mask & (1u << 8)) != 0;
  if (down && !probeMenuDown) { probeMenuDown = true; probeMenuT0 = now; }
  else if (!down && probeMenuDown) {
    probeMenuDown = false;
    probeBegin((now - probeMenuT0 >= 800) ? probeIdx : probeIdx + 1);
  } else if (down && probeMenuDown && (now - probeMenuT0) >= 800) {
    probeBegin(probeIdx);                              // удержание = повтор
  }
}

// карта flash — чтобы видеть, сколько осталось под другие игры
static void printFlashMap(void) {
  const uintptr_t end = (flashEnd + 4095u) & ~(uintptr_t)4095u;
  const uint32_t usedEnd = ssReady ? (ssOff[SS_SLOTS - 1] + (uint32_t)ssLen)
                                   : (uint32_t)(end - flashBase) + (uint32_t)saveLen;
  const uint32_t freeB = (usedEnd < FLASH_LIMIT) ? (FLASH_LIMIT - usedEnd) : 0;
  Serial.println(F("--- карта flash (2 МБ) ---"));
  Serial.print(F("  прошивка (скетч+ядро): ")); Serial.print((uint32_t)(end - flashBase) / 1024); Serial.println(F(" КиБ"));
  if (romCount) {
    Serial.print(F("  картриджи (список):    ")); Serial.print(romKib / 1024); Serial.print(F(" КиБ в "));
    Serial.print(romCount); Serial.print(F(" играх, занимают 0x")); Serial.print((uint32_t)ROMS_TABLE_OFF, HEX); Serial.print(F("..0x"));
    Serial.print((uint32_t)(ROMS_DATA_OFF + (uint32_t)romKib * 1024u), HEX); Serial.println();
    Serial.print(F("  свободно в области:    ")); Serial.print((FLASH_LIMIT - ROMS_DATA_OFF - (uint32_t)romKib * 1024u) / 1024);
    Serial.println(F(" КиБ (добавить игры: пересобрать games.uf2)"));
  } else {
    Serial.print(F("  встроенная игра:       ")); Serial.print(ROM_SIZE / 1024); Serial.println(F(" КиБ (rom.h)"));
  }
  Serial.print(F("  сейвы SRAM:           ")); Serial.print(bankCount * saveLen / 1024);
  Serial.print(F(" КиБ (")); Serial.print(bankCount); Serial.println(F(" ячейки по игре)"));
  Serial.print(F("  сейвстейты:           ")); Serial.print(SS_SLOTS * ssLen / 1024); Serial.println(F(" КиБ"));
  Serial.print(F("  СВОБОДНО (под игры):   ")); Serial.print(freeB / 1024); Serial.println(F(" КиБ"));
  Serial.print(F("  размер сейвстейта:    ")); Serial.print((256 + sizeof(struct gb_s) + sizeof(cartRam)) / 1024);
  Serial.print(F(" КиБ (gb_s ")); Serial.print(sizeof(struct gb_s)); Serial.println(F(" Б + SRAM 32 КиБ)"));
}

static void printSlotState(void) {
  for (int i = 0; i < SS_SLOTS; i++) {
    const uint8_t *p = (const uint8_t *)(flashBase + ssOff[i]);
    uint32_t magic = 0, romH = 0;
    memcpy(&magic, p, 4); memcpy(&romH, p + 8, 4);
    Serial.print(F("  слот ")); Serial.print(i + 1); Serial.print(F(": "));
    if (magic == SS_MAGIC && romH == romFingerprint()) Serial.println(F("сейв этой игры"));
    else if (magic == SS_MAGIC) Serial.println(F("сейв другой игры (не загрузится)"));
    else Serial.println(F("пусто"));
  }
}

// ============================================================ СПИСОК ИГР: разбор таблицы
// Таблицу кладёт упаковщик. Здесь только ЧИТАЕМ: список игр на износ flash не
// влияет вообще (единственная запись — 4 КиБ «какая игра» в своём секторе, и та
// только при смене игры).
static void romScan(void) {
  romCount = 0; romKib = 0; romSramMax = 0; romCur = -1;
  romMenuSel = 0; romMenuTop = 0;
  romBase = ROM_DATA; romSize = ROM_SIZE; romMask = ROM_MASK; romSaveKey = 0;
  const uint8_t *t = (const uint8_t *)(flashBase + ROMS_TABLE_OFF);
  uint32_t magic = 0, count = 0, used = 0;
  memcpy(&magic, t, 4); memcpy(&count, t + 4, 4); memcpy(&used, t + 8, 4);
  if (magic != ROMS_MAGIC || count == 0 || count > ROM_MAX) {
    Serial.println(F("Картриджи: списка игр во flash нет."));
    if (ROM_SIZE >= 0x150) Serial.println(F("   Играю во встроенную игру (rom.h)."));
    else Serial.println(F("   Собрать список: python make_roms_uf2.py game1.gb game2.gb ..."));
    return;
  }
  for (uint32_t i = 0; i < count; i++) {
    RomEntry e;
    memcpy(&e, t + 16 + i * sizeof(RomEntry), sizeof(e));
    e.name[ROM_NAME_LEN - 1] = 0;
    // «Живой» считаем только запись, чей образ реально лежит в области картриджей:
    // нельзя выйти за границы и нельзя принять за игру чужой сектор.
    if (e.size < 0x8000 || (e.size & (e.size - 1)) != 0) continue;      // размер — степень двойки >= 32 КиБ
    if (e.off < ROMS_DATA_OFF || e.off + e.size > FLASH_LIMIT) continue;
    const uint8_t *r = (const uint8_t *)(flashBase + e.off);
    // Признак настоящей игры: логотип Nintendo в заголовке ИЛИ верная сумма заголовка.
    // (Хватает одного: у самодельных сборок логотип иногда вырезан, а сумма верна,
    // и наоборот — у пропатченных она не сходится, а логотип на месте.)
    const bool logoOk = (r[0x104] == 0xCE && r[0x105] == 0xED);
    // Контрольная сумма заголовка — как её считает сама Game Boy: из 0 вычитаем
    // байты 0x134..0x14C с переносом, результат должен совпасть с байтом 0x14D.
    uint8_t csum = 0;
    for (uint32_t k = 0x134; k <= 0x14C; k++) csum = (uint8_t)(csum - r[k] - 1);
    const bool sumOk = (csum == r[0x14D]);
    if (!logoOk && !sumOk) continue;
    if (romCount >= ROM_MAX) break;
    romList[romCount] = e;
    romKib += (e.size + 4095u) / 4096u * 4u;
    if (e.sram > romSramMax) romSramMax = e.sram;
    romCount++;
  }
  if (romCount == 0) {
    Serial.println(F("Картриджи: таблица есть, но ни один образ не на месте."));
    return;
  }
  Serial.print(F("Картриджи: "));
  Serial.print(romCount); Serial.print(F(" игр, ")); Serial.print(romKib); Serial.print(F(" КиБ"));
  Serial.print(romKib); Serial.print(F(" КиБ"));
  // (v8.9p) в таблице лежит УЖЕ готовое число КиБ; раньше мы делили его ещё раз и в
  // логе появлялось «960 КиБ (в таблице 0 КиБ)».
  Serial.println(F(":"));
  for (int i = 0; i < romCount; i++) {
    Serial.print(F("   ")); if (i + 1 < 10) Serial.print(' ');
    Serial.print(i + 1); Serial.print(F(") ")); Serial.print(romList[i].name);
    Serial.print(F("  ")); Serial.print(romList[i].size / 1024); Serial.print(F(" КиБ"));
    if (romList[i].sram) { Serial.print(F(", сейв ")); Serial.print(romList[i].sram / 1024); Serial.print(F(" КиБ")); }
    Serial.println();
  }
}

static bool romStateLoad(int *out) {
  const uint8_t *p = (const uint8_t *)(flashBase + ROMS_STATE_OFF);
  uint32_t magic = 0, idx = 0, len = 0;
  memcpy(&magic, p, 4); memcpy(&idx, p + 4, 4); memcpy(&len, p + 8, 4);
  if (magic != ROMS_STATE_MAGIC || len != 3u * sizeof(uint32_t) || idx >= (uint32_t)ROM_MAX) return false;
  *out = (int)idx;
  return true;
}

// «Какая игра выбрана» — отдельный сектор. Пишем ТОЛЬКО если выбор изменился:
// сперва читаем содержимое и, если там уже нужное, flash не трогаем вовсе.
// v8.9q: сектор «какая игра» пишем ТОЛЬКО в списке игр — в момент выбора, пока эмулятор
// ещё НЕ запущен (экран списка статичен, панель не молотит кадры, звук молчит). В самой
// игре flash не трогаем ВООБЩЕ: стирание сектора в игре = сброс по RUN (см. лог v8.9p,
// где все пять смертей пришлись ровно на выгрузку ящика). Если питание в момент выбора
// просевшее — запись откладываем до выключения.
static int romStatePending = -1;               // выбор, который надо записать при выключении

static void romStateWriteNow(int idx) {
  uint8_t pg[256];
  memset(pg, 0xFF, sizeof(pg));
  const uint32_t magic = ROMS_STATE_MAGIC, i = (uint32_t)idx, len = 3u * sizeof(uint32_t);
  memcpy(pg, &magic, 4); memcpy(pg + 4, &i, 4); memcpy(pg + 8, &len, 4);
  quietFlashBegin();                             // v8.9q: тихая запись
  noInterrupts();
  flash_range_erase(ROMS_STATE_OFF, 4096u);
  flash_range_program(ROMS_STATE_OFF, pg, 256);
  interrupts();
  quietFlashEnd();
}

static void romStateSave(int idx) {
  if (idx < 0) return;
  int cur = -1;
  if (romStateLoad(&cur) && cur == idx) return;  // уже записано — flash не трогаем
  if (!battGuardOk()) {                          // питание просевшее — не рискуем
    romStatePending = idx; gGuardDefers++;
    Serial.println(F("«какая игра»: питание просевшее — запишу при выключении (в игре flash не трогаю)"));
    return;
  }
  romStateWriteNow(idx);
  romStatePending = -1;
  Serial.print(F("какая игра выбрана — записано ("));
  Serial.print(idx + 1); Serial.println(F(")"));
}

// При выключении: дописать выбор, который ждал лучшего питания (экран там уже погашен).
static void romStateFlushAtExit(void) {
  if (romStatePending < 0) return;               // ждать нечего
  const int idx = romStatePending;
  romStatePending = -1;
  Serial.print(F("«какая игра»: дописываю выбор (")); Serial.print(idx + 1); Serial.println(F(")"));
  romStateWriteNow(idx);
}

// ============================================================ СПИСОК ИГР: экран
static void romMenuOpen(void) {
  ui = UI_ROMS;
  romMenuPrev = 0xFFFF;
  romMenuMsg[0] = 0;
  romMenuSel = (romCur >= 0 && romCur < romCount) ? romCur : 0;
  romMenuTop = 0;
  romMenuDraw();
  Serial.println(F("СПИСОК ИГР: UP/DOWN — выбор, A — играть, B — назад."));
}

static void romMenuDraw(void) {
  char line[40];
  uiClear(0);
  if (romCount <= 0) {
    uiTextCentered(60,  4, "GAMES", 3);
    uiTextCentered(120, 3, "NO GAMES IN FLASH", 2);
    uiTextCentered(150, 3, "RUN MAKE_ROMS_UF2.PY", 2);
    uiTextCentered(180, 3, "B - BACK", 1);
    uiPush();
    return;
  }
  snprintf(line, sizeof(line), "GAMES  %d", romCount);
  uiText(8, 4, 2, line, 2);
  battUiHeader(4);   // v8.9v: иконка + вольты справа
  // 11 строк по 17 px: 22..210 помещаются над подсказкой
  if (romMenuSel < romMenuTop) romMenuTop = romMenuSel;
  if (romMenuSel >= romMenuTop + 11) romMenuTop = romMenuSel - 10;
  if (romMenuTop > romCount - 1) romMenuTop = romCount - 1;
  if (romMenuTop < 0) romMenuTop = 0;
  for (int i = 0; i < 11; i++) {
    const int idx = romMenuTop + i;
    if (idx >= romCount) break;
    const int y = 24 + i * 17;
    if (idx == romMenuSel) uiRect(2, y - 2, MEM_W - 4, 13, 1);
    char nm[25];
    snprintf(nm, sizeof(nm), "%s", romList[idx].name);
    nm[16] = 0;                                   // 16 знаков при масштабе 2 — 128 px
    snprintf(line, sizeof(line), "%c%2d %s S%2u",
             (idx == romCur) ? '*' : ' ', idx + 1, nm, (unsigned)(romList[idx].size / 512 / 1024));
    uiText(6, y, 2, line, 3);
    if (romList[idx].sram) {                                    // v9.1: квадратик ярче и шире, если сейв уже лежит
      if (saveHasGame(romList[idx].crc)) uiRect(MEM_W - 14, y + 3, 10, 4, 3);
      else uiRect(MEM_W - 8, y + 3, 4, 4, 2);
    }
  }
  snprintf(line, sizeof(line), "%sUP/DN A=PLAY B=BACK", romMenuMsg);
  uiTextCentered(228, 1, line, 1);
  uiPush();
}

static void saveConfirmDraw(void) {                  // v9.1: вопрос «чей сейв пострадает»
  char nm[17], line[26], full[25];
  romNameByCrc(saveConfirmKey, full, sizeof(full));
  snprintf(nm, sizeof(nm), "%s", full); nm[16] = 0;
  uiClear(0);
  uiTextCentered(36, 2, "SAVE CONFLICT", 3);
  uiTextCentered(66, 2, "SAVE OF", 2);
  snprintf(line, sizeof(line), "'%s'", nm);
  uiTextCentered(92, 2, line, 3);
  uiTextCentered(122, 2, "WILL BE REPLACED", 2);
  uiTextCentered(158, 2, "A=REPLACE+PLAY", 3);
  uiTextCentered(184, 2, "B=BACK", 1);
  uiPush();
}

static void romMenuLaunch(int idx) {
  Serial.print(F("Запускаю: ")); Serial.println(romList[idx].name);
  if (romStart(idx, true)) {
    ui = UI_GAME;
    for (int i = 0; i < 6; i++) { delay(60); wdtFeed(); }    // заставка успела показаться
  } else {
    snprintf(romMenuMsg, sizeof(romMenuMsg), "LAUNCH FAILED ");
    romMenuDraw();
  }
}

static void romMenuActivate(void) {
  if (romMenuSel < 0 || romMenuSel >= romCount) return;
  if (romMenuSel == romCur && emuInited) { ui = UI_GAME; Serial.println(F("Эта игра уже идёт.")); return; }
  const int idx = romMenuSel;                                  // v9.1: вытеснение чужого сейва — только с вопросом
  if (romList[idx].sram && saveLen && bankCount > 0) {
    int vv = -1; uint32_t vk = 0;
    if (saveEvictPending(romList[idx].crc, &vv, &vk) && vk != romList[idx].crc) {
      saveConfirmGame = idx; saveConfirmVictim = vv; saveConfirmKey = vk;
      saveConfirmDraw(); return;
    }
  }
  romMenuLaunch(idx);
}

static void romMenuTick(uint16_t mask) {
  const uint16_t press = (uint16_t)(mask & ~romMenuPrev);
  romMenuPrev = mask;
  if (saveConfirmGame >= 0) {                              // v9.1: вопрос про вытеснение сейва
    if (press & (1u << 4)) {
      const int gi = saveConfirmGame, vi = saveConfirmVictim;
      saveConfirmGame = -1; saveConfirmVictim = -1;
      saveKillBank(vi);
      romMenuSel = gi; romMenuLaunch(gi);
    } else if (press & ((1u << 5) | (1u << 8))) {
      saveConfirmGame = -1; saveConfirmVictim = -1;        // B/MENU — назад в список
      Serial.println(F("запуск отменён: чужой сейв цел."));
      romMenuDraw();
    }
    return;
  }
  if (romCount <= 0) {                            // игр нет: список бесполезен
    if (mask) { ui = emuInited ? UI_GAME : UI_NOROM; if (!emuInited) drawNoRom(); }
    return;
  }
  if (press & (1u << 0)) { romMenuSel = (romMenuSel + romCount - 1) % romCount; romMenuMsg[0] = 0; romMenuDraw(); }
  if (press & (1u << 1)) { romMenuSel = (romMenuSel + 1) % romCount;          romMenuMsg[0] = 0; romMenuDraw(); }
  if (press & (1u << 4)) { romMenuActivate(); return; }                       // A — запустить
  if (press & (1u << 5)) { if (romCur < 0) romMenuDraw(); else { ui = emuInited ? UI_GAME : UI_NOROM; if (!emuInited) drawNoRom(); } }   // B — назад (v9.1: без запущенной игры остаёмся в списке)
}

// ============================================================ СПИСОК ИГР: запуск
// Возвращает false, если запустить не удалось (тогда состояние прежней игры
// восстановить нельзя — честно скажем об этом в логе).
static bool romStart(int idx, bool splash) {
  const bool running = emuInited;
  if (settingsDirty()) settingsStore();   // v9.7.2: настройки переживут и reset/пропадание питания
  if (idx >= 0) {
    if (idx >= romCount) return false;
    romBase = (const uint8_t *)(flashBase + romList[idx].off);
    romSize = romList[idx].size;
    romMask = romList[idx].size - 1;
    romSaveKey = romList[idx].crc;
  } else {
    romBase = ROM_DATA; romSize = ROM_SIZE; romMask = ROM_MASK; romSaveKey = 0;
  }
  if (running) soundSuspend();                    // во время работы ядра шину не трогаем
  const uint32_t t0 = millis();
  memset(cartRam, 0, sizeof(cartRam));            // чужую память сохранений не тянем
  cartDirty = false; saveHash = 0; romSaved = false;

  enum gb_init_error_e e = gb_init(&gb, cb_rom_read, cb_cart_read, cb_cart_write, cb_error, NULL);
  if (e != GB_INIT_NO_ERROR) {
    Serial.print(F("!! gb_init ошибка: ")); Serial.println((int)e);
    romBase = ROM_DATA; romSize = ROM_SIZE; romMask = ROM_MASK; romSaveKey = 0;
    if (running) soundResume();
    return false;
  }
  // v8.9p: МЯГКИЙ СТАРТ. Смена игры — самый тяжёлый момент для питания: ядро уходит в
  // 100 %, панель начинает качать кадры, включается звук с усилителем. Разводим это:
  // сначала 0,4 с эмуляции без панели, а громкость входит за 2 с.
  panelHoldUntil = millis() + PANEL_HOLD_MS;
  if (running) { volRampT0 = millis(); volRampMs = VOL_RAMP_MS; }
  gSagT0 = millis(); gSagMin = 4095; gSagMax = 0; gSagDone = false;

  gb.direct.joypad = 0xFF;
  gb.direct.frame_skip = true;                    // 30 кадр/с на панель, логика 60 Гц
  gb.display.lcd_draw_line = cb_lcd_line;
  gb_colour_hash(&gb);
  memset(romTitle, 0, sizeof(romTitle));
  gb_get_rom_name(&gb, romTitle);

  // Сейвы: размер ячейки — по самой «жадной» игре списка (раскладка не должна
  // меняться от того, что запущено), ячеек — по числу игр (но не больше SAVE_BANKS).
  size_t saveSize = 0;
  if (gb_get_save_size_s(&gb, &saveSize) != 0) saveSize = 0;
  const size_t ownSaveSize = saveSize;            // память сохранений именно этой игры
  if (romSramMax > saveSize) saveSize = romSramMax;
  const bool gameSaves = (ownSaveSize > 0);       // есть ли память сохранений у ЭТОЙ игры
  saveActive = false;
  if (romCount == 0) {
    if (!gameSaves) {
      saveLen = 0; bankCount = 0;
      Serial.println(F("У этой игры нет памяти сохранений — автосейв выключен (писать нечего)."));
    } else {
      saveInit(saveSize, 1);
      saveActive = (saveLen > 0);
      saveBind(0);
      romSaved = saveActive && saveLoad();
    }
  } else {
    // Раскладка ячеек одна на весь список (по самой «жадной» игре), поэтому она не
    // зависит от того, что запущено. Ячейка игры без памяти сохранений тоже метится
    // её ключом, но писать в неё нечего — saveActive не даст.
    saveInit(saveSize, romCount);
    saveActive = (saveLen > 0 && gameSaves);
    saveBind(romSaveKey);
    romSaved = saveActive && saveLoad();
    if (!gameSaves) Serial.println(F("У этой игры нет памяти сохранений — автосейв выключен (писать нечего)."));
  }
  ssInit();                                       // сейвстейты: раскладка могла измениться
  if (idx >= 0) { romCur = idx; romStateSave(idx); }
  if (running) soundResume();

  Serial.print(romCur >= 0 ? F("ИГРА: ") : F("ROM: ")); Serial.print(romTitle);
  Serial.print(F("  ")); Serial.print(romSize / 1024); Serial.print(F(" КиБ"));
  Serial.print(F("  MBC=")); Serial.print((int)gb.mbc);
  Serial.print(F("  ")); Serial.print(millis() - t0); Serial.print(F(" мс"));
  Serial.println(romSaved ? F("  сейв восстановлен") : F("  сейва нет"));
  // v8.9p: понятная строка про сохранения (раньше «SRAM=8192 Б» и рядом «нет памяти
  // сохранений» сбивали с толку: первое — размер картриджа, второе — есть ли сейв у игры).
  if (!saveLen) {
    Serial.println(F("  сохранения игры: НЕТ места во flash под сейвы — писать некуда"));
  } else if (ownSaveSize) {
    Serial.print(F("  сохранения игры: ")); Serial.print((unsigned)ownSaveSize / 1024);
    Serial.print(F(" КиБ в ячейке ")); Serial.print(saveBank + 1); Serial.print(F(" из "));
    Serial.print(bankCount); Serial.print(F(" (ячейка ")); Serial.print(saveLen / 1024);
    Serial.println(F(" КиБ, чтобы размер не «прыгал» между играми)"));
  } else {
    Serial.println(F("  сохранения игры: у этой игры памяти сохранений нет — автосейв выключен"));
  }

  if (splash) {
    splashLeft = 1;
    splashNeutral = false;   // v8.9v: игру выбрали — показываем её название
    drawSplash();
    for (int i = 0; i < 20; i++) { delay(100); wdtFeed(); }   // заставка: кормим сторожа
  }
  return true;
}

// ============================================================ режимы при включении
// Функция вынесена отдельно, чтобы её можно было проверить на стенде (там кнопки
// подставляются программно). В setup() она вызывается сразу после настройки кнопок.
static void applyBootModes(void) {
  blkLogFlash = (millis() < 20000);            // первые 20 с: каждая операция с flash — в лог

  // Смысл: если в каком-то режиме консоль живёт долго, а в обычном умирает за
  // полсекунды — виновник найден без паяльника.
  if (digitalRead(BTN_GPIO[7]) == LOW) {        // SELECT
    soundOn = 0;
    Serial.println(F("SELECT зажат при включении: звук выключен на старте (проверка «дело в звуке?»)."));
  }
  if (digitalRead(BTN_GPIO[5]) == LOW) {        // B
    liteMode = true; soundOn = 0;
    Serial.println(F("B зажат при включении: ЛЁГКИЙ РЕЖИМ — подсветка выключена, звук и усилитель выключены,"));
    Serial.println(F("   SPI панели 41,7 МГц. Если так консоль живёт долго, а обычно нет — дело в нагрузке/питании."));
  }
  if (digitalRead(BTN_GPIO[0]) == LOW) {        // UP — то же, что по умолчанию (оставлено для ясности)
    Serial.println(F("UP зажат при включении: ящик в ОЗУ (это и есть обычное поведение с v8.9k)."));
  }
  if (digitalRead(BTN_GPIO[6]) == LOW) {        // START — «умный ящик»: выгрузка между кадрами
    blkSafeFlush = true;
    Serial.println(F("START зажат при включении: УМНЫЙ ЯЩИК — отметки в ОЗУ, а во flash они"));
    Serial.println(F("   выгружаются раз в 5 с МЕЖДУ кадрами (когда панель молчит — как автосейв)."));
    Serial.println(F("   Так и играть можно, и след на диске остаётся."));
  }
  if (digitalRead(BTN_GPIO[4]) == LOW) {        // A — ящик как раньше (контроль)
    blkEraseInPlay = true;
    Serial.println(F("A зажат при включении: ЯЩИК КАК РАНЬШЕ — со стираниями секторов прямо в игре"));
    Serial.println(F("   (контроль: так консоль выключалась; нужно только чтобы показать разницу)."));
  }
  if (digitalRead(BTN_GPIO[1]) == LOW) {        // DOWN
    blkOn = false;
    Serial.println(F("DOWN зажат при включении: чёрный ящик ВЫКЛЮЧЕН (проверка «не в записи ли во flash дело»)."));
  }
  if (digitalRead(BTN_GPIO[3]) == LOW) {        // RIGHT — тихая панель
    quietPanel = true;
    Serial.println(F("RIGHT зажат при включении: ТИХАЯ ПАНЕЛЬ — SPI панели 20,8 МГц (самый мягкий"));
    Serial.println(F("   режим для питания). Если и так выключается — панель не виновата."));
  }
  if (digitalRead(BTN_GPIO[2]) == LOW) {        // LEFT
    noPanelMode = true;
    Serial.println(F("LEFT зажат при включении: ПАНЕЛЬ НЕ ТРОГАЕМ (SPI молчит) — эмуляция идёт, экран не обновляется."));
  }
  Serial.print(F("ящик: "));
  if (!blkOn)               Serial.println(F("выключен — во flash не пишем (режим DOWN)."));
  else if (blkEraseInPlay)  Serial.println(F("как раньше — со стираниями в игре (контрольный режим A)."));
  else if (blkSafeFlush)    Serial.println(F("ОЗУ + выгрузка во flash между кадрами раз в 5 с (режим START)."));
  else Serial.println(F("в игре во flash НЕ ПИШЕМ ВООБЩЕ: отметки в ОЗУ (16 последних), во flash —\n"
                        "   при выключении. Именно так консоль проиграла длинную сессию без сбоев."));
}

// ============================================================ setup
void setup(void) {
  // --- САМОЕ ПЕРВОЕ: держим питание (как сток: GPIO1 — ключ питания) ---
  pinMode(PIN_PWR_HOLD, OUTPUT); digitalWrite(PIN_PWR_HOLD, HIGH);
  pinMode(PIN_EN12, OUTPUT);     digitalWrite(PIN_EN12, HIGH);
  pinMode(PIN_EN20, OUTPUT);     digitalWrite(PIN_EN20, HIGH);
  // ВАЖНО НА БУДУЩЕЕ: при ЛЮБОЙ перезагрузке (в том числе от сторожа) все выводы
  // на мгновение становятся «входом», то есть ключ питания (GPIO1) отпускается —
  // и консоль может выключиться вместо перезагрузки (именно так, похоже, и было:
  // зависание -> сброс сторожа -> питание ушло, отчёта в логе нет).
  // Поэтому включаем на этом выводе встроенную ПОДТЯЖКУ ВВЕРХ: в работе она не
  // мешает (вывод ведём мы), а в момент сброса удерживает ключ включённым.
  gpio_set_pulls(PIN_PWR_HOLD, true, false);

  // v9.7: сторож — СРАЗУ, с самых первых шагов загрузки. Раньше он включался
  // почти в конце setup(): если консоль вешалась на старте (такое бывало после
  // выключения — не запускалась, пока не ткнуть RESET), она висела навсегда.
  // Теперь любой сбой на старте перезагрузится сам через ~4 с, а в журнале
  // останется отметка, где именно это случилось.
  watchdog_enable(WD_MS, false);

  Serial.begin(115200);
  while (!Serial && millis() < 2500) { wdtFeed(); delay(10); }
  faultTrapInstall();                        // ловушка аппаратного сбоя (HardFault)
  bootReport();                              // что случилось в прошлый раз
  blkInit();                                 // и что лежит в чёрном ящике (стирать не будем)
  blkRead();
  Serial.print(F("ловушка: дальше след по кадрам 1.."));
  Serial.print(BLK_TRAP);
  Serial.println(F(" (две записи на кадр — по ним видно, на чём встали);"));
  Serial.println(F("   ящик НЕ стираю: слоты идут по кругу, сектор стирается только когда кольцо вернётся к занятому слоту."));
  Serial.print(F("свидетели: сбой ядра ловим (адрес будет в логе), залипание цикла —"));
  Serial.print(STALL_US / 1000); Serial.println(F(" мс без движения"));
  Serial.print(F("карта адресов: строка=")); Serial.print((uint32_t)(uintptr_t)&cb_lcd_line, HEX);
  Serial.print(F(" ядро="));  Serial.print((uint32_t)(uintptr_t)&gb_run_frame, HEX);
  Serial.print(F(" вывод=")); Serial.print((uint32_t)(uintptr_t)&txRow, HEX);
  Serial.print(F(" звук="));  Serial.print((uint32_t)(uintptr_t)&apuIsr, HEX);
  Serial.print(F(" цикл="));  Serial.print((uint32_t)(uintptr_t)&loop, HEX);
  Serial.print(F(" сбой="));  Serial.println((uint32_t)(uintptr_t)&gbHardFaultC, HEX);
  Serial.println();
  Serial.println(F("=== GB EMULATOR " GBEMU_BUILD " (RP2040 + ST7789 240x240) ==="));
  Serial.println(F("новое (v9.7): настройки переживают выключение, громкость мягко ограничена 10%,"));
  Serial.println(F("       выключение долгим нажатием везде (не только в игре), сторож с первых шагов."));
  Serial.println(F("сборка: ловушка просадки питания (2777 замеров в секунду), режим «тихая панель»,"));
  Serial.println(F("        батарея читается с A3, усилитель как в стоке (GP20 только на время звука), причина сброса из чипа,"));
  Serial.println(F("        сторож питания (все каналы АЦП, дежурство 0,25 с), след о снятии питания,"));
  Serial.println(F("        доклад из обычного потока, выровненная строка, свидетели стека, режимы-изоляторы"));
  Serial.print(F("CPU: ")); Serial.print(F_CPU / 1000000U); Serial.println(F(" МГц"));
  if (F_CPU < 240000000UL)
    Serial.println(F("ВНИМАНИЕ: поставьте Tools -> CPU Speed -> 250 MHz."));
#if defined(__OPTIMIZE_SIZE__)
  Serial.println(F("!!! ВНИМАНИЕ: сборка с -Os (Optimize = Smallest)."));
  Serial.println(F("!!! Поставьте Tools -> Optimize -> Fastest (-O3) и пересоберите — это +20-40%."));
#endif
  printCorePlace();
  spiRaisePeriClock();               // без этого SPI панели остаётся 24 МГц
  watchdog_enable(WD_MS, false);     // если консоль где-то встанет — перезагрузится сама
  Serial.print(F("сторож: ")); Serial.print(WD_MS);
  Serial.println(F(" мс (встанет — перезагрузится сам; в логе будет видно, где)"));
  wdtFeed();                                   // и сразу кормим: окно отсчитывается от установки

  settingsLoad();                        // v9.7: настройки прошлого сеанса (до палитры)
  for (int i = 0; i < NBTN; i++) joyMap[i] = BTN_JOY[i];
  rebuildPalette();

  pinMode(PIN_BL, OUTPUT);
  analogWriteFreq(25000);   // v9.6: ШИМ подсветки ультразвуковой (было 1000 — видимое
                            // мерцание, которое ещё и усиливало мерцание от тока усилителя;
                            // звук живёт на своём слайсе GP17/slice 0 и не трогается)
  lightApply();   // v8.9y: 255/255/255 (крутилка/потолок/сброс)
  // v9.7: мягкий старт подсветки (0 → цель за ~300 мс): резкий всплеск тока
  // на старте — один из кандидатов «консоль не стартует, помогает только RESET».
  {
    const uint8_t tgt = backlight;
    for (int i = 1; i <= 5; i++) { analogWrite(PIN_BL, (int)tgt * i / 6); delay(40); wdtFeed(); }
    analogWrite(PIN_BL, tgt);
  }

  SPI.setRX(PIN_MISO);
  // ВНИМАНИЕ, ЛОВУШКА (на ней v7 и повис с чёрным экраном):
  // SPI.setCS() в arduino-pico для SPI0 принимает ТОЛЬКО пины 1, 5, 17 или 21.
  // Любой другой пин — это panic(): плата печатает в Serial
  //   «FATAL: Attempting to set SPI0.CS to illegal pin N» и НАМЕРТВО встаёт.
  // CS панели у нас GP3 и дёргается вручную (csL/csH), а SPI.begin() внутри
  // вызывает begin(false) — то есть аппаратный CS вообще не включается и пин из
  // _CS не трогается. Поэтому setCS() здесь не нужен ВООБЩЕ: GP17 остаётся
  // свободным под ШИМ звука.
  SPI.setSCK(PIN_SCK);
  SPI.setTX(PIN_MOSI);
  SPI.begin();                       // == begin(false): hwCS выключен, CS не занимается
  SPI.beginTransaction(SPISettings(SPI_HZ, MSBFIRST, SPI_MODE0));
  spiSetClock(SPI_HZ_TAB[spiHzIdx]);     // v9.7: восстановленная частота панели (или дефолт)

  lcdInit();
  Serial.print(F("шаг 1: экран инициализирован, SPI "));
  Serial.print(spi_get_baudrate(spi0) / 1000000.0f, 1);
  Serial.println(F(" МГц (по умолчанию самая быстрая — на ней игра идёт ровно 60 кадр/с; клавиша o — переключить)"));
  printSpiTruth();
  for (int i = 0; i < NBTN; i++) pinMode(BTN_GPIO[i], INPUT_PULLUP);   // ПОСЛЕ SPI: GP16 = SPI0.RX
  // Если при включении держать SELECT — стартуем с ВЫКЛЮЧЕННЫМ звуком. Это проверка
  // «а не звук ли роняет консоль»: держите SELECT, включая консоль.
  applyBootModes();                             // режимы «зажать кнопку при включении»
  uiClear(0);
  Serial.println(F("шаг 2: гашу экран (первый кадр)..."));
  rowsValid = false;                             // v9.7.1: зачистка обязана дойти до панели целиком
  uiPush();                                    // гасим все 240 строк (лечит полосы и следы прошлого кадра)
  txDmaInit();                                 // строки будут уходить через DMA
  Serial.println(txDmaReady
    ? F("вывод: строки уходят через DMA (двойной буфер) — ядро не ждёт панель (клавиша u — сравнить)")
    : F("вывод: DMA недоступен, остаюсь на синхронной записи строк"));
  Serial.print(F("шаг 3: первый кадр отправлен, вывод: "));
  Serial.print(txPathName());
  Serial.print(F(", строк ")); Serial.print(frameRows);
  Serial.print(F(", ")); Serial.print(frameRows * (uint32_t)ROW_BYTES); Serial.println(F(" байт"));
  // v8.9o: сперва смотрим, что лежит в области картриджей. Если там список игр —
  // играем в ту, что была выбрана в прошлый раз (или в первую). Если списка нет —
  // во встроенную игру из rom.h, как раньше.
  romScan();
  if (romCount) { saveInit(romSramMax, romCount); ssInit(); }   // v9.1: раскладка сейвов сразу (метки + проверка вытеснения)
  int bootIdx = -1;
  bool bootNeedChoice = false;                                 // v9.1: автозапуск отменён из-за чужого сейва
  if (romCount) {
    int last = -1;
    bootIdx = (romStateLoad(&last) && last < romCount) ? last : 0;
  } else if (ROM_SIZE < 0x150) {
    Serial.println(F("Игры нет: ни списка во flash, ни встроенной (rom.h = заглушка)."));
    ui = UI_NOROM;
    drawNoRom();
    return;
  }
  if (romCount && bootIdx >= 0 && romList[bootIdx].sram && saveLen && bankCount > 0) {
    int vv = -1; uint32_t vk = 0;                       // v9.1: вытеснение на старте — не молча, а через список
    if (saveEvictPending(romList[bootIdx].crc, &vv, &vk) && vk != romList[bootIdx].crc) {
      Serial.println(F("автозапуск отменён: игра вытеснила бы чужой сейв — выбирайте в списке (там спросят)."));
      bootNeedChoice = true;
    }
  }
  if (!bootNeedChoice && !romStart(bootIdx, false)) {
    Serial.println(F("!! запустить игру не удалось — экран «NO ROM»"));
    ui = UI_NOROM; drawNoRom();
    return;
  }

  battInit(); battRead(); battPrint();         // прибор питания: читаем датчик
  if (quietPanel) {
    spiHzIdx = 3; spiSetClock(SPI_HZ_TAB[3]);  // 20,8 МГц
    Serial.println(F("тихая панель: SPI 20,8 МГц."));
  }
  if (liteMode) {
    setBacklight(0);                           // выключаем подсветку (главный потребитель)
    soundSetOn(0);                             // звук и усилитель — тоже прочь
    spiHzIdx = 2; spiSetClock(SPI_HZ_TAB[2]);  // 41,7 МГц: мягче для питания
    Serial.println(F("лёгкий режим включён: подсветка 0, звук выкл, SPI 41,7 МГц."));
  }
  // v8.9y: на старте панель/яркость НЕ трогаем (скорость не режем никогда) —
  // потолок яркости по заряду применится сам на первом замере батареи.
  ui = UI_SPLASH; splashLeft = 1;
  splashNeutral = (romCount > 1);   // v8.9v: список игр впереди — заголовок нейтральный
  drawSplash();
  for (int i = 0; i < 20; i++) { delay(100); wdtFeed(); }   // заставка: кормим сторожа

  emuInited = true;
  ui = UI_GAME;
  if (romCount > 1) {                        // игр несколько — показываем список, пусть выберет
    Serial.println(F("Игр несколько: UP/DOWN — выбор, A — играть (то же в меню: GAMES, и клавиша c)."));
    romMenuOpen();
  } else if (bootNeedChoice) {                 // v9.1: одна игра, но она вытеснила бы чужой сейв — пусть подтвердят
    romMenuOpen();
  }
  statT0 = millis();
  soundInit();                       // APU + ШИМ на GP17 (и усилитель GP20, см. строку AMP)
  printHelp();
  Serial.println(F("Играем: вывод 30 кадр/с (клавиша f — переключить на 60)."));
  Serial.println(F("setup: готов, вхожу в цикл (первые 30 кадров печатаю по строке — по ним видно, где встанет)"));
  mark(PH_LOOP);
}

// ============================================================ loop
static uint32_t nextFrameUs = 0;

void loop(void) {
  gBeat = micros(); gBeatN++;                  // пульс: по нему детектор видит залипание
  if (ui == UI_GAME && romCount > 0 && romCur < 0) romMenuOpen();   // v9.1: игра не запущена — только список
  if (!gBeatArm) gBeatArm = true;               // включаем детектор только когда цикл уже идёт
  gLcdOn = (gb.hram_io[IO_LCDC] & 0x80) ? 1 : 0;
  wdtTick();                                   // «кормим» сторожа: консоль жива
  blkTick();                                   // 0,25 с (первая минута) / 5 с — отметка в ящик
  blkSafeTick();                               // (режим START) выгрузка во flash, только если панель свободна
  // v8.9q: ЗДЕСЬ БОЛЬШЕ НЕТ НИ ВЫГРУЗКИ ЯЩИКА, НИ ЗАПИСИ «КАКАЯ ИГРА»: в игре во flash не
  // пишем вообще. В логе v8.9p все пять сбросов оборвались на строке «ящик: выгружаю во
  // flash отметок …» — то есть на стирании сектора (это ~50 мс, за которые батарея садится
  // ниже порога внешней схемы, и она сбрасывает чип по RUN). След просадки копится в ОЗУ
  // (16 последних отметок) и уходит во flash при выключении, когда экран уже погашен;
  // «какая игра» пишется в списке игр — до старта эмулятора.
  mark(PH_LOOP);
  handleSerial();
  soundUpdatePause();               // в меню/на паузе не синтезируем (нет залипших нот)

  // v8.9q: мягкий порог (3,55 В) — роняем нагрузку ЗАРАНЕЕ, не дожидаясь обрыва.
  if (gShedAsk) {
    gShedAsk = false;
    if (gShedAuto) shedLoad(false);
  }
  shedTick();                        // v8.9r: и ВОЗВРАЩАЕМ яркость, когда стало тихо

  // v8.9t: раз в минуту смотрим НАГРЕВ кристалла (не врущее абсолютное значение).
  // Единственная реальная опасность разгона до 250 МГц — перегрев.
  {
    static uint32_t tempChkMs = 0;
    if ((uint32_t)(millis() - tempChkMs) > 60000UL) {
      tempChkMs = millis();
      int rise = 0;
      const int mv = tempReadMv(&rise);
      if (mv && rise >= TEMP_RISE_WARN) {
        Serial.print(F("!! чип греется: +")); Serial.print(rise);
        Serial.println(F(" °C к базовому замеру (это уже не вранье датчика — это нагрев)."));
        Serial.println(F("   что можно сделать сейчас: f (30 кадр/с), o (панель медленнее),"));
        Serial.println(F("   [ (яркость ниже), x (звук выкл). Если корпус горячий — напишите,"));
        Serial.println(F("   сделаю переключатель частоты ядра (250 -> 133 МГц) клавишей."));
      }
    }
  }

  // ПРОСАДКА ПИТАНИЯ: докладываем из обычного цикла (из прерывания печатать нельзя)
  if (gDipWarn) {
    gDipWarn = false; gDipEvents++;
    mark(PH_DIP);
    Serial.print(F("!! ПРОСАДКА ПИТАНИЯ: батарея просела до "));
    Serial.print((uint32_t)gDipMin * 3300u / 4096u * 2); Serial.print(F(" мВ ("));
    Serial.print((uint32_t)gDipMin * 2 * 3300u / 4096u / 1000.0f, 2);
    Serial.print(F(" В) при норме "));
    Serial.print((uint32_t)battBRaw * 2 * 3300u / 4096u / 1000.0f, 2); Serial.println(F(" В"));
    Serial.println(F("   это и есть объяснение: питание клюёт, внешняя схема от этого сбрасывает чип по RUN"));
    Serial.println(F("   что помогает: клавиша [ (яркость ниже), o (SPI панели ниже), x (звук выкл)"));
    // v8.9p: ЗДЕСЬ БОЛЬШЕ НЕТ ЗАПИСИ ВО FLASH. Раньше в этот момент мы делали полный
    // перебор каналов АЦП и выгрузку чёрного ящика (стирание + запись сектора) — то
    // есть добавляли нагрузку ровно тогда, когда питание и так на грани. Отметка о
    // просадке уже лежит в кольце ОЗУ и уйдёт во flash при выключении, когда питания
    // будет достаточно.
    // v8.9q: здесь больше НЕ ставим отложенную выгрузку ящика: именно она (стирание сектора
    // в игре) и роняла консоль. След остаётся в ОЗУ и уйдёт во flash при выключении.
    Serial.println(F("   (во flash не пишу и в игре вообще не буду: след остаётся в ОЗУ, уйдёт при выключении)"));
    Serial.flush();
    // Автосброс нагрузки: временно опускаем яркость до 50 % (скорость не трогаем).
    if (gShedAuto && (uint32_t)(millis() - gShedLastMs) > SHED_COOLDOWN_MS) shedLoad(true);
  }

  // v8.9p: доклад «как питание живёт после запуска игры» — через 2,5 с после старта.
  if (!gSagDone && (uint32_t)(millis() - gSagT0) >= SAG_WINDOW_MS) {
    gSagDone = true;
    const uint32_t idle = (uint32_t)battBRaw * 2u * 3300u / 4096u;      // холостое (последний замер)
    const uint32_t lo   = (uint32_t)((gSagMin > 4000) ? 0 : gSagMin) * 2u * 3300u / 4096u;
    const uint32_t hi   = (uint32_t)gSagMax * 2u * 3300u / 4096u;
    if (gSagMax == 0) {
      // Замеров не было: ловушка просадки живёт в прерывании звука, а он выключен.
      Serial.println(F("питание после запуска игры: замеров не было (звук выключен — ловушка молчит)"));
    } else {
      Serial.print(F("питание после запуска игры: "));
      Serial.print(hi / 1000.0f, 2); Serial.print(F(" В (лучшее) .. "));
      Serial.print(lo / 1000.0f, 2); Serial.print(F(" В (худшее), холостое "));
      Serial.print(idle / 1000.0f, 2); Serial.print(F(" В => просадка "));
      Serial.print((idle > lo) ? (idle - lo) : 0); Serial.println(F(" мВ"));
      Serial.println(F("   (если просадка больше ~200 мВ — при запуске игры питанию не хватает:"));
      Serial.println(F("    поможет зарядка, кнопка x (звук выкл), [ (яркость ниже), o (панель медленнее))"));
    }
  }

  mark(PH_KEYS);
  const uint16_t mask = readMask();
  const bool holding = holdTick(mask);

  if (ui == UI_NOROM) {
    static uint16_t prev = 0xFFFF;
    if (mask != prev) { prev = mask; drawButtonScreen("TEST", mask, "GPIO NUMBERS"); }
    delay(20);
    return;
  }
  if (ui == UI_TEST) {
    static uint16_t prev = 0xFFFF;
    if (mask != prev) {
      prev = mask;
      drawButtonScreen("TEST", mask, "GPIO NUMBERS");
      Serial.print(F("mask=0x")); Serial.print((int)mask, HEX); Serial.print(F("  нажато: "));
      for (int i = 0; i < NBTN; i++) if (mask & (1u << i)) { Serial.print(BTN_NAME[i]); Serial.print(' '); }
      Serial.println();
    }
    delay(20);
    return;
  }
  if (ui == UI_LEARN) { learnTick(mask); delay(5); return; }
  if (ui == UI_MENU)  { menuTick(mask); delay(5); return; }
  if (ui == UI_ROMS)  { romMenuTick(mask); delay(5); return; }
  if (ui == UI_TONE)  { toneTick(mask); delay(2); return; }
  if (ui == UI_SHADES) { if (mask) { ui = UI_GAME; } else { delay(20); return; } }
  if (!emuInited) { ui = UI_NOROM; drawNoRom(); return; }
  if (paused || holding) { delay(5); return; }

  // ------- игра -------
  uint8_t joy = 0xFF;
  for (int i = 0; i < NBTN; i++)
    if (joyMap[i] && (mask & (1u << i))) joy &= (uint8_t)~joyMap[i];
  gb.direct.joypad = joy;

  // предсказываем, будет ли peanut рисовать этот кадр (режим 30 кадр/с):
  // на пропущенном кадре на панель НЕ отправляем ничего — картинка остаётся прежней
  // (v8.9p) и первые 0,4 с после смены игры панель тоже не трогаем — «мягкий старт»
  const bool panelHold = (int32_t)(panelHoldUntil - millis()) > 0;
  const bool willDraw = !noPanelMode && !panelHold && !(gb.direct.frame_skip && !gb.display.frame_skip_count);

  // Ждём, пока уедет прошлый кадр: строка идёт сразу в панель, и начинать новый
  // кадр, пока старый ещё на шине, нельзя. Дольше 3 мс не ждём — если панель не
  // успела, этот кадр пропускаем целиком (картинка не портится, просто на кадр старше).
  gateWaits++;
  mark(PH_GATE);
  const bool panelBusy = !txWaitIdle(TX_GUARD_US);
  if (panelBusy) {
    gateSkips++;
    if (gateSkips <= 3) Serial.println(F("!! панель не успела принять прошлый кадр — пропускаю вывод этого кадра"));
  }
  const bool drawThis = willDraw && !panelBusy;   // рисуем только если панель готова
  drawThisDbg = drawThis;

  if (gFramesTotal < 5) {                      // первые кадры: пишем начало и итог
    Serial.print(F("кадр ")); Serial.print(gFramesTotal + 1); Serial.print(F(": начало (путь "));
    Serial.print(txPathName()); Serial.println(F(")"));
  }
  const uint32_t t0 = micros();                 // начало всего кадра
  stackWitness();                               // свидетель стека: самая глубокая точка
  if (drawThis) { frameStart(); rowBl(GAME_TOP); }
  mark(PH_CORE);
  blkTrap();                                    // ЛОВУШКА: «вот этот кадр начал считаться»
  const uint32_t tc0 = micros();                // начало работы ядра
  gb_run_frame(&gb);
  const uint32_t t1 = micros();                 // конец работы ядра
  mark(PH_FINISH);
  txCheckHealth();                               // если SPI встал — перезапустим шину и скажем в лог
  gFramesTotal++;
  { const uint32_t fr = micros() - t0; if (fr > 30000U) gSlowFrames++; }
  if (drawThis) {
    statCoreUs += t1 - tc0; statCoreN++;
    // добиваем кадр до конца окна: в норме строк уже 240, а если ядро отдало
    // меньше (или строки не ушли из-за сбоя) — низ экрана будет чёрным,
    // а не «остатками прошлого кадра»
    if (frameRows < MEM_H) rowBlTail(MEM_H - frameRows);   // v8.9v: внизу полосы — индикатор батареи
    frameFinish();
  }
  const uint32_t t2 = micros();
  if (drawThis) watchdog_hw->scratch[7] = (uint32_t)gb.cpu_reg.pc.reg;   // «последний вздох»: где игра
  blkTrap();                                    // ЛОВУШКА: «кадр закончен»

  mark(PH_TRACE);
  if (gFramesTotal <= 30) {                    // по строке на кадр: где время и где встало
    // Печатаем ОДНОЙ строкой и только если USB может её принять. Блокирующий
    // Serial.print ждёт хост бесконечно — именно так прошивка могла «встать
    // намертво» на 12-м кадре, когда терминал не успевал читать.
    char line[220];
    if (!drawThis) {                           // пропущенный кадр: 30 кадр/с или мягкий старт
      snprintf(line, sizeof(line), "кадр %lu: пропущен (%s)",
               (unsigned long)gFramesTotal,
               noPanelMode ? "панель не трогаем (режим при включении)"
                           : (panelHold ? "мягкий старт: панель ещё отдыхает после запуска игры"
                                        : "30 кадр/с: на панель идёт каждый второй кадр"));
    } else {
      // СТРАЖ: физику не обмануть. Если за кадр «ушло» больше байт, чем шина может
      // передать за это время — значит часть данных на самом деле не ушла.
      const uint32_t cap = (uint32_t)((uint64_t)spi_get_baudrate(spi0) * (t2 - t0) / 8000000ULL);
      snprintf(line, sizeof(line),
               "кадр %lu: всего %lu мкс, ядро %lu, выход %lu, строк %lu (проп %lu), байт в панель %lu из %lu возможных%s",
               (unsigned long)gFramesTotal, (unsigned long)(t2 - t0), (unsigned long)(t1 - t0),
               (unsigned long)(t2 - t1), (unsigned long)frameRows, (unsigned long)frameSkip,
               (unsigned long)txBytesFrame,
               (unsigned long)cap,
               (txBytesFrame > cap + cap / 20) ? "  !! БОЛЬШЕ ПРЕДЕЛА — данные не уходят!" : "");
    }
    traceLine(line);
  }

  if (diagFrames && --diagFrames == 0) diagReport(&gb);

  statFrames++;
  statEmuUs += (t1 - t0);
  statAllUs += (drawThis ? (t2 - t0) : (t1 - t0));
  if (drawThis) { statDrawUs += (t2 - t0); statDrawN++; }
  else          { statSkipUs  += (t1 - t0); statSkipN++; }
  statN++;

  // автосейв
  // Автосейв — раз в 2 минуты (было 30 с): игры обычно пишут в SRAM часто, а каждое
  // сохранение — это стирания секторов. При выключении и по клавише 'w' сохраняем сразу.
  if (cartDirty && saveLen && (millis() - lastSaveMs) > 120000 && battGuardOk()) saveStore(false);

  if (millis() - statT0 >= 1000) {
    statFps  = statFrames;                 // эмулированных кадров в секунду
    avgEmuUs = statN ? statEmuUs / statN : 0;
    avgAllUs = statN ? statAllUs / statN : 0;
    avgDrawUs = statDrawN ? statDrawUs / statDrawN : 0;
    avgSkipUs = statSkipN ? statSkipUs / statSkipN : 0;
    avgWaitUs = statN ? spiWaitAcc / statN : 0;   // (в v7.1/v7.2 здесь читалась всегда нулевая переменная)
    avgCoreUs = statCoreN ? statCoreUs / statCoreN : 0;
    avgCbUs   = statN ? cbAccUs / statN : 0;
    avgCbUsPer= cbCalls ? cbAccUs / cbCalls : 0;
    avgSpiUs  = statN ? spiCallAcc / statN : 0;
    avgSpiCalls = statN ? spiCalls / statN : 0;
    avgCbCalls = statN ? cbCalls / statN : 0;
    avgRowUs   = txRowsOk ? txRowAcc / txRowsOk : 0;
    avgRowsW   = statN ? txRowsOk / statN : 0;
    avgRowsL   = txRowsFail;
    avgDmaBad  = spiStuck;
    avgSpiSyncUs = statN ? txRowAcc / statN : 0;
    avgDmaRows   = statN ? txDmaRows / statN : 0;
    avgDmaWaitUs = statN ? txDmaWaitAcc / statN : 0;
    avgIrqUs   = apuIrqN ? apuIrqUs / apuIrqN : 0;   // средняя стоимость одного прерывания звука
    avgIrqN    = apuIrqN;
    statsClear();

    markTick();                            // отметка «сколько прожили» — для отчёта сторожа
    soundSyncTick();                       // темп звука под скорость игры
    mark(PH_STATUS);
    printStatus();
  }

  // пейсинг 59.7 кадр/с
  const uint32_t now = micros();
  if (nextFrameUs == 0) nextFrameUs = now;
  nextFrameUs += FRAME_US;
  const int32_t wait = (int32_t)(nextFrameUs - now);
  if (wait > 0) {
    if (wait > 2000) delay((wait - 1500) / 1000);
    while ((int32_t)(micros() - nextFrameUs) < 0) { }
  } else {
    nextFrameUs = now;
  }
}
