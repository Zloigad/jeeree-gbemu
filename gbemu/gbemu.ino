static void reportMapping(void) {
  Serial.println(F("--- готово. Вставьте это в скетч (BTN_GPIO / BTN_NAME): ---"));
  Serial.print(F("static const uint8_t BTN_GPIO[NBTN] = {"));
  for (int i = 0; i < NBTN; i++) { Serial.print(' '); Serial.print(BTN_GPIO[i]); Serial.print(i < NBTN - 1 ? ',' : ' '); }
  Serial.println(F("};"));
  Serial.print(F("static const char   *BTN_NAME[NBTN] = {"));
  for (int i = 0; i < NBTN; i++) { Serial.print(F(" \"")); Serial.print(BTN_NAME[i]); Serial.print(i < NBTN - 1 ? F("\",") : F("\" ")); }
  Serial.println(F("};"));
}

static void learnTick(uint16_t mask) {
  if (mask && !learnPrev) {
    int idx = -1;
    for (int i = 0; i < NBTN; i++) if (mask & (1u << i)) { idx = i; break; }
    if (idx >= 0) {
      Serial.print(F("  GPIO")); Serial.print(BTN_GPIO[idx]);
      Serial.print(F(" = ")); Serial.println(BTN_NAME[learnStep]);
      joyMap[idx] = BTN_JOY[learnStep];
      learnStep++;
      if (learnStep >= NBTN) { reportMapping(); ui = UI_GAME; learnPrev = 0; return; }
      learnT0 = millis();
      learnPrompt();
    }
  }
  learnPrev = mask;
  if (millis() - learnT0 > 15000) { learnT0 = millis(); learnPrompt(); }
}

