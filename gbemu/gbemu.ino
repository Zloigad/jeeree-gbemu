/*
 * gbemu.ino — Game Boy (DMG) эмулятор для этой консоли. ВЕРСИЯ 9.7.2
 *              RP2040 + ST7789 240x240 (SPI0) + 9 кнопок
 *
 * Ядро: Peanut-GB (deltabeard/Peanut-GB, zlib). peanut_gb.h — рядом со скетчем,
 *       он специально подготовлен: горячий код ядра можно исполнять из ОЗУ.
 * ROM : rom.h генерируется скриптом make_rom_header.py / .ps1 из вашего .gb.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.7.2)
 *
 * 0) НАСТРОЙКИ НАКОНЕЦ СОХРАНЯЮТСЯ (баг «не сохраняются после перезапуска»).
 *    Запись настроек шла во flash БЕЗ защиты: на время стирания flash выключен из
 *    шины, прерывание звука зовёт код из flash — чип падал (консоль
 *    «перезагружалась» вместо выключения), а сектор уже был стёрт — настройки
 *    пропадали. Теперь запись защищена как все остальные (тихо + без прерываний),
 *    сверяется с подтверждением (не сошлось — повтор), и настройки дополнительно
 *    пишутся при старте игры, если менялись (переживут даже reset).
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.7.1)
 *
 * 0) ЧИСТЫЙ ЭКРАН ПРИ ВКЛЮЧЕНИИ (баг «следы прошлого кадра»). На экране оставалась
 *    цифра отсчёта выключения (или цветной шум) и стиралась только при движении
 *    картинки. Причина: тест-кадр смены частоты SPI шёл ДО инициализации панели и
 *    «закрывал» кэш диффа строк — из-за этого стартовая зачистка экрана пропускала
 *    все 240 строк, и в GRAM панели жил кадр выключения. Теперь: тест-кадр только
 *    после инициализации, кэш сбрасывается в конце lcdInit, зачистка шлёт всё.
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.7)
 *
 * 0) НАСТРОЙКИ ПЕРЕЖИВАЮТ ВЫКЛЮЧЕНИЕ. Всё, что накрутил пользователь (свет
 *    панели, яркость палитры, контраст, громкость, палитра, инверсия, звук,
 *    частота панели), пишется в последний сектор flash при штатном выключении
 *    и восстанавливается при включении (раньше сбрасывалось каждый запуск).
 * 1) ПАЛИТРА BLUE — тёмно-синяя, под цвет корпуса (замер по фото при свете:
 *    пластик #001030..#2C3E68; самый светлый шаг ≈ освещённый корпус).
 * 2) МЯГКИЙ ЛИМИТ ГРОМКОСТИ 10%: крутилка в меню не выкручивает выше (выше —
 *    ток усилителя роняет питание и подсветку; громче в этой консоли не нужно).
 * 3) ВЫКЛЮЧЕНИЕ ВЕЗДЕ: держать START/MENU 3 с можно и в списке игр, и в меню
 *    (раньше — только в игре; отсюда вопрос «как выключить, не заходя в игру»).
 * 4) СТАРТ БЕЗ RESET (смягчение бага «после выключения не стартует, пока не
 *    ткнуть RESET»): сторож включается СРАЗУ при подаче питания (раньше —
 *    почти в конце загрузки: зависание на старте висело навсегда). Теперь
 *    зависание на старте перезагрузит консоль саму через ~4 с, в журнале
 *    (Serial) будет видно, где встали. Плюс мягкий старт подсветки (всплеск
 *    тока на старте сглажен).
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.6)
 *
 * 0) МЕРЦАНИЕ ЭКРАНА В ТАКТ ЗВУКУ УХОДИТ (главное). Как только журчание стало
 *    почти незаметным, стало видно следующий эффект: при включённом звуке
 *    экран/подсветка мерцает по громкости музыки (сильнее на слабой батарее:
 *    3,31 В = 1 деление). Это физика: ток усилителя пропорционален размаху
 *    звукового сигнала, питание «дышит» в такт музыке, подсветка сидит на той
 *    же шине. Убираем обе части эффекта:
 *    а) ШИМ ПОДСВЕТКИ -> 25 кГц (ультразвук): 1 кГц сам по себе видимо мерцает
 *       и усиливает восприятие; на 25 кГц мерцания ШИМ не существует.
 *    б) МЯГКИЙ ОГРАНИЧИТЕЛЬ ПИКОВ ЗВУКА: всё, что громче 120 уровней ШИМ,
 *       сжимается 3:1 (тише становятся ТОЛЬКО самые громкие пики, музыка почти
 *       не меняется) — размах тока усилителя и, значит, «дыхание» питания меньше.
 *    Полностью убрать мерцание на севшей батарее может только железо
 *    (конденсатор по питанию усилителя) — но оно должно стать редким и слабым.
 * 1) Строка сборки (GBEMU_BUILD) наконец догоняет версию: в v9.5 она осталась
 *    «v9.4» (в 's' печаталась старая).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.5)
 *
 * 0) ЖУРЧАНИЕ ПОД МУЗЫКОЙ УХОДИТ: РЕЖЕМ НАВОДКУ ОТ ШИНЫ ПАНЕЛИ (главное).
 *    А/Б-тест v9.4 (o + f = SPI 20,8 МГц + 30 кадр/с «существенно тише»)
 *    подтвердил: источник журчания — трафик SPI/нагрузка панели, наводящиеся
 *    на усилитель. Почему в стоке было тихо: сток ДЕРЖАЛ усилитель заглушённым
 *    (GP20 = HIGH) и пищал короткими сигналами, а не сплошной музыкой, —
 *    наводка существовала всегда, просто не усиливалась. Теперь мы гасим саму
 *    наводку:
 *    а) КАДРОВЫЙ ДИФФ: неизменившиеся строки кадра в панель НЕ шлём вообще
 *       (строка сравнивается с прошлым кадром по хэшу готовых байтов; полосы,
 *       HUD и статичные зоны молчат). Строки идут сериями — у каждой серии
 *       своё окно панели (пропуски ломают автоинкремент курсора).
 *    б) ШИНА 62,5 МГц ПО УМОЛЧАНИЮ (было 125): фронт данных мягче, тактов
 *       меньше. Клавиша o — цикл: 62,5 -> 41,7 -> 20,8 -> 125.
 *    Вместе с гейтом усилителя (v9.4: 2 с тишины — глушим) журчание под
 *    музыкой должно уйти. Если осталось слышно — следующий кандидат ШИМ
 *    подсветки на 1 кГц (analogWriteFreq), но сначала — эта сборка.
 * 1) AMP по-прежнему не в меню (HIGH = просто глухо, рабочий режим только LOW).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.4)
 *
 * 0) ЖУРЧАНИЕ — ЭТО НАВОДКА ОТ НАГРУЗКИ, И ОНО УХОДИТ ВМЕСТЕ С ТИШИНОЙ.
 *    Ваши А/Б-тесты всё расставили по местам: в меню (игра стоит, панель молчит)
 *    журчания нет даже при включённом усилителе, а при volume 0 (игра идёт)
 *    журчание остаётся — значит дело НЕ в звуковом сигнале, а в наводке от
 *    процессора игры и SPI-панели на усилитель. Поэтому возвращаем стоковое
 *    поведение GP20: LOW только на время звука, после 2 с настоящей тишины
 *    усилитель глушится — и наводка вместе с ним. Включение — только вместе с
 *    мягким входом (12 мс), щелчков вкл/выкл нет: тишина детектируется по
 *    DC-блокеру (постоянка каналов больше не держит усилитель включённым —
 *    в v9.2 из-за неё он щёлкал на паузах). Если под МУЗЫКОЙ журчание слышно —
 *    это уже железо (питание усилителя); проверка без паяльника: на паузе
 *    клавиши o (SPI 20,8 МГц) и f (30 кадр/с) — если тише, источник шина панели.
 * 1) AMP по-прежнему не в меню: HIGH = просто глухо, выбирать нечего.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.3)
 *
 * 0) ЗВУК БЕЗ ТРЕСКА (главное). На паузе/в тишине слышался фоновый «треск,
 *    будто журчит» — три причины, все убраны:
 *    а) УСИЛИТЕЛЬ ЩЁЛКАЛ. GP20 опускался только пока шёл звук («как в стоке»),
 *       и на каждой паузе усилитель щёлкал вкл/выкл — отсюда треск. Теперь
 *       GP20 = LOW всё время, пока звук включён (проба звука: LOW = звук).
 *       Режим AMP из меню убран: правильный уровень только LOW.
 *    б) ПОСТОЯНКА ОТ КАНАЛОВ. Канал «включён, но молчит» давал −15 уровней
 *       смещения: динамик подмагничивался, каждое вкл/выкл канала — щелчок.
 *       Теперь на выходе цифровой «разделительный конденсатор» (ФВЧ ~35 Гц).
 *    в) АЛИАСИНГ. Шумовой (LFSR) и прямоугольные каналы брались точкой на
 *       22 кГц — высокие частоты сворачивались в «журчание». Теперь семпл
 *       усредняется за период (boxcar): высокие ноты честно приглушаются,
 *       как через динамик настоящего DMG. Плюс прерывание звука поднято
 *       в приоритете над USB — тайминг семплов стабильнее.
 *       Меню/пауза больше не рвут сигнал обрывом на IDLE — гасим за ~12 мс.
 * 1) ПАЛИТРА BLUE — в цвет корпуса, и она же теперь умолчание.
 * 2) КОНТРАСТ ПО УМОЛЧАНИЮ 120 % (было 140 — многовато).
 * 3) МЕРЦАНИЕ ЭКРАНА шло за громкостью (уходило на volume 0) — это была
 *    нагрузка усилителя: GP20 щёлкал, ток прыгал, подсветка мигала. С постоянным
 *    GP20 = LOW нагрузка ровная. Если мерцание вернётся — следующий кандидат
 *    ШИМ подсветки на 1 кГц (analogWriteFreq).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.2)
 *
 * 0) ФУЛСПИД ВЕРНУЛСЯ. v9.1 тихо собрался на 133 МГц с -Os (флаги build_flags
 *    проиграли флагам платформы) — игра шла на 75 % скорости. Теперь частота
 *    задаётся правильно (board_build.f_cpu), платформа зафиксирована на теге,
 *    а в коде стоят сторожа сборки: медленный билд не линкуется, а падает
 *    с понятной ошибкой. Такое больше не повторится.
 * 1) ЯРКОСТЬ БАТАРЕЕЙ НЕ ТРОГАЕМ ВООБЩЕ. Потолок по заряду и автосброс при
 *    просадке удалены: яркость — только крутилка LIGHT, скорость — всегда
 *    полная. Индикатор батареи, вольты, LOW и предупреждения в Serial остались.
 *    Честно: на слабой батарее вместо затемнения теперь возможен внезапный
 *    сброс внешней схемой — это железо, лечится зарядкой.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.1)
 *
 * 0) СЕЙВЫ НЕ УДАЛЯЮТСЯ МОЛЧА. Запуск игры, вытесняющей чужой сейв, — только
 *    с вопросом (показываем, чей сейв пострадает: A — заменить, B — назад).
 *    Перезапись чужого сейвстейта — тоже с вопросом. Автозапуск при включении
 *    в такой ситуации не стартует молча, а открывает список игр.
 * 1) ВИДНО, ГДЕ СЕЙВЫ: в списке игр квадратик ярче и шире, если сейв уже лежит;
 *    в меню слоты стейтов помечены (* — мой, X — чужой, пусто — свободен).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (9.0)
 *
 * 0) ОБЛАСТЬ ИГР ПЕРЕЕХАЛА ВНИЗ: 0x100000 -> 0x80000. Прошивка занимает всего
 *    ~135 КБ, а граница стояла на 1 МБ — полмегабайта пустовало. Теперь под игры
 *    1516 КБ (было 1004): влезают образы до 1 МБ (покемоны!) и ~47 мелких игр.
 * 1) МАГИЯ ТАБЛИЦЫ GMR1 -> GMR2: старые наборы новая прошивка честно не видит
 *    (экран NO ROM) — их надо пересобрать новым упаковщиком. Сейвы SRAM
 *    и сейвстейты лежат ниже новой границы сами (стража уже была на ROMS_TABLE_OFF).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9y)
 *
 * 0) СКОРОСТЬ ИГРЫ НЕ ТРОГАЕМ НИКОГДА. Автосброс нагрузки переведён с панели
 *    на подсветку: при просадке яркость временно падает до 50 % (потом сама
 *    возвращается), панель всегда на выбранной частоте. Стартовое прибивание
 *    панели на 62,5 МГц убрано.
 * 1) ПОТОЛОК ЯРКОСТИ ПО ЗАРЯДУ: сегменты 4-3 — без ограничений, 2 — 75 %,
 *    1 — 60 %, 0 — 50 % (в 0 — никогда). В меню такой LIGHT помечен BAT.
 *    На зарядке потолок снимается сам.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9x)
 *
 * 0) БАТАРЕЯ НЕ ПРЫГАЕТ: вольты сглаживаются (~8 с), иконка — 4 сегмента
 *    с гистерезисом 25 мВ (была сплошная заливка от мгновенного замера, а шина
 *    гуляет ±100 мВ — иконка скакала снизу доверху). LOW/красный — тоже
 *    по сглаженному, без мигания.
 * 1) ИКОНКА В ИГРЕ С ОТСТУПОМ: 8 px в 12-пиксельной полосе (по 2 px чёрного
 *    сверху и снизу), к картинке больше не прилипает.
 * 2) ПОРОГ «СЛАБАЯ БАТАРЕЯ» 3,64 -> 3,50 В: при норме этой платы (3,61 В)
 *    консоль стартовала на 62,5 МГц и подсветке 78 % вместо 125 МГц и 100 %.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9w)
 *
 * 0) КАЛИБРОВКА БАТАРЕИ ПОД ЭТУ ПЛАТУ: 100 % = 3,62 В (было 3,80 — из-за этого
 *    свежая батарея 3,61 В выглядела «наполовину пустой», а 3,58 В после пяти
 *    минут игры — «половина съедена»). Пусто и LOW — по-прежнему 3,30 В.
 * 1) ИНДИКАТОР В ИГРЕ МИНИМАЛИСТИЧНЫЙ: только иконка, без цифр (цифры мельтешили
 *    и отвлекали). Цвет — приглушённый светлый цвет текущей палитры (под каждую
 *    игру свой оттенок, из картинки не выбивается), разряд — красным.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9v)
 *
 * 0) БАТАРЕЯ ВЕЗДЕ. В игре — индикатор в нижней чёрной полосе (иконка + вольты,
 *    при разряде красным + LOW); в шапках меню и списка игр — иконка + вольты
 *    (были только цифры). Замер — раз в секунду, полоса игры не страдает.
 * 1) ЗАСТАВКА ЧЕСТНАЯ: на старте со списком игр — «SELECT GAME» вместо названия
 *    прошлой игры; строка SAVES: AUTO убрана; «HOLD START 3S» заменено на
 *    «HOLD START = OFF» (3S читалось как 35: S и 5 в шрифте 3x5 одинаковые).
 * 2) Заливка иконки батареи — самым тёмным оттенком (на светлом фоне видно лучше).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9u)
 *
 * 0) МЕНЮ ПОДСВЕТКИ ЧЕСТНОЕ. Строка BRIGHT показывала 78 % при «яркости 100» —
 *    это были ДВЕ разные яркости: подсветка (железо, 200/255 = 78 %) и яркость
 *    палитры (софт, 100 %). Теперь строка называется LIGHT и показывает именно
 *    подсветку, а умолчание — 255 (100 %). Если батарея слабая, при включении
 *    подсветка сама опускается до 200 (в меню LIGHT можно вернуть обратно).
 *    Проба звука и неудачное выключение больше не сбрасывают подсветку на 200.
 * 1) ГРОМКОСТЬ ПО УМОЛЧАНИЮ 10 % (было 30).
 * 2) ШРИФТ 3x5: добавлены J Q Z ( ) . , * _ ' — «ZELDA» больше не выглядит как
 *    полоски. Неизвестный знак теперь рисуется как '?', а не '='.
 * 3) ЗАСТАВКА БЕЗ SERIAL-МУСОРА: только настоящие кнопки (MENU = опции,
 *    HOLD START = выключение, сейвы авто) + индикатор батареи.
 * 4) ИНДИКАТОР БАТАРЕИ НА ЭКРАНЕ: иконка + вольты на заставке, вольты в шапке
 *    меню и списка игр. Читается канал A3 (GP29) — тот же, что у ловушки
 *    просадки в прерывании звука, поэтому гонки с прерыванием нет.
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9t)
 *
 * 0) ДЕФОЛТЫ, КАК ВЫ ПРОСИЛИ: яркость 100 %, контраст 140 %, громкость 30 %,
 *    палитра AMBER.
 * 1) ПРОБА ЗВУКА СПРЯТАНА. Нажатие z больше ничего не запускает: сначала предупреждение,
 *    запуск — повторным z в течение 5 с. И выход из пробы теперь есть ВСЕГДА: кнопка A
 *    или B, любая клавиша в терминале, 20 с без действий — проба кончается сама.
 *    Ресет (зубочистка) для выхода не нужен.
 * 2) ПОМЕХА АЦП БОЛЬШЕ НЕ ВЫГЛЯДИТ КАК ПРОСАДКА. В логе v8.9r были «просадки» до
 *    1,12 В и «просадка 2583 мВ» при живой батарее 3,7 В — это грязь при переключении
 *    канала. Теперь: отсчёты ниже 2,0 В отбрасываются (при таком питании чип бы уже
 *    не работал), а просадкой считается низкий участок длиной >= 10 мс (настоящая
 *    просадка под нагрузкой держится десятки мс). После перебора каналов пропускаем
 *    4 отсчёта вместо одного.
 * 3) ТЕМПЕРАТУРА ЧЕСТНО. Датчик этой платы врёт: сразу после включения он даёт 0,566 В,
 *    что по формуле даташита = 108 °C — так не бывает. Теперь база — самый холодный
 *    замер сеанса (комнатная температура), а в лог идёт НАГРЕВ: «нагрев чипа +12 °C
 *    к базовому». Предупреждение — при +55 °C. Абсолютная цифра печатается справочно
 *    с пометкой, что верить ей нельзя.
 * 4) Отчёт о прошлом запуске не печатает мусор из записи старого формата
 *    («панель: МГц, ступеней вниз 255, возвратов 65535»).
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9s)
 *
 * 0) АВТОСБРОС НАГРУЗКИ БОЛЬШЕ НЕ СЪЕДАЕТ СКОРОСТЬ. Он делал ДВЕ ступени
 *    (125 -> 62,5 -> 41,7 МГц), и вторая ступень оставляла 46 кадр/с — это и есть
 *    «76 % скорости» при активном геймплее. Теперь автоматически берётся РОВНО ОДНА
 *    ступень: 125 -> 62,5 МГц (это ~90-96 % кадров). И сразу после неё прошивка
 *    ПРОВЕРЯЕТ, помогло ли:
 *      – помогло (просадки прекратились) — панель остаётся на 62,5 и вернётся на 125,
 *        как только станет тихо (правило 2 минут из v8.9r);
 *      – НЕ помогло (просадки идут дальше) — дело не в панели: частота возвращается
 *        на 125 МГц (скорость не отдаём зря), в лог уходит честная строка про
 *        батарею/контакты, и в этом сеансе панель автоматически больше не трогаем
 *        (руками — клавиша o).
 *    До 41,7 МГц прошивка сама не опускается НИКОГДА: эту частоту можно поставить
 *    только руками клавишей o, если вы сознательно предпочитаете запас питания кадрам.
 *    В статусе рядом с процентами теперь печатается частота панели — причина видна.
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9r)
 *
 * 0) «ПРОИЗВОДИТЕЛЬНОСТЬ УПАЛА» — это сработал автосброс нагрузки (125 -> 62,5 -> 41,7
 *    МГц), он в вашем логе сработал дважды. Теперь автосброс ДВУСТОРОННИЙ:
 *      – если просадка повторилась (панель уже опущена) — опускаем ещё на ступень;
 *      – если 2 минуты тихо и холостая батарея не ниже 3,62 В — возвращаем ступень
 *        НАВЕРХ (в логе «ПИТАНИЕ ВЫПРАВИЛОСЬ: возвращаю панель на 125 МГц»);
 *      – после просадки возврат запрещён на 2 минуты, чтобы частота не дёргалась.
 *    И ещё: решение о просадке теперь принимается по ДВУМ замерам подряд (одиночный
 *    выброс АЦП — не просадка). Раньше одного «клюнувшего» отсчёта хватало, чтобы
 *    уронить панель: отсюда и потеря кадров.
 * 1) ТЕМПЕРАТУРА ЧИПА: в стартовом логе и в 's' печатается температура кристалла в
 *    градусах, а если она поднимется выше 85 °C — раз в минуту предупреждение. Раньше
 *    мы печатали милливольты датчика (0,57 В), по которым выходило «~100 °C» — это был
 *    мусор первого отсчёта после переключения канала; теперь датчику дают устояться.
 * 2) БАННЕР ПЕЧАТАЛ НЕ ТУ ВЕРСИЮ: в логе было «v8.9p», хотя внутри работал v8.9q.
 *    Теперь версия одна на весь скетч (GBEMU_BUILD) и печатается ещё и в 's'.
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9q)
 *

 * 0) В ИГРЕ ВО FLASH НЕ ПИШЕМ ВООБЩЕ. В v8.9p я отложил выгрузку чёрного ящика на
 *    «пару секунд, когда питание выправится» — и все пять сбросов в вашем логе
 *    оборвались РОВНО на строке «ящик: выгружаю во flash отметок …», то есть на
 *    стирании сектора. Стирание — это ~50 мс, за них батарея садится ниже порога
 *    внешней схемы, и та сбрасывает чип по RUN. Поэтому:
 *      – в игре во flash не пишем НИЧЕГО (ни чёрный ящик, ни «какая игра»);
 *      – «какая игра» пишется в СПИСКЕ ИГР — в момент выбора, пока эмулятор ещё не
 *        запущен (экран списка статичен, звук молчит) — или при выключении, если
 *        питание в тот момент было просевшим;
 *      – любая запись в flash идёт «тихо»: на время стирания гаснет подсветка и
 *        глушится усилитель (главные потребители). Экран на 0,1–0,6 с темнеет —
 *        это плата за то, что консоль не выключается;
 *      – автосброс нагрузки работает ЗАРАНЕЕ: мягкий порог 3,55 В роняет панель
 *        125 -> 62,5 -> 41,7 МГц (клавиша a — выключить);
 *      – если батарея при включении ниже нормы, панель сразу идёт на 62,5 МГц;
 *      – отчёт о причине сброса больше не валит всё на сторожа: если сброс пришёл по
 *        выводу RUN, так и написано (раньше «перезагрузка от сторожа» печаталась
 *        просто потому, что сторож был заведён — это разные вещи).
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9p)
 *
 * 0) МЯГКИЙ СТАРТ И ЗАЩИТА ОТ ПРОСАДКИ ПИТАНИЯ. По логам с консоли (игры умирали
 *    через ~0,5 с после запуска) видно: сброс приходил ПО ВЫВОДУ RUN, защёлка питания
 *    держалась, а перед смертью ловушка ловила батарею 3,46 В при холостых 3,71 В.
 *    То есть умирает не программа, а питание — ровно в тот момент, когда нагрузка
 *    делает шаг вверх (ядро 100 %, панель 125 МГц, включился звук с усилителем).
 *    Сделано:
 *      – в обработчике просадки БОЛЬШЕ НЕТ записи во flash (было: перебор АЦП +
 *        выгрузка чёрного ящика = стирание и запись сектора на просевшем питании);
 *      – автоматические записи (автосейв, ящик, «какая игра») идут только при живом
 *        питании (порог 3,55 В); явные команды пользователя пишут всегда;
 *      – запуск игры flash не трогает вообще: «какая игра» пишется через 4 с, между
 *        кадрами (romStateTick);
 *      – мягкий старт: 0,4 с эмуляции без панели + вход громкости за 2 с;
 *      – мерка просадки: через 2,5 с после запуска игры в лог уходит «питание после
 *        запуска игры: X В (лучшее) .. Y В (худшее) => просадка Z мВ»;
 *      – автосброс нагрузки при просадке: панель 125 -> 62,5 МГц (клавиша a — вкл/выкл).
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9o)
 *
 * 0) НЕСКОЛЬКО ИГР В КОНСОЛИ (меню ROM'ов). Игры больше не вшиваются в прошивку:
 *    их кладёт в свою область flash Python-упаковщик tools/roms_pack/make_roms_uf2.py
 *    (пользователь запускает его сам, файлы никуда не уходят). Область фиксированная —
 *    0x100000…0x1FD000 (0x100000 — таблица игр, 0x101000 — «какая игра выбрана»,
 *    0x102000 — сами образы) — поэтому она НЕ сдвигается от размера прошивки, а
 *    прошивка её НИКОГДА не пишет: новый скетч не стирает ни игры, ни сейвы.
 *      Экран выбора: при включении (если игр больше одной) и по клавише c, а также
 *      через меню (m) — пункт GAMES. Управление: UP/DOWN — выбор, A — играть, B — назад.
 *      Сейвы SRAM — по игре: до SAVE_BANKS (4) ячеек, каждая узнаётся по CRC32 образа,
 *      так что у каждой игры свой сейв; сейв встроенной игры (rom.h) тоже не теряется.
 *      Износ flash: список игр не пишет во flash вообще, «какая игра» — один сектор и
 *      только при смене игры. Выключение на 3 с по-прежнему: сейв SRAM пишется перед ним.
 *
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ (8.9h)
 *
 * 0) ВЫВОД СТРОК ЧЕРЕЗ DMA (главное в 8.9m): ядро больше не ждёт панель. Было ~9 мс
 *    синхронного ожидания на кадр (в логе «из них синхронно 9,0 мс») — из-за этого игра
 *    шла на 75 % темпа и звук «подтормаживал». Теперь строка копируется в буфер и уходит
 *    через DMA, а ядро считает следующий кадр. Клавиша u — сравнить с прежним выводом.
 *
 * 0-0) ПРИЧИНА СМЕРТИ ЧЕРЕЗ 3 СЕКУНДЫ НАЙДЕНА (главное в 8.9k).
 *    Опыт: с выключенным ящиком (v8.9i, DOWN) и с ящиком «только в ОЗУ» (v8.9j, UP)
 *    консоль играет ДОЛГО (в UP — 4600+ кадров, меню, сейвстейты, автосейвы, штатное
 *    выключение). А с записью в ящик во flash — умирает на первом же кадре.
 *    В логе видно точно: запись страницы в НАЧАЛЕ цикла (панель свободна) проходит,
 *    а запись ВНУТРИ кадра (окно панели открыто) — и сразу сброс по RUN.
 *    Вывод: важна не сама запись во flash, а её МЕСТО: внутри открытого окна панели.
 *    Поэтому с v8.9k по умолчанию в игре во flash не пишем вообще (отметки в ОЗУ,
 *    во flash — при выключении), а режим START даёт выгрузку МЕЖДУ кадрами.
 *
 * 0-0) ЧЁРНЫЙ ЯЩИК: кольцо в ОЗУ (v8.9j).
 *    Опыт: с выключенным ящиком (режим DOWN) консоль играет нормально, а с включённым
 *    перезагружается по выводу RUN через доли секунды после начала игры. Ящик был
 *    единственным, кто трогал flash в игре: раз в 0,25 с запись страницы и раз в ~4 с
 *    СТИРАНИЕ СЕКТОРА. Теперь отметки идут в кольцо В ОЗУ, во flash — только страница
 *    без стираний, а всё кольцо уходит во flash при выключении и в отчёте о смерти.
 *    Проверки: UP при включении — ящик только в ОЗУ; A — как раньше (со стираниями).
 *
 * 0-1) ПРИБОР «ГДЕ ПАДАЕТ ПИТАНИЕ». Во всех запусках лог показывает одно и то же:
 *    защёлка питания (GPIO1) держится, снимали питание 0 раз, батарея 3,77 В, а
 *    сброс приходит ПО ВЫВОДУ RUN (HAD_RUN=1) через ~3 с после начала потока кадров.
 *    Значит питание, скорее всего, коротко проседает — мелко для внутреннего порога
 *    чипа (HAD_POR=0), но достаточно внешней схеме, чтобы дёрнуть RUN.
 *    Поэтому: батарея читается В ПРЕРЫВАНИИ ЗВУКА 2 777 раз в секунду (без ожидания
 *    АЦП!), минимум/максимум за 0,25 с и глубочайший провал за сеанс пишутся в каждую
 *    запись чёрного ящика, а при просадке ниже 3,46 В в лог уходит строка
 *    «ПРОСАДКА ПИТАНИЯ». Режим RIGHT при включении — «тихая панель» (SPI 20,8 МГц).
 *
 * ===========================================================================
 * ГЛАВНОЕ В ЭТОЙ ВЕРСИИ
 *
 * 1) ПИТАНИЕ — как в стоковой прошивке. Разобран дамп: сток при выключении
 *    сбрасывает пин GPIO1 (это ключ питания, «защёлка»), а GPIO12 — в 0.
 *    Именно поэтому после прошлой версии консоль «зависала»: xosc_dormant()
 *    останавливал кварц, ядро замирало, но защёлка держала питание.
 *      ВЫКЛЮЧЕНИЕ: зажать START (или MENU) ~1 с → отсчёт 3-2-1 → питание СНИМАЕТСЯ.
 *      ВКЛЮЧЕНИЕ : зажать START ~1 с — как в стоке (защёлка взводится кнопкой).
 *    Скетч первым делом, ещё до Serial, поднимает GPIO1 → питание держится.
 *
 * 2) СЕЙВЫ. Внутренняя память картриджа (SRAM) теперь сохраняется в flash
 *    и восстанавливается при включении — Zelda больше не начинается сначала.
 *    Автосейв раз в 30 с (если игра что-то записала), плюс при сбросе игры,
 *    выключении и по команде 'w'.
 *
 * 3) СКОРОСТЬ. Строка панели уходит прямо в FIFO SPI, ПО БАЙТУ. (В v8.5 строки
 *    грузились 32-битными словами — и терялось 3 байта из 4: FIFO 16-битная, одна
 *    запись = одна запись FIFO, при 8-битных кадрах это ровно один байт. Отсюда
 *    была «четверть картинки, ниже мусор».) Плюс:
 *      • ядро исполняется из ОЗУ (не из flash) — самый большой выигрыш;
 *      • в горячих циклах нет делений;
 *      • режим 30 кадр/с ('f') больше не гонит данные на пропущенных кадрах.
 *    ВАЖНО: Tools → Optimize → «Fastest (-O3)» и CPU Speed → 250 MHz.
 *
 * 4) ПАЛИТРА. 6 палитр ('g'), регулировки на ходу: '[' ']' яркость,
 *    '-' '=' контраст, 'i' инверсия оттенков, 'k' — экран проверки 4 оттенков.
 *
 * 5) ПОЛОСЫ. Экран всегда пишется целиком (240 строк), верх/низ — чёрные.
 * ===========================================================================
 *
 * 6) БЫСТРОЕ МЕНЮ по кнопке MENU (как в стоке!) — яркость, контраст, палитра,
 *    инверсия, сейвстейты (2 слота), сброс, тест звука, выход в игру.
 *    Управление: UP/DOWN — выбор, LEFT/RIGHT — значение, A — выполнить, B — выход.
 *    Удержание START или MENU 3 секунды — выключение (как в стоке, с отсчётом).
 *
 * 7) СЕЙВСТЕЙТЫ: мгновенное сохранение/загрузка в любой момент (2 слота во flash).
 *    Скетч печатает карту flash: сколько занято прошивкой, ROM, сейвами и сколько
 *    остаётся под другие игры (под мульти-ROM).
 *    В v7 исправлена причина «SAVED SLOT 1 -> EMPTY SLOT 1»: pico-sdk требует,
 *    чтобы запись во flash шла со смещения, кратного 256, и длиной, кратной 256.
 *    У нас структура gb_s = 16916 Б, и запись SRAM начиналась со смещения
 *    +20 байт от границы страницы — хвост структуры затирался началом SRAM.
 *    Теперь все записи идут целыми страницами через буфер-сборщик (см. ssSave).
 *
 * 8) ЗВУК. В стоке звук выходит ШИМ-ом на GPIO17 (слайс 0, TOP = 689, тишина —
 *    уровень 344), плюс есть подозрение, что усилитель разрешается пином GP20
 *    (сток опускает его в 0, когда пищит). У нас теперь работает настоящий APU
 *    Game Boy (файл apu_gb.h): 2 прямоугольных канала, волновой, шумовой,
 *    конверты, длина, свип, микшер NR50/NR51. Ядро peanut отдаёт нам регистры
 *    звука через хук ENABLE_SOUND/audio_write, а семплы считаются в прерывании
 *    по таймеру (22222 Гц) — независимо от скорости эмуляции.
 *    В меню: SOUND ON/OFF, VOLUME, AMP (уровень GP20 при включённом звуке).
 *    Клавиша z — проба звука (СПРЯТАНА, v8.9t): одно нажатие только предупреждает,
 *    запуск — повторным z в течение 5 с. Выход — кнопка A/B, любая клавиша терминала
 *    или 20 с без действий; ресет для выхода не нужен.
 *
 * КОМАНДЫ SERIAL (115200):   t тест кнопок   l обучение   p пауза   r сброс
 *   f 30 кадр/с   g палитра   k тест оттенков   i инверсия   [ ] яркость
 *   - = контраст   s статус   w сохранить SRAM   m меню
 *   1 / 2 сохранить сейвстейт в слот 1/2,  3 / 4 загрузить
 *   z z — проба звука (дважды! 6 опытов; выход — A/B или любая клавиша)   v статистика кадра
 *   j тест вывода (0 норма / 1 старый цикл / 2 без цветов / 3 без вывода)
 *   n интерлейс ядра (только опыты: картинка неполная, строк выходит вдвое меньше)
 *   x звук вкл/выкл
 *   b загрузчик BOOTSEL   q ВЫКЛЮЧИТЬ   h справка
 */

#include <Arduino.h>
#include <SPI.h>
#include <stdio.h>

#include "hardware/clocks.h"     // clk_peri: именно он ограничивал частоту SPI панели
#include "hardware/dma.h"        // в нём же приходят DREQ_* (hardware/regs/dreq.h)
#include "hardware/flash.h"
#include "hardware/irq.h"        // v9.3: приоритет прерывания таймера звука
#include "hardware/gpio.h"
#include "hardware/pwm.h"
#include "hardware/adc.h"                        // датчик питания: АЦП, канал 4 (GP29)
#include "hardware/spi.h"
#include "hardware/watchdog.h"   // сторож: если консоль встанет, она перезагрузится сама
#include "pico/time.h"

// Горячие функции вывода кладём в ОЗУ (секция .time_critical* -> .data в линкере
// arduino-pico): выборка команд из flash на каждой строке стоит десятки тактов, а
// строк у нас 216 за кадр. Макрос объявлен ЗДЕСЬ, до автопрототипов Arduino:
// иначе прототипы ниже по файлу не поймут, что это за слово.
#define GB_RAM __attribute__((section(".time_critical.gbfast")))

// ---- звук: свой APU подключаем к ядру (peanut умеет вызывать audio_* ) ----
// Хуки audio_read()/audio_write() объявлены и определены в apu_gb.h (см. конец
// файла). ВАЖНО: до #include "peanut_gb.h" в этом файле не должно быть НИ ОДНОГО
// оператора — ни объявления, ни определения. Arduino IDE перед сборкой вставляет
// автопрототипы всех функций в место первой «настоящей» строки файла, и если это
// окажется выше подключения ядра, сборка падает с
//     error: use of enum 'gb_error_e' without previous declaration.
// (Именно на это вы и наткнулись в первой сборке v7.)
#define APU_GB_PEANUT_HOOKS 1           // apu_gb.h отдаст ядру audio_read/audio_write
#include "apu_gb.h"
#define ENABLE_SOUND 1

