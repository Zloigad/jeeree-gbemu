static void drawButtonScreen(const char *head, uint16_t mask, const char *prompt) {
  uiClear(0);
  uiTextCentered(14, 4, head, 3);
  if (prompt) uiTextCentered(50, 4, prompt, 1);
  int x = 10;
  for (int i = 0; i < NBTN; i++) {
    if (!(mask & (1u << i))) continue;
    char num[4]; uint8_t gp = BTN_GPIO[i];
    if (gp >= 10) { num[0] = '0' + gp / 10; num[1] = '0' + gp % 10; num[2] = 0; }
    else { num[0] = '0' + gp; num[1] = 0; }
    uiText(x, 100, 5, num, 2);
    x += (gp >= 10 ? 2 : 1) * 4 * 5 + 10;
    if (x > MEM_W - 50) break;
  }
  for (int i = 0; i < NBTN; i++) {
    int bx = 12 + i * 24;
    uiRect(bx, 186, 18, 16, (mask & (1u << i)) ? 3 : 1);
  }
  uiPush();
}

