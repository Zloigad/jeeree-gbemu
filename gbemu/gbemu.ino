// ============================================================ низкий уровень SPI
static inline void csL(void) { digitalWrite(PIN_CS, LOW);  }
static inline void csH(void) { digitalWrite(PIN_CS, HIGH); }
static void wb(uint8_t b) { SPI.transfer(b); }
static void pushBytes(const uint8_t *b, size_t n) { SPI.transfer(b, nullptr, n); }  // ТОЛЬКО так!

static void cmdStart(uint8_t c) { csH(); digitalWrite(PIN_DC, LOW); csL(); wb(c); csH(); }
static void cmdParams(const uint8_t *d, size_t n) { csH(); digitalWrite(PIN_DC, HIGH); csL(); pushBytes(d, n); csH(); }
static void cmd1(uint8_t c) { cmdStart(c); }
static void cmd1p(uint8_t c, uint8_t v) { cmdStart(c); cmdParams(&v, 1); }

static void lcdWindow(int x0, int y0, int x1, int y1) {
  uint8_t b[4];
  cmd1(0x2A); b[0] = x0 >> 8; b[1] = x0; b[2] = x1 >> 8; b[3] = x1; cmdParams(b, 4);
  cmd1(0x2B); b[0] = y0 >> 8; b[1] = y0; b[2] = y1 >> 8; b[3] = y1; cmdParams(b, 4);
  cmd1(0x2C);
}

// v9.7.1: флаги кэша строк — ДО lcdInit (он их сбрасывает в конце)
static bool     rowsValid = false;   // хэшей ещё нет (первый кадр — шлём всё)
static bool     panelInited = false; // панель инициализирована (до lcdInit кадры в неё бессмысленны)
static void lcdInit(void) {
  pinMode(PIN_CS, OUTPUT);  digitalWrite(PIN_CS, HIGH);
  pinMode(PIN_DC, OUTPUT);  digitalWrite(PIN_DC, HIGH);
  pinMode(PIN_RST, OUTPUT); digitalWrite(PIN_RST, HIGH);

  digitalWrite(PIN_RST, HIGH); delay(100);
  digitalWrite(PIN_RST, LOW);  delay(100);
  digitalWrite(PIN_RST, HIGH); delay(200);

  cmd1(0x01); delay(150);
  cmd1(0x11); delay(10);
  cmd1p(0x3A, 0x55); delay(10);
  cmd1p(0x36, 0x60);
  { uint8_t d[4] = {0, 0, 0, 0xF0};    cmd1(0x2A); cmdParams(d, 4); }
  { uint8_t d[4] = {0, 0, 0x01, 0x40}; cmd1(0x2B); cmdParams(d, 4); }
  cmd1(0x21); delay(10);
  cmd1(0x13); delay(10);
  cmd1(0x29); delay(10);
  // v9.7.1: панель (пере)инициализирована — её GRAM это НЕ наш кэш строк
  // (там мог остаться кадр выключения: цифра отсчёта или шум). Кэш недействителен:
  // следующий кадр обязан уйти целиком. Именно из-за пропуска тут строк на экране
  // и оставались следы прошлого кадра до первого полного обновления.
  panelInited = true;
  rowsValid = false;
}

// ============================================================ вывод кадра (прямая запись)
// v8.5: НИКАКИХ очередей и никакого DMA — простая и проверенная схема:
//   1) открываем окно панели и держим CS низким;
//   2) ядро эмулятора отдаёт строку (коллбэк 144 раза) — сразу гоним её в SPI;
//   3) верх/низ экрана и добор строк — чёрные (ровно столько, сколько нужно);
//   4) ждём последний байт, поднимаем CS.
//
// Почему так, а не очередью, как в v8.0-v8.4: очередь из 4 буферов уезжала
// ПОЗЖЕ отрисовки и, если не успевала, строки просто пропускались, а кадр
// досыпался чёрным. Именно это и дало «чёрный экран» на v8.3/v8.4 (в логе
// кадра 2-11 видно: ядро 9,7 мс — строки не рисовались вовсе, а 17,8 мс ушло
// на 240 чёрных строк). Прямая запись так не умеет: строка или ушла, или в
// логе есть строка о сбое.
//
// Про предохранитель. В библиотеке (spi_write_blocking из pico-sdk) ожидание
// места в FIFO БЕЗ ограничения по времени: «шина всегда идёт с известной
// скоростью, значит, передача закончится за известное время». Но если FIFO
// перестанет пустеть (так бывает при неудачной смене частоты), плата замолчит
// навсегда — что мы и видели. Здесь у ожидания есть предел: сработает
// предохранитель, в логе появится строка, а консоль продолжит работать.
#define ROW_BYTES   (GAME_W * 2)       // байт в строке панели (240 точек по 2 байта)
#define TX_GUARD_US 3000UL             // предел ожидания FIFO (одна строка идёт 61 мкс)

static bool     frameOpen = false;      // кадр открыт (можем писать строки)
static uint32_t frameT0 = 0;            // начало кадра
static uint32_t frameUs = 0;            // сколько занял последний кадр
// --- «свидетели смерти» (v8.8) ---
static volatile uint32_t gBeat = 0;          // пульс главного цикла: время последнего витка
static volatile uint32_t gBeatN = 0;         // и число витков
static volatile bool     gBeatArm = false;   // детектор включаем, когда цикл уже идёт
static void faultTriggerNow(void);           // объявлен заранее: нужен из прерывания звука
static volatile bool     gStalled = false;   // залипание уже заметили (второй раз не кричим)
static volatile uint32_t frameLineCore = 0;  // до какой строки кадра дошло ЯДРО
static volatile uint8_t  gLcdOn = 0;         // был ли включён ЖК игры (для разбора смерти)
#define STALL_US 1200000UL                   // 1,2 с без витка цикла = залипло
static uint32_t frameRows = 0;          // строк учтено в этом кадре (отправлено + пропущено)
static uint32_t frameY = 0;             // позиция строки панели в этом кадре (0..240)
static uint32_t txRowAcc = 0;           // суммарное время записей (наша работа)
static uint32_t rowLoopAcc = 0, rowLoopN = 0;   // то же время и число строк — для статистики
static uint32_t spiWaitAcc = 0;                 // сколько ждали панель (в конце кадра и между кадрами)
static uint32_t spiCallAcc = 0, spiCalls = 0;   // запуск передач (для строки статистики)
static uint32_t txRowsOk = 0, txRowsFail = 0;   // строк ушло / не ушло
static uint32_t spiStuck = 0, spiStuckSeen = 0; // предохранитель сработал (счётчик сбрасывается после перезапуска)
static uint32_t spiRestarts = 0;                // сколько раз перезапускали шину за сеанс
static uint32_t txBytes = 0;                    // всего байт в панель
static uint32_t txBytesPrev = 0;                // для подсчёта байт за последний кадр
static uint32_t txBytesFrame = 0;               // сколько байт ушло в панель за последний кадр
static uint32_t gateWaits = 0, gateSkips = 0;   // ждали панель / пропустили кадр
static bool     spiHealthOk = true;             // SPI не перезапускался
static bool     drawThisDbg = false;            // был ли последний кадр с отрисовкой (для чёрного ящика)

// ============================================================ ВЫВОД СТРОК ЧЕРЕЗ DMA (v8.9m)
// Раньше строка уходила в панель СИНХРОННО: ядро по байту ждало место в FIFO и теряло
// на этом ~8-10 мс за кадр (в логе — «из них синхронно 9,0 мс»). Из-за этого игра шла на
// 75 % темпа, и звук «подтормаживал». Теперь строка копируется в буфер и уходит через
// DMA: шина везёт её САМА, а ядро в это время считает следующий кадр.
//
// ПОЧЕМУ ДВА БУФЕРА И ОДИН КАНАЛ. За одну передачу в шине находится ровно одна строка —
// так порядок строк в панели гарантирован при любом раскладе. Пока строка k уезжает, мы
// спокойно собираем строку k+1 во второй буфер, а перед запуском k+1 ждём окончания k.
// Если ядро считает быстрее, чем шина везёт, мы подождём (строка не потеряется), если
// шина быстрее — ожидания нет вовсе.
#define TX_DMA_BUF 2
static bool     txUseDma   = true;           // клавиша 'u' — сравнить с синхронным выводом
static bool     txDmaReady = false;
static int      txDmaCh    = -1;
static dma_channel_config txDmaCfg;
static uint8_t  txDmaBuf[TX_DMA_BUF][ROW_BYTES] __attribute__((aligned(4)));
static int      txDmaIdx   = 0;              // какой буфер заполняем следующим
static bool     txDmaArmed = false;          // в шине есть незавершённая передача
static uint32_t txDmaRows = 0, txDmaWaitAcc = 0, txDmaAborts = 0;

static void txDmaInit(void) {
  if (txDmaCh < 0) {
    txDmaCh = dma_claim_unused_channel(false);
    if (txDmaCh < 0) { txUseDma = false; txDmaReady = false; return; }
  }
  txDmaCfg = dma_channel_get_default_config(txDmaCh);
  channel_config_set_transfer_data_size(&txDmaCfg, DMA_SIZE_8);   // 8 бит на кадр: байт = байт в панель
  channel_config_set_read_increment(&txDmaCfg, true);             // читаем буфер подряд
  channel_config_set_write_increment(&txDmaCfg, false);           // пишем всегда в DR
  channel_config_set_dreq(&txDmaCfg, spi_get_dreq(spi0, true));   // по запросу «передать» от SPI
  channel_config_set_irq_quiet(&txDmaCfg, true);                  // прерывания не нужны
  spi_get_hw(spi0)->dmacr |= 1u;                                  // TXDMAE: шина тянет данные из DMA
  txDmaReady = true;
}

// Ждём завершения передачи — ОГРАНИЧЕННО по времени. Если DMA не кончился, это сбой
// (тот же предохранитель, что и в синхронном пути): сбрасываем канал, считаем потерю и
// говорим в лог. Без этого «вставший» DMA означал бы вечное ожидание.
static bool txDmaWait(uint32_t us) {
  const uint32_t t0 = micros();
  uint32_t spins = 0;
  while (dma_channel_is_busy(txDmaCh)) {
    if ((++spins & 0x3FFu) == 0 && (uint32_t)(micros() - t0) > us) return false;
    tight_loop_contents();
  }
  return true;
}

static void txDmaFail(void) {
  dma_channel_abort(txDmaCh);
  txDmaArmed = false;
  txDmaAborts++; spiStuck++; txRowsFail++;
  spiHealthOk = false;
}

// Одна строка через DMA. Копировать в буфер можно смело: его использовала передача
// ДВЕ назад, а она уже завершилась (мы всегда ждём окончания перед запуском следующей).
static bool txRowDma(const uint8_t *p, size_t n) {
  const uint32_t t0 = micros();
  const int idx = txDmaIdx;
  txDmaIdx ^= 1;
  memcpy(txDmaBuf[idx], p, n);
  if (txDmaArmed) {
    const uint32_t w0 = micros();
    if (!txDmaWait(TX_GUARD_US)) { txDmaFail(); return false; }
    txDmaWaitAcc += micros() - w0;
  }
  dma_channel_configure(txDmaCh, &txDmaCfg, &spi_get_hw(spi0)->dr, txDmaBuf[idx], (uint)n, true);
  txDmaArmed = true;
  txDmaRows++; txRowsOk++; txBytes += n;
  txRowAcc += micros() - t0;
  return true;
}

static inline bool txStuck(void) { return spiStuck != 0; }
static inline const char *txTag(void) { return txStuck() ? "прямой путь (был сбой)" : "прямой путь"; }
static inline const char *txPathName(void) {
  if (txUseDma && txDmaReady) {
    if (txStuck())    return "DMA строк (был сбой!)";
    if (!spiHealthOk) return "DMA строк (SPI перезапущен)";
    return "DMA строк (двойной буфер)";
  }
  if (txStuck())     return "прямая запись (был сбой SPI!)";
  if (!spiHealthOk)  return "прямая запись (SPI перезапущен)";
  return "прямая запись строк (проверенная)";
}

static void txCheckHealth(void);          // объявлен заранее: вызывается из конца кадра

// Одна строка панели: пишем 480 байт прямо в FIFO SPI, ждём место ограниченно.
//
// ВАЖНО И НЕОЧЕВИДНО (на этом v8.5 и потерял картинку). FIFO у SPI на RP2040
// 16-битная, а регистр данных отдаёт ОДНУ запись FIFO на одну операцию записи.
// При 8-битных кадрах (наш случай) сдвигаются только младшие 8 бит записи.
// Поэтому запись 32-битными словами (как было в v8.5) отправляла в панель
// РОВНО ОДИН БАЙТ ИЗ ЧЕТЫРЁХ: до панели доходила каждая четвёртая точка, кадр
// обрывался на четверти экрана, а остальное оставалось старым мусором — снаружи
// это выглядит как «сверху кусок картинки, ниже цветной шум». Проверяется
// арифметикой: кадр укладывался в 13,6 мс, хотя одни только 115 200 байт при
// 62,5 МГц занимают 14,7 мс.
// Поэтому пишем ПО БАЙТУ — ровно так, как это делает проверенный
// spi_write_blocking() из pico-sdk.
static bool txRow(const uint8_t *p, size_t n) {
  if (txUseDma && txDmaReady) return txRowDma(p, n);      // v8.9m: строку увозит DMA
  const uint32_t t0 = micros();
  for (size_t i = 0; i < n; i++) {
    uint32_t spins = 0;
    while (!spi_is_writable(spi0)) {
      // ВАЖНО (здесь была дыра!). Раньше время проверялось по НОМЕРУ БАЙТА — раз в
      // 64 байта. Но если FIFO встанет НА СЕРЕДИНЕ байта, номер не меняется, и
      // проверка не срабатывает никогда: цикл висит вечно, сбой не считается и в
      // лог ничего не пишется. Теперь считаем ОБОРОТЫ ожидания — предохранитель
      // срабатывает всегда, а шина перезапускается сама.
      if ((++spins & 0x1FFu) == 0 && (uint32_t)(micros() - t0) > TX_GUARD_US) {
        spiStuck++; txRowsFail++; return false;
      }
      tight_loop_contents();
    }
    spi_get_hw(spi0)->dr = p[i];     // один байт = одна запись FIFO = один байт в панель
  }
  txRowAcc += micros() - t0;
  txRowsOk++;
  txBytes += n;
  return true;
}

// подождать, пока шина освободится (ограниченно!)
static bool txWaitIdle(uint32_t us) {
  const uint32_t t0 = micros();
  while (spi_is_busy(spi0)) {
    if (micros() - t0 > us) return false;
    tight_loop_contents();
  }
  return true;
}

// ============================================================
// v9.5: КАДРОВЫЙ ДИФФ — шлём только изменившиеся строки.
// Наводка от шины панели пропорциональна трафику: полосы, HUD и статичные зоны
// не меняются кадр от кадра — гнать их в панель каждый раз незачем. Строка
// сравнивается с прошлым кадром по хэшу её ГОТОВЫХ байтов (и палитра, и
// масштаб уже учтены: смена палитры/яркости сама перерисует нужное).
// Пропуски ломают автоинкремент курсора панели, поэтому строки идут СЕРИЯМИ:
// у каждой серии своё окно lcdWindow(0, y0, 239, 239); разрыв — новое окно.
static uint32_t rowHash[MEM_H];     // хэш готовых байтов строки из прошлого кадра
static uint32_t frameSkip = 0;      // пропущено (не менялись) в этом кадре
static uint32_t txRowsSkip = 0;     // всего пропущено за сеанс
static int      runY0 = -1;         // начало открытой серии строк (-1 = серии нет)
static int      runNextY = -1;      // следующая строка, которую ждёт открытая серия

static uint32_t rowHashOf(const uint8_t *p) {
  // буферы строк выровнены, ROW_BYTES кратно 4 — хэш по 32-битным словам
  const uint32_t *w = (const uint32_t *)(const void *)p;
  uint32_t h = 2166136261u;
  for (int i = 0; i < ROW_BYTES / 4; i++) { h ^= w[i]; h *= 16777619u; }
  return h;
}

// закрыть серию строк: дождаться шину и поднять CS
static void runClose(void) {
  if (runY0 < 0) return;
  if (txDmaArmed) {
    const uint32_t w0 = micros();
    if (!txDmaWait(TX_GUARD_US)) txDmaFail(); else txDmaArmed = false;
    txDmaWaitAcc += micros() - w0;
  }
  txWaitIdle(TX_GUARD_US);
  csH();
  runY0 = -1; runNextY = -1;
}

// Одна строка панели на своё место кадра. Неизменившуюся ПРОПУСКАЕМ: место в
// кадре всё равно занято (счётчики идут всегда), панель помнит её сама.
static bool txRowY(const uint8_t *p) {
  const int y = (int)frameY;
  if (y >= MEM_H) return true;
  frameY++; frameRows++;                                   // позиция занята в любом случае
  const uint32_t h = rowHashOf(p);
  const bool changed = !rowsValid || h != rowHash[y];
  rowHash[y] = h;
  if (!changed) { frameSkip++; txRowsSkip++; return true; }
  if (runY0 < 0 || runNextY != y) {                        // разрыв серии или её начало
    runClose();
    lcdWindow(0, y, MEM_W - 1, MEM_H - 1);
    digitalWrite(PIN_DC, HIGH); csL();
    runY0 = y;
  }
  if (!txRow(p, ROW_BYTES)) return false;                  // сбой уже посчитан
  runNextY = y + 1;
  return true;
}

// начать кадр (v9.5: окна панели открываются сериями строк — см. txRowY)
static void frameStart(void) {
  mark(PH_WINDOW);
  frameOpen = true; frameRows = 0; frameY = 0; frameSkip = 0;
  runY0 = -1; runNextY = -1;
  frameT0 = micros();
  mark(PH_DRAW);
}

// чёрные строки в начале/конце кадра и добор до конца экрана
static void rowBl(int n) {
  static const uint8_t zeros[ROW_BYTES] __attribute__((aligned(4))) = {0};
  while (n-- > 0) {
    if (!txRowY(zeros)) return;                            // сбой уже посчитан
  }
}

// закрыть кадр: дождаться последнего байта и поднять CS
static void frameFinish(void) {
  mark(PH_FINISH);
  runClose();                                              // v9.5: закрыть последнюю серию строк
  if (txDmaArmed) {                                        // последняя строка кадра
    const uint32_t w0 = micros();
    if (!txDmaWait(TX_GUARD_US)) txDmaFail(); else txDmaArmed = false;
    txDmaWaitAcc += micros() - w0;
  }
  txWaitIdle(TX_GUARD_US);
  csH();
  rowsValid = true;                                        // v9.5: хэши собраны — дальше кадр в кадр
  frameOpen = false;
  frameUs = micros() - frameT0;
  txBytesFrame = txBytes - txBytesPrev;                // сколько реально ушло в панель
  txBytesPrev = txBytes;
  // Приёмный FIFO мы не читаем (панель ничего не отвечает), поэтому он переполняется.
  // Передаче это не мешает, но флаг переполнения лучше снять — так делает SDK в конце
  // spi_write_blocking(). Заодно подхватываем сбой шины, если он случился.
  uint32_t x = 0;
  while (spi_is_readable(spi0) && x++ < 64) (void)spi_get_hw(spi0)->dr;
  if (spiStuck != spiStuckSeen) txCheckHealth();
}

// Печать строки, которая НИКОГДА не встанет. Serial.print() блокирующий: если
// хост не читает (терминал закрыт, USB не вычерпан), он ждёт бесконечно — и
// прошивка выглядит «зависшей». Здесь: нет места в буфере — строку пропускаем и
// считаем пропуски (их видно в статусе 's' и в записи чёрного ящика).
static void traceLine(const char *line) {
  const int n = (int)strlen(line);
  if (Serial.availableForWrite() >= n + 1) {
    Serial.write((const uint8_t *)line, n);
    Serial.write('\n');
  } else {
    txDroppedLines++;
  }
}

// Проверка здоровья SPI. Раньше на этом месте была смена пути вывода и попытка
// «дожать» DMA. Теперь: если предохранитель сработал — перезапускаем SPI.
// ВАЖНО: при смене частоты arduino-pico делает spi_deinit + spi_init, и если
// между ними в FIFO остался байт, шина может встать навсегда. Поэтому сначала
// ждём тишину (ограниченно!), потом меняем частоту.
static void txCheckHealth(void) {
  if (!txStuck() || spiStuck == spiStuckSeen) return;
  spiStuckSeen = spiStuck;
  Serial.println(F("!! SPI панели встал: FIFO не освободился. Перезапускаю шину, продолжаю работу."));
  Serial.print(F("   потеряно строк ")); Serial.print(txRowsFail);
  Serial.print(F(", кадр ")); Serial.print(gFramesTotal);
  Serial.println(F(" — пришлите эту строку, разберусь."));
  txWaitIdle(TX_GUARD_US);
  SPI.endTransaction();                            // spi_deinit: сброс периферии
  SPI.beginTransaction(SPISettings(SPI_HZ, MSBFIRST, SPI_MODE0));
  {                                                // вычерпать мусор из FIFO
    uint32_t x = 0;
    while (spi_is_readable(spi0) && x++ < 64) (void)spi_get_hw(spi0)->dr;
  }
  spiHealthOk = false;
  spiRestarts++;
  spiStuck = 0; spiStuckSeen = 0;                  // шлейф сбоя не тянем: шина перезапущена
  Serial.println(F("   шина перезапущена (в статусе это видно как «шина перезапускалась»)."));
}

// ============================================================ частота SPI панели
// В дампе стока рядом с адресом SPI0 (0x4003C000) лежит литерал 100 000 000 —
// похоже, панель у стока работала на 100 МГц. Ровно 100 из 250 МГц получить
// нельзя (делитель 2,5 не существует), поэтому набор: 62,5 -> 125 -> 20,8.
// По умолчанию 62,5: этот режим уже проверен на вашей консоли.
static const uint32_t SPI_HZ_TAB[] = { 125000000UL, 62500000UL, 41666667UL, 20833333UL };
// v8.9q: имена РАНЬШЕ были сдвинуты (NAME[0]="62,5" при TAB[0]=125 МГц) — из-за этого
// лог врал: после перехода на 62,5 МГц печаталось «сейчас 125». Теперь имя = своей частоте.
static const char *SPI_HZ_NAME[]    = { "125", "62,5", "41,7", "20,8" };
static uint8_t spiHzIdx = 0;        // v9.7: по умолчанию 125 МГц (ровные 60 кадр/с, как сток); 'o' — цикл, выбор помнится

// Поднять периферийную частоту до системной: SPI не может быть быстрее clk_peri/2,
// а на устройстве clk_peri оказался 48 МГц — поэтому любые просьбы давали ровно 24 МГц.
static void spiRaisePeriClock(void) {
  const uint32_t sys = clock_get_hz(clk_sys);
  Serial.print(F("часы: системная ")); Serial.print(sys / 1000000.0f, 1);
  Serial.print(F(" МГц, периферийная ")); Serial.print(clock_get_hz(clk_peri) / 1000000.0f, 1);
  Serial.println(F(" МГц"));
  if (clock_get_hz(clk_peri) < sys) {
    clock_configure(clk_peri, 0, CLOCKS_CLK_PERI_CTRL_AUXSRC_VALUE_CLK_SYS, sys, sys);
    Serial.print(F("часы: периферийную поднял до ")); Serial.print(clock_get_hz(clk_peri) / 1000000.0f, 1);
    Serial.println(F(" МГц (SPI больше не ограничен 24 МГц)"));
  }
}

// Сменить частоту панели. ВАЖНО: arduino-pico при смене частоты делает
// spi_deinit + spi_init. Если в этот момент в FIFO остался непереданный байт,
// шина может встать навсегда (у нас так и было). Поэтому: сначала ждём тишину
// с ограничением, потом меняем, потом вычерпываем остатки FIFO.
static void spiSetClock(uint32_t hz) {
  const bool idle = txWaitIdle(TX_GUARD_US);
  if (!idle) Serial.println(F("!! панель не успела доработать кадр — на всякий случай всё равно меняю частоту"));
  SPI.endTransaction();
  SPI.beginTransaction(SPISettings(hz, MSBFIRST, SPI_MODE0));   // тут SPI переинициализируется
  { uint32_t x = 0; while (spi_is_readable(spi0) && x++ < 64) (void)spi_get_hw(spi0)->dr; }
  spiStuckSeen = spiStuck;                       // сбои до смены частоты уже отчитаны
  const uint32_t got = spi_get_baudrate(spi0);
  Serial.print(F("SPI панели: просили ")); Serial.print(hz / 1000000.0f, 1);
  Serial.print(F(" МГц, получилось "));    Serial.print(got / 1000000.0f, 1);
  Serial.print(F(" МГц (клавиша o — дальше, сейчас ")); Serial.print(SPI_HZ_NAME[spiHzIdx]); Serial.println(F(")"));
  if (got < hz * 9 / 10)
    Serial.println(F("!! меньше запрошенного: частоту ограничивает clk_peri — см. строку «часы:»"));
  if (panelInited) {
    uiClear(0); uiPush();                      // сразу видно, держит ли панель эту частоту
  }                                            // v9.7.1: до инициализации панели кадр не шлём —
                                               // он «закрывал» кэш строк, и стартовая зачистка
                                               // экрана пропускалась (оставались следы прошлого кадра)
}

// ============================================================ кадровый буфер интерфейса
// интерфейс (меню/тесты/заставка) рисуем байтовыми индексами оттенка 0..3
static uint8_t uiBuf[MEM_W * MEM_H];

// печать строки 3x5 в буфер интерфейса (шрифт 3x5, sc = размер)
struct Glyph { char c; uint8_t rows[5]; };
static const Glyph FONT[] = {
