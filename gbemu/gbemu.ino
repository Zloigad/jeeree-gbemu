  {'*', {0, 0b101, 0b010, 0b101, 0}}, {'_', {0, 0, 0, 0, 0b111}},
  {'\'', {0b010, 0b010, 0, 0, 0}},
};
static const uint8_t *glyph(char c) {
  if (c >= 'a' && c <= 'z') c -= 32;
  const uint8_t *miss = 0;
  for (unsigned i = 0; i < sizeof(FONT) / sizeof(FONT[0]); i++) {
    if (FONT[i].c == c) return FONT[i].rows;
    if (FONT[i].c == '?') miss = FONT[i].rows;
  }
  // v8.9u: неизвестный знак — '?', а не последний глиф таблицы ('=' раньше
  // превращал каждую Z в полоски и молча прятал проблему).
  return miss ? miss : FONT[0].rows;
}
static void uiClear(uint8_t shade) { memset(uiBuf, shade, sizeof(uiBuf)); }
static void uiText(int x, int y, int sc, const char *s, uint8_t shade) {
  for (; *s; s++) {
    const uint8_t *g = glyph(*s);
    for (int r = 0; r < 5; r++)
      for (int c = 0; c < 3; c++) {
        if (!((g[r] >> (2 - c)) & 1)) continue;
        for (int dy = 0; dy < sc; dy++)
          for (int dx = 0; dx < sc; dx++) {
            int px = x + c * sc + dx, py = y + r * sc + dy;
            if (px >= 0 && py >= 0 && px < MEM_W && py < MEM_H) uiBuf[py * MEM_W + px] = shade;
          }
      }
    x += 4 * sc;
  }
}
static void uiTextCentered(int y, int sc, const char *s, uint8_t shade) {
  int len = 0; for (const char *p = s; *p; p++) len++;
  uiText((MEM_W - len * 4 * sc) / 2, y, sc, s, shade);
}
static void uiRect(int x, int y, int w, int h, uint8_t shade) {
  for (int j = 0; j < h; j++) {
    if (y + j < 0 || y + j >= MEM_H) continue;
    for (int i = 0; i < w; i++) {
      int px = x + i;
      if (px < 0 || px >= MEM_W) continue;
      uiBuf[(y + j) * MEM_W + px] = shade;
    }
  }
}

// отправить весь uiBuf на экран
static void uiPush(void) {
  mark(PH_UI);
  frameStart();
  for (int r = 0; r < MEM_H; r++) {
    const uint8_t *src = &uiBuf[r * MEM_W];
    uint16_t *w = (uint16_t *)uiRow();
    if (!w) break;
    for (int x = 0; x < MEM_W; x++) w[x] = uiColSw[src[x] & 3];
    uiRowSend();
  }
  frameFinish();
}

// -------- диагностика: сколько пикселей каждого слоя и оттенка даёт ядро --------
static int      diagFrames = 0;
static uint32_t diagCnt[4][4];              // [метка слоя][оттенок]

// --- клавиша t: «почему экран чёрный» -------------------------------------
// Печатает каждую 8-ю строку кадра: сколько точек какого слоя пришло от ядра и
// сколько строк панели из неё ушло (з=0 значит НЕ ушло), а раз в 32 строки —
// состояние ЖК-контроллера игры: включён ли он, где луч, какие палитры, где PC.
static void drawDiagLine(struct gb_s *g, const uint8_t *px, int line) {
  if ((line & 7) != 0) return;
  int bg = 0, win = 0, sp = 0;
  for (int i = 0; i < 160; i++) {
    const uint8_t v = px[i];
    if (v & 0x20) sp++;
    else if (v & 0x10) win++;
    else if (v & 0x03) bg++;
  }
  Serial.print(F("стр ")); Serial.print(line);
  Serial.print(F(": л=")); Serial.print(bg);
  Serial.print(F(" о="));  Serial.print(win);
  Serial.print(F(" п="));  Serial.print(sp);
  Serial.print(F(" з="));  Serial.print(frameRows);
  if ((line & 31) == 24) {
    Serial.print(F("  ЖК: LCDC=0x")); Serial.print(g->hram_io[IO_LCDC], HEX);
    Serial.print(F(" STAT=0x"));      Serial.print(g->hram_io[IO_STAT], HEX);
    Serial.print(F(" LY="));          Serial.print((int)g->hram_io[IO_LY]);
    Serial.print(F(" SCY="));         Serial.print((int)g->hram_io[IO_SCY]);
    Serial.print(F(" SCX="));         Serial.print((int)g->hram_io[IO_SCX]);
    Serial.print(F(" BGP=0x"));       Serial.print(g->hram_io[IO_BGP], HEX);
    Serial.print(F(" PC=0x"));        Serial.print((uint32_t)g->cpu_reg.pc.reg, HEX);
  }
  Serial.println();
}

// настоящая скорость шины по факту: Мбит/с
static float rateMbit(uint32_t bytes, uint32_t us) {
  if (!us) return 0.0f;
  return (float)((double)bytes * 8000000.0 / (double)us / 1000000.0);
}

// «Правда о шине»: что реально стоит в регистрах SPI (а не то, что мы просили).
static void printSpiTruth(void) {
  const uint32_t peri = clock_get_hz(clk_peri);
  const uint32_t cpsr = spi_get_hw(spi0)->cpsr;
  const uint32_t cr0  = spi_get_hw(spi0)->cr0;
  const uint32_t scr  = ((cr0 & 0x0000FF00u) >> 8) + 1;   // делитель = SCR+1
  const uint32_t baud = spi_get_baudrate(spi0);
  Serial.print(F("шина: clk_peri ")); Serial.print(peri / 1000000.0f, 1);
  Serial.print(F(" МГц, CPSR ")); Serial.print(cpsr);
  Serial.print(F(", SCR ")); Serial.print(scr);
  Serial.print(F(" -> ")); Serial.print(baud / 1000000.0f, 1);
  Serial.print(F(" МГц; dmacr=0x")); Serial.print(spi_get_hw(spi0)->dmacr, HEX);
  Serial.print(F(", sr=0x")); Serial.println(spi_get_hw(spi0)->sr, HEX);
  Serial.println(F("(8 бит на кадр: одна запись в FIFO = ровно один байт в панель)"));
}

// --- клавиша j: тест самой панели (без эмулятора) --------------------------
// Заливаем экран четырьмя полосами оттенков палитры. Если полосы видно, а игра
// чёрная — значит панель и SPI живы, дело в данных от ядра (тогда клавиша t).
// Если и полос не видно — дело в панели или шине (тогда клавиша e).
static void panelTest(void) {
  Serial.println(F("--- ТЕСТ ПАНЕЛИ (j): четыре полосы оттенков палитры ---"));
  printSpiTruth();
  rowsValid = false;                 // v9.5: диагностика показывает КАЖДУЮ строку (без кадрового диффа)
  frameStart();
  for (int r = 0; r < MEM_H; r++) {
    const uint16_t c = uiColSw[(r * 4) / MEM_H];      // 0..3: полосы от светлого к тёмному
    uint16_t *w = (uint16_t *)uiRow();
    if (!w) break;
    for (int x = 0; x < MEM_W; x++) w[x] = c;
    uiRowSend();
  }
  frameFinish();
  Serial.print(F("отправил ")); Serial.print(frameRows);
  Serial.print(F(" строк, ")); Serial.print(txBytesFrame);
  Serial.print(F(" байт, кадр ")); Serial.print(frameUs / 1000.0f, 1);
  Serial.print(F(" мс = ")); Serial.print(rateMbit(txBytesFrame, frameUs), 2);
  Serial.println(F(" Мбит/с (это и есть настоящая скорость шины)"));
  if (frameRows != MEM_H) Serial.println(F("!! строк ушло не 240 — панель не приняла часть кадра"));
  Serial.println(F("Если полос не видно — панель или шина, клавиша e; если видно — дело в игре."));
}

