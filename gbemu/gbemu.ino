  {'2', {0b111, 0b001, 0b111, 0b100, 0b111}}, {'3', {0b111, 0b001, 0b111, 0b001, 0b111}},
  {'4', {0b101, 0b101, 0b111, 0b001, 0b001}}, {'5', {0b111, 0b100, 0b111, 0b001, 0b111}},
  {'6', {0b111, 0b100, 0b111, 0b101, 0b111}}, {'7', {0b111, 0b001, 0b001, 0b001, 0b001}},
  {'8', {0b111, 0b101, 0b111, 0b101, 0b111}}, {'9', {0b111, 0b101, 0b111, 0b001, 0b111}},
  {'A', {0b111, 0b101, 0b111, 0b101, 0b101}}, {'B', {0b110, 0b101, 0b110, 0b101, 0b110}},
  {'C', {0b111, 0b100, 0b100, 0b100, 0b111}}, {'D', {0b110, 0b101, 0b101, 0b101, 0b110}},
  {'E', {0b111, 0b100, 0b110, 0b100, 0b111}}, {'F', {0b111, 0b100, 0b110, 0b100, 0b100}},
  {'G', {0b111, 0b100, 0b101, 0b101, 0b111}}, {'H', {0b101, 0b101, 0b111, 0b101, 0b101}},
  {'I', {0b111, 0b010, 0b010, 0b010, 0b111}}, {'K', {0b101, 0b101, 0b110, 0b101, 0b101}},
  {'L', {0b100, 0b100, 0b100, 0b100, 0b111}}, {'M', {0b101, 0b111, 0b111, 0b101, 0b101}},
  {'N', {0b101, 0b111, 0b111, 0b111, 0b101}}, {'O', {0b111, 0b101, 0b101, 0b101, 0b111}},
  {'P', {0b111, 0b101, 0b111, 0b100, 0b100}}, {'R', {0b111, 0b101, 0b111, 0b110, 0b101}},
  {'S', {0b111, 0b100, 0b111, 0b001, 0b111}}, {'T', {0b111, 0b010, 0b010, 0b010, 0b010}},
  {'U', {0b101, 0b101, 0b101, 0b101, 0b111}}, {'V', {0b101, 0b101, 0b101, 0b101, 0b010}},
  {'W', {0b101, 0b101, 0b111, 0b111, 0b101}}, {'X', {0b101, 0b101, 0b010, 0b101, 0b101}},
  {'Y', {0b101, 0b101, 0b010, 0b010, 0b010}},
  {' ', {0, 0, 0, 0, 0}}, {'-', {0, 0, 0b111, 0, 0}}, {':', {0, 0b010, 0, 0b010, 0}},
  {'+', {0, 0b010, 0b111, 0b010, 0}}, {'?', {0b111, 0b001, 0b011, 0, 0b010}},
  {'/', {0b001, 0b001, 0b010, 0b100, 0b100}}, {'!', {0b010, 0b010, 0b010, 0, 0b010}},
  {'%', {0b101, 0b001, 0b010, 0b100, 0b101}}, {'=', {0, 0b111, 0, 0b111, 0}},
  // v8.9u: не хватало букв J Q Z (из-за этого ZELDA выглядела как полоски),
  // скобок (SOUND PROBE (6 TESTS)), точки/подчёркивания (имена файлов),
  // запятой (экран оттенков 'k'), звёздочки (маркер текущей игры) и апострофа.
