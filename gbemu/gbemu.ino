// ============================================================ сторож и «где встали»
// Зачем: если прошивка где-то встанет (зависший цикл, аварийное исключение), раньше
// это выглядело как «чёрный экран и всё», и консоль оживлялась только выдёргиванием
// батарейки. Теперь работает сторожевой таймер: 4 секунды без «кормления» — консоль
// перезагружается сама (GPIO1 защёлкивается в самом начале setup, питание остаётся).
//
// А чтобы знать, ГДЕ встало, на каждом шаге пишем в scratch-регистры сторожа
// (они сохраняются при перезагрузке): номер фазы, сколько кадров прошло и сколько
// секунд прожили. При следующем старте всё это печатается в лог.
// ВАЖНО: scratch[4] занят самим pico-sdk (его магия для watchdog_enable),
// поэтому используем 0, 1, 2 и 3.
#define PH_BOOT     1
#define PH_LOOP     2
#define PH_CORE     3     // внутри ядра эмулятора (gb_run_frame)
#define PH_DRAW     4     // внутри коллбэка отрисовки строки
#define PH_FINISH   5     // добиваем/ждём панель в конце кадра
#define PH_SAVE     6     // запись SRAM во flash
#define PH_SSAVE    7     // запись сейвстейта
#define PH_UI       8     // отрисовка экрана интерфейса (меню/отсчёт)
#define PH_HOLD     9     // обработка удержания кнопки
#define PH_PROBE    10    // проба звука / обучение кнопок
#define PH_POWER    11    // выключение питания
#define PH_POWERCUT 12    // питание уже снимаем (это НЕ зависание)
#define PH_SERIAL   13
#define PH_STATUS   14    // печать строки статистики
#define PH_TXSYNC   15    // синхронная отправка 8 строк (3840 Б) в SPI панели
#define PH_WINDOW   16    // открытие окна панели (CS/DC)
#define PH_DRAIN    17    // ждём панель (прошлый кадр ещё уезжает)
#define PH_UIWAIT   18    // ждём место в очереди (экран интерфейса)
#define PH_HELP     19    // печать справки/команд
#define PH_SNDISR   20    // внутри прерывания звука
#define PH_KEYS     21    // читаем кнопки
#define PH_BB       22    // пишем в «чёрный ящик» (flash)
#define PH_TRACE    23    // печатаем след кадра
#define PH_GATE     24    // ждём панель перед началом кадра
#define PH_FAULT    25    // аппаратный сбой (HardFault): пойман своим обработчиком
#define PH_STALL    26    // цикл залип, а звук продолжал идти
#define PH_DIP      27    // ловушка питания: просадка на ходу

// Сколько строк следа НЕ напечаталось (USB-буфер был занят) и печать без ожидания.
// Объявлено здесь, потому что нужно и трассе кадра, и чёрному ящику.
static uint32_t txDroppedLines = 0;
static void traceLine(const char *line);

#define WD_MS       4000                        // окно сторожа
#define WD_MAGIC    0x47425A31UL                // "GBZ1" — наши отметки в scratch валидны
#define WD_POWER    0x504F4631UL                // "POF1" — было запрошено снятие питания
// ВАЖНО: если отметка «снимаю питание» стоит, то любая перезагрузка — это выключение,
// а не зависание. Отдельная ячейка (scratch[5]) нужна потому, что если питание почему-то
// НЕ снялось, код идёт дальше и фаза снова становится «начало кадра».

static volatile uint32_t gPhase = PH_BOOT;
static uint32_t gFramesTotal = 0;               // всего кадров с загрузки
static uint32_t gSlowFrames = 0;                // кадров дольше 30 мс

static inline void wdtFeed(void) { watchdog_update(); }
static inline void mark(uint32_t phase) {
  gPhase = phase;
  watchdog_hw->scratch[0] = phase;
  watchdog_hw->scratch[1] = gFramesTotal;
  watchdog_hw->scratch[3] = WD_MAGIC;           // сразу же: отметки валидны (даже если не прожили секунду)
}
static void markTick(void) {                    // раз в секунду: сколько прожили
  watchdog_hw->scratch[2] = millis() / 1000;
}
static inline void wdtTick(void) { wdtFeed(); }

static const char *phaseName(uint32_t p) {
  switch (p) {
    case PH_BOOT:     return "загрузка";
    case PH_LOOP:     return "начало кадра";
    case PH_CORE:     return "ядро эмулятора (gb_run_frame)";
    case PH_DRAW:     return "вывод строки на панель";
    case PH_FINISH:   return "завершение кадра (панель)";
    case PH_SAVE:     return "запись SRAM во flash";
    case PH_SSAVE:    return "запись сейвстейта";
    case PH_UI:       return "экран интерфейса (меню/отсчёт)";
    case PH_HOLD:     return "удержание кнопки";
    case PH_PROBE:    return "проба звука/обучение кнопок";
    case PH_POWER:    return "выключение питания";
    case PH_POWERCUT: return "снятие питания (штатное выключение)";
    case PH_SERIAL:   return "разбор команд с клавиатуры";
    case PH_STATUS:   return "печать статистики";
    case PH_TXSYNC:   return "синхронная отправка 8 строк в SPI панели";
    case PH_WINDOW:   return "открытие окна панели (CS/DC)";
    case PH_DRAIN:    return "ожидание панели (прошлый кадр ещё уезжает)";
    case PH_UIWAIT:   return "ожидание места в очереди (экран интерфейса)";
    case PH_HELP:     return "печать справки/команд";
    case PH_SNDISR:   return "внутри прерывания звука (звук не вернулся!)";
    case PH_KEYS:     return "чтение кнопок";
    case PH_BB:       return "запись в чёрный ящик (flash)";
    case PH_TRACE:    return "печать следа кадра";
    case PH_GATE:     return "ждём панель перед кадром";
    case PH_FAULT:    return "АППАРАТНЫЙ СБОЙ (HardFault)";
    case PH_STALL:    return "ЦИКЛ ЗАЛИП (звук при этом шёл!)";
    case PH_DIP:      return "ПРОСАДКА ПИТАНИЯ (панель/подсветка/звук тянут ток)";
    default:          return "неизвестно";
  }
}

// Причина сброса от самого чипа (нужна уже в отчёте о загрузке, поэтому объявлена
// здесь, а не в блоке свидетелей): VREG_AND_CHIP_RESET->CHIP_RESET по адресу 0x40064008.
//   бит 8  HAD_POR         — сброс от схемы контроля питания (питание пропадало/проседало)
//   бит 16 HAD_RUN         — сброс по выводу RUN
//   бит 20 HAD_PSM_RESTART — сброс из отладочного порта
#ifndef GBEMU_HOST
#define SYS_CHIP_RESET ((uint32_t)(*(volatile uint32_t *)0x40064008u))
#else
extern volatile uint32_t gHostChipReset;      // определяется стендом
#define SYS_CHIP_RESET ((uint32_t)gHostChipReset)
#endif

// отчёт после перезагрузки: печатается в самом начале setup().
// ВАЖНО: печатаем ВСЕГДА и всегда называем причину. Scratch-регистры переживают
// ЛЮБОЙ сброс, но обнуляются, когда питание действительно пропадало — поэтому
// по ним и видно, «консоль выключилась» или «консоль перезагрузилась».
static void bootReport(void) {
  const bool wdt  = watchdog_caused_reboot();
  const bool ours = watchdog_enable_caused_reboot();
  const uint32_t ph  = watchdog_hw->scratch[0];
  const uint32_t fr  = watchdog_hw->scratch[1];
  const uint32_t sec = watchdog_hw->scratch[2];
  const uint32_t mg  = watchdog_hw->scratch[3];
  const uint32_t pcg = watchdog_hw->scratch[7];
  const bool powered = (watchdog_hw->scratch[5] == WD_POWER);

  if (mg == WD_MAGIC) {                        // отметки прошлого запуска целы
    Serial.print(F("последний вздох прошлого запуска: фаза "));
    Serial.print(phaseName(ph));
    Serial.print(F(", кадров "));   Serial.print(fr);
    Serial.print(F(", прожили "));  Serial.print(sec); Serial.print(F(" с"));
    if (pcg) { Serial.print(F(", PC игры 0x")); Serial.print(pcg, HEX); }
    Serial.println();
  }
  if (powered) {
    Serial.println(F("причина перезагрузки: питание снималось ШТАТНО (клавиша q или удержание) — это не зависание."));
  } else if (wdt && !(SYS_CHIP_RESET & (1u << 16))) {
    Serial.println(F("!! ПРОШЛЫЙ ЗАПУСК ЗАВЕРШИЛСЯ ПЕРЕЗАГРУЗКОЙ ОТ СТОРОЖА (значит, прошивка где-то встала)."));
    if (ours) Serial.println(F("   (сторож был включён прошивкой, значит встали именно мы)"));
  } else if (wdt) {
    // v8.9q: ФЛАГ «сторож заведён» — НЕ доказательство, что он сработал. В pico-sdk
    // watchdog_caused_reboot() смотрит на метку, которую сторож ставит при ВКЛЮЧЕНИИ, а
    // чип говорит, что сброс был по выводу RUN. Раньше мы в этом случае врали в логе.
    Serial.println(F("сброс пришёл по выводу RUN (внешняя схема/кнопка); сторож при этом просто был заведён."));
  } else if (mg == WD_MAGIC) {
    Serial.println(F("причина перезагрузки: обычный сброс (кнопка RUN, загрузчик, прошивка) — питание НЕ пропадало."));
  } else {
    // v8.9l: не врём про «выключение». Если чип говорит, что питание НЕ пропадало
    // (HAD_POR=0), а сброс был по RUN/загрузчику — так и скажем: отметки сторожевого
    // домена теряются при сбросе, поэтому «отметок нет» ≠ «питание пропадало».
    const uint32_t cr0 = SYS_CHIP_RESET;
    if (!(cr0 & (1u << 8)) && (cr0 & ((1u << 16) | (1u << 20))))
      Serial.println(F("причина перезагрузки: отметок нет, но HAD_POR=0 — ПИТАНИЕ НЕ ПРОПАДАЛО: сброс по выводу RUN (кнопка/загрузчик/схема), а не выключение."));
    else
      Serial.println(F("причина перезагрузки: отметок нет — похоже на полное выключение (или пропадание питания)."));
  }
  // Что об этом говорит сам чип (независимо от наших отметок)
  {
    const uint32_t cr = SYS_CHIP_RESET;
    const bool por = (cr & (1u << 8)) != 0;      // HAD_POR
    const bool run = (cr & (1u << 16)) != 0;     // HAD_RUN
    const bool psm = (cr & (1u << 20)) != 0;     // HAD_PSM_RESTART
    Serial.print(F("причина сброса из чипа: HAD_POR=")); Serial.print(por ? 1 : 0);
    Serial.print(F(" (питание), HAD_RUN=")); Serial.print(run ? 1 : 0);
    Serial.print(F(" (вывод RUN), HAD_PSM=")); Serial.print(psm ? 1 : 0);
    Serial.println();
    if (por)
      Serial.println(F("   => чип сбросился от схемы контроля питания: питание ДЕЙСТВИТЕЛЬНО проседало или пропадало."));
    else if (run)
      Serial.println(F("   => сброс по выводу RUN (кнопка сброса / загрузчик / внешняя схема)."));
    else if (psm)
      Serial.println(F("   => сброс из отладочного порта (PSM)."));
    else
      Serial.println(F("   => ни питания, ни RUN, ни отладки: похоже на свежее включение без отметок."));
  }
  if (watchdog_hw->scratch[6]) {
    Serial.print(F("   ВНИМАНИЕ: прерывание звука не вернулось. Отметка "));
    Serial.print(watchdog_hw->scratch[6]);
    Serial.println(F(" (1 = вошли в прерывание, 2 = синтез семпла, 3 = запись в ШИМ)"));
  }
  watchdog_hw->scratch[0] = PH_BOOT;
  watchdog_hw->scratch[1] = 0;
  watchdog_hw->scratch[2] = 0;
  watchdog_hw->scratch[3] = 0;
  watchdog_hw->scratch[5] = 0;
  watchdog_hw->scratch[6] = 0;
  watchdog_hw->scratch[7] = 0;
}

// ============================================================ диагностика кадра
// Путь вывода кадра теперь СИНХРОННЫЙ (он проверен на этой консоли в v5-v7), а свой
// канал DMA включается клавишей u как опыт. Причина, почему вывод был «узким местом»,
// оказалась не в коде, а в ЧАСТОТЕ SPI: периферийные часы clk_peri на устройстве были
// 48 МГц, а SPI не может быть быстрее clk_peri/2 → любые просьбы давали ровно 24 МГц.
// 115 КБ кадра при 24 МГц — это 38 мс, отсюда и «кадр с выводом 45.8 мс». Теперь
// clk_peri поднимается до системной (250 МГц), и панель получает 62,5 или 125 МГц.
//
// Переключатели (клавиша j) оставлены для сравнения:
//   drawMode 0 — норма (v8): две точки одним 32-битным словом;
//            1 — старый цикл записи (одиночные 16-битные слова) — для сравнения;
//            2 — строки заливаются одним цветом: стоимость записи БЕЗ поиска
//                пикселей в таблице цветов;
//            3 — коллбэк не делает ничего: панель не обновляется (картинка
//                замирает), зато видно чистую скорость ядра peanut.
// Клавиша j перебирает 0 -> 1 -> 2 -> 3 -> 0.
// (режимы теста вывода убраны в v8.5: путь вывода теперь один, а тест панели — клавиша j)

// ============================================================ железо
#define PIN_SCK    18
#define PIN_MOSI   19
#define PIN_MISO   16
#define PIN_CS      3
#define PIN_DC      2
#define PIN_RST     4
#define PIN_BL      7
#define PIN_AUDIO   17                 // ШИМ-звук (в стоке: pwm_init(17,1,689))

// найдено в дампе: сток при выключении сбрасывает GPIO1 и GPIO12
#define PIN_PWR_HOLD   1               // ключ питания (защёлка) — держим HIGH
#define PIN_EN12      12               // в стоке тоже уходит в 0 при выключении
#define PIN_EN20      20               // в стоке поднимается в 1 при старте
#define PIN_AMP       PIN_EN20         // GP20 — похоже, разрешение усилителя

// ============================================================ звук: состояние
// Из дампа стока: звук выводится ШИМ-ом на GPIO17 (слайс 0, TOP = 689,
// «тишина» = уровень 344), а GP20 сток опускает в 0, когда пищит (похоже,
// это разрешение усилителя). Реализация — ниже, в разделе «ЗВУК: APU + ШИМ».
static volatile uint8_t  soundOn    = 1;
static volatile uint8_t  volPct     = 10;      // громкость эмулятора, % (умолчание v8.9u: было 30)
// Режимы-изоляторы, включаемые кнопкой при включении (см. setup):
static bool liteMode = false;                  // «лёгкий»: подсветка/звук выкл, SPI медленнее
static bool noPanelMode = false;               // «панель не трогаем»: SPI молчит
static bool quietPanel  = false;               // «тихая панель»: SPI 20,8 МГц
// Проба звука дала однозначный ответ: GP20 = LOW -> звук есть, GP20 = HIGH -> тишина.
// Все три опыта с LOW пищали, все три с HIGH молчали. Поэтому уровень только LOW,
// а режим AMP из меню убран (HIGH = просто глухо, выбирать нечего).
// v9.4: ГЛУШИМ УСИЛИТЕЛЬ НА НАСТОЯЩЕЙ ТИШИНЕ (как сток: GP20 = 0 только на время
// звука). А/Б-тесты показали: журчание — НАВОДКА ОТ НАГРУЗКИ (процессор + SPI
// панели), а не звук: при volume 0 оно оставалось, а в меню (игра стоит) пропадало.
// Пока идёт звук — GP20 = LOW; 2 с математической тишины подряд (все каналы
// молчат, DC-блокер срезал постоянку) — HIGH. Включение — вместе с мягким входом
// (gFade): щелчков вкл/выкл нет, в отличие от старого режима «по требованию» с
// его 100 мс и дребезгом. Тихая запись во flash глушит усилитель явно.
#define AMP_MUTE_TICKS  44444                 // 44444 × 45 мкс ≈ 2 с тишины — можно глушить
static volatile uint8_t  gAmpOn     = 0;      // 1 = усилитель включён (GP20 = LOW)
static volatile uint32_t gAmpSil    = 0;      // сколько тиков подряд длится тишина
static volatile uint8_t  soundPause = 0;       // 1 = молчать (меню/пауза/запись flash)
static bool              apuTimerOn = false;
static volatile uint16_t gFade = 256;         // v9.3: плавный вход/выход звука (256 = полная громкость)
static repeating_timer_t apuTmr;
// Темп звука. Игра у нас идёт медленнее настоящей (сейчас ~54 % скорости), а
// звук в v7 считался в реальном времени: ноты играли свои 60-е доли секунды,
// пока игра тянула их почти вдвое дольше — отсюда «мелодии страдают».
// Теперь по умолчанию темп звука следует за эмуляцией: семпл идёт реже ровно во
// столько раз, во сколько раз медленнее идёт игра, и всё (высота, длительности,
// конверты, темп) звучит синхронно с картинкой — как если бы консоль целиком
// работала медленнее. Клавиша y переключает: GAME (синхронно с игрой) / REAL.
static volatile uint8_t  soundSync = 1;
static uint16_t          apuTmrUs  = 45;       // период таймера звука, мкс
static uint32_t          syncEmaFps = 60;      // сглаженная оценка эмулированных кадров/с
static void soundInit(void);
static uint8_t volNow(void);          // v8.9p: громкость с учётом мягкого входа (нужна в прерывании)
static void soundSetOn(uint8_t on);
static void soundSuspend(void);
static void soundResume(void);
// v8.9q: тихая запись во flash — на время стирания гасим подсветку и глушим усилитель
static void quietFlashBegin(void);
static void quietFlashEnd(void);
// Состояние «тихой записи». Сами функции — ниже (рядом с подсветкой), а переменные
// объявлены здесь, потому что их трогает выключение питания, которое выше по файлу.
static bool     gQuietBusy = false;
static bool     gQuietNoLight = false;      // при выключении свет уже погашен — не трогаем
static uint32_t gQuietN = 0, gQuietBack = 0;
static void soundUpdatePause(void);
static void uiClear(uint8_t shade);      // объявлены заранее: нужны ниже по файлу (смена частоты SPI)
static void uiPush(void);
static uint8_t *uiRow(void);             // строка интерфейса в буфере отправки
static void uiRowSend(void);             // отправить её в панель
static void audioHwInit(void);
static void ampApply(void);

#define MEM_W      240
#define MEM_H      240
#define GAME_W     240                 // кадр GB 160x144 при масштабе 1.5x
#define GAME_ROWS  216
#define GAME_TOP   12                  // (240-216)/2
#define VB_STEP    ((GAME_ROWS * 256) / 144)   // 384 = ровно 1.5x, без делений

// v8.9n: ПО УМОЛЧАНИЮ 125 МГц. Опыт на консоли: именно на этой частоте игра идёт
// ровные 60 кадр/с (кадр занимает ~8 мс из 16,7). В стоке было ~100 МГц.
// v9.5: по умолчанию 62,5 МГц — тише шина (меньше наводки на усилитель: журчание
// под музыкой), а кадровый дифф компенсирует скорость трафиком. Клавиша o
// переключает: 62,5 -> 41,7 -> 20,8 -> 125.
#define SPI_HZ     125000000UL
#define FRAME_US   16743UL             // 59.7 кадр/с

// ============================================================ палитры
// Цвета заданы в обычном RGB (8 бит на канал!). Пересчёт в 565-формат делается
// здесь, в 8-битной арифметике — поэтому яркость/контраст реально работают
// (в прошлой версии я считал прямо в 565 и округление съедало весь эффект).
struct PaletteDef { const char *name; uint8_t c[4][3]; };   // c[0] светлый … c[3] тёмный

static const PaletteDef PALS[] = {
  { "BLUE",     { { 56, 73,113}, { 44, 58, 89}, { 34, 43, 66}, { 27, 32, 44} } },  // v9.7: тёмно-синяя под корпус (фото-замер; под контраст 120% по умолчанию)
  { "LINK",     { {150,163,120}, {101,112,80}, { 55, 62, 42}, { 12, 15, 12} } },  // ровные шаги
  { "POCKET",   { {197,206,164}, {139,149,106}, { 74, 80, 57}, { 24, 28, 24} } },
  { "POCKET-D", { {172,181,142}, {120,129, 90}, { 62, 68, 48}, { 18, 22, 18} } },
  { "DMG",      { {155,188, 15}, {139,172, 15}, { 48, 98, 48}, { 15, 56, 15} } },
  { "GRAY",     { {255,255,255}, {171,171,171}, { 84, 84, 84}, {  0,  0,  0} } },
  { "B/W",      { {255,255,255}, {130,130,130}, { 64, 64, 64}, {  0,  0,  0} } },
  { "AMBER",    { {255,204,102}, {209,138, 43}, {138, 75, 18}, { 26, 14,  0} } },
  { "VIVID",    { {197,255, 49}, {140,198, 74}, { 66, 49, 58}, { 33, 28, 33} } },
};
static const int PAL_COUNT = sizeof(PALS) / sizeof(PALS[0]);
static uint8_t palIdx = 0;                    // BLUE — умолчание v9.3 (в цвет корпуса)
static uint8_t bright = 100;                  // яркость 50..150 %
static uint8_t contr  = 120;                  // контраст 50..200 % — умолчание v9.3 (было 140 — многовато)
static bool    invertShades = false;

static uint16_t curPal[4];                    // итоговые цвета (565)
static uint16_t uiColSw[4];                   // то же, но байты уже в порядке отправки

// Таблица «байт пикселя от ядра -> байты цвета для панели».
// ВАЖНО: ядро УЖЕ применило палитру игры (BGP/OBP0/OBP1) — в пикселе лежит
// готовый номер оттенка 0..3, биты 5-4 — только метка слоя (BG/OBJ0/OBJ1).
// Применять палитру второй раз НЕЛЬЗЯ: именно это съедало детали спрайтов
// (при OBP0=0xD0 оттенок 2 уезжал в самый светлый — «пересвеченные» персонажи).
static uint16_t colTab[256];        // оттенок -> цвет 565 (для нечётного пикселя: одна точка)
static uint32_t col32[256];         // тот же цвет, продублированный: две точки одним 32-битным словом

static void rebuildColTab(void) {
  for (int p = 0; p < 256; p++) {
    const uint16_t c = curPal[p & 3];                   // оттенок уже выбран ядром
    colTab[p] = (uint16_t)((c >> 8) | (c << 8));        // байты в порядке отправки
    col32[p]  = (uint32_t)colTab[p] | ((uint32_t)colTab[p] << 16);  // две точки одним словом
  }
}

static inline int clamp8(int v) { return v < 0 ? 0 : (v > 255 ? 255 : v); }

static uint16_t to565(int r, int g, int b) {  // с округлением, а не отбрасыванием
  return (uint16_t)(((r * 31 + 127) / 255) << 11 | ((g * 63 + 127) / 255) << 5 | ((b * 31 + 127) / 255));
}

static void rebuildPalette(void) {
  for (int i = 0; i < 4; i++) {
    const int k = invertShades ? (3 - i) : i;
    int r = PALS[palIdx].c[k][0], g = PALS[palIdx].c[k][1], b = PALS[palIdx].c[k][2];
    r = 128 + ((r - 128) * contr) / 100;      // контраст вокруг середины
    g = 128 + ((g - 128) * contr) / 100;
    b = 128 + ((b - 128) * contr) / 100;
    r = (clamp8(r) * bright + 50) / 100;      // яркость
    g = (clamp8(g) * bright + 50) / 100;
    b = (clamp8(b) * bright + 50) / 100;
    curPal[i]  = to565(clamp8(r), clamp8(g), clamp8(b));
    uiColSw[i] = (uint16_t)((curPal[i] >> 8) | (curPal[i] << 8));
  }
  rebuildColTab();
}

