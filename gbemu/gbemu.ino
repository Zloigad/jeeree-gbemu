// ============================================================ КАРТРИДЖИ (несколько игр)
// Игры лежат НЕ в прошивке, а в отдельной области flash — её кладёт упаковщик
// tools/roms_pack/make_roms_uf2.py (файл games.uf2). Такая раскладка выбрана затем,
// что область игр НЕ зависит от размера прошивки: прошили новую версию — игры и их
// сейвы на месте, и НИ ОДИН байт flash при этом не перезаписывается.
// v9.0: область переехала с 0x100000 на 0x80000 (+512 КБ под игры: прошивка
// ~135 КБ, граница стояла с огромным запасом). Сейвы/стейты — ниже границы.
//
//   0x80000..0x80FFF    таблица игр (заголовок 16 Б + записи RomEntry)
//   0x81000..0x81FFF    «какая игра выбрана последней» (пишет консоль, только при смене)
//   0x82000..0x1FD000   сами игры (образы, каждый выровнен на 4 КиБ), 1516 КБ
//
// Верх области (0x1FD000..0x200000) — область картриджа (SRAM) и чёрный ящик, как было.
#define ROMS_TABLE_OFF   0x80000UL
#define ROMS_STATE_OFF   0x81000UL
#define ROMS_DATA_OFF    0x82000UL
#define ROMS_MAGIC       0x32524D47UL     // "GMR2" (v9.0: область переехала, старые наборы не читаем)
#define ROMS_STATE_MAGIC 0x31545347UL     // "GST1"
#define ROM_NAME_LEN     24
#define ROM_MAX          48

struct RomEntry {                      // 44 байта; раскладка должна совпадать с make_roms_uf2.py
  char     name[ROM_NAME_LEN];         // имя игры (из заголовка образа)
  uint32_t off;                        // смещение образа от начала flash
  uint32_t size;                       // размер образа (степень двойки)
  uint32_t crc;                        // CRC32 образа: ключ сейва SRAM этой игры
  uint32_t sram;                       // размер памяти сохранений (0 — нет)
};

