      Serial.print(F("  ->  к моменту записи: A0=")); Serial.print(p[36] >> 16);
      Serial.print(F(" A3=")); Serial.println(p[37] & 0xFFFFu);
    }
    if (p[45] != 0xFFFFFFFFu && p[45] != 4095u) {
    Serial.print(F("   питание в записи: минимум за 0,25 с = ")); Serial.print(p[45]);
    Serial.print(F(" (максимум ")); Serial.print(p[46]);
    Serial.print(F(", самый глубокий провал за сеанс ")); Serial.print(p[47]);
    Serial.println(F(")"));
    Serial.print(F("   если минимум сильно ниже нормы (")); Serial.print(battBRaw);
    Serial.println(F(") — питание просаживается прямо перед смертью"));
  }
  Serial.print(F("   наша прошивка снимала питание ")); Serial.print(p[38]); Serial.println(F(" раз(а) за тот запуск"));
  if (p[49] != 0xFFFFFFFFu) {
    Serial.print(F("   операций с flash за тот запуск: ")); Serial.print(p[50]);
    Serial.print(F(" (отметок ")); Serial.print(p[49]);
    Serial.print(F(", стираний ")); Serial.print(p[48]);
    Serial.print(F("), последняя заняла ")); Serial.print(p[51]); Serial.println(F(" мкс"));
  }
    if (p[1] != PH_POWERCUT && p[1] != PH_FAULT && p[1] != PH_STALL)
      Serial.println(F("   ВЫВОД: записи о снятии питания НЕТ — значит питание ушло не по нашей вине"));
    if (p[1] != PH_POWERCUT && p[1] != PH_FAULT && p[1] != PH_STALL)
      Serial.println(F("          (смотрите выше числа АЦП: садилось ли питание перед смертью)"));
  }
  if ((p[28] || p[29] || p[30] || p[31]) && p[28] != 0xFFFFFFFFu)
    Serial.println(F("   стек: указатели были записаны — смотрите строку «стек» ниже"));
  if (p[1] == PH_POWERCUT) Serial.println(F("   (это было ШТАТНОЕ выключение, а не зависание)"));
}

static uint32_t fnv1a(const uint8_t *p, int n) {
  uint32_t h = 2166136261u;
  while (n--) { h ^= *p++; h *= 16777619u; }
  return h;
}

// ============================================================ v9.7: НАСТРОЙКИ ПЕРЕЖИВАЮТ ВЫКЛЮЧЕНИЕ
// Последний сектор flash (0x1FF000) был зарезервирован под «EEPROM ядра», но не
// занят — держим там настройки пользователя. Пишем при штатном выключении,
// читаем в самом начале загрузки.
#define SET_OFF     (FLASH_TOTAL - FLASH_RESERVE)   // последний сектор flash
#define SET_MAGIC   0x31544553UL                    // "SET1"

static void settingsLoad(void) {
  const uint8_t *p = (const uint8_t *)(flashBase + SET_OFF);
  uint32_t magic = 0, crc = 0;
  memcpy(&magic, p, 4); memcpy(&crc, p + 16, 4);
  if (magic != SET_MAGIC) {
    Serial.println(F("настроек во flash нет — работаем как задумано по умолчанию"));
    return;
  }
  if (crc != fnv1a(p, 16)) {
    Serial.println(F("настройки во flash повреждены — беру значения по умолчанию"));
    return;
  }
  lightUser = p[8]; bright = p[9]; contr = p[10]; volPct = p[11];
  palIdx = p[12]; invertShades = p[13] != 0; soundOn = p[14] != 0; spiHzIdx = p[15];
  // зажимаем в допустимых пределах (файл мог записаться другой версией)
  if (bright < 50 || bright > 150) bright = 100;
  if (contr  < 50 || contr  > 200) contr  = 120;
  if (volPct > 10) volPct = 10;                       // мягкий лимит громкости (v9.7)
  if (palIdx >= PAL_COUNT) palIdx = 0;
  if (spiHzIdx >= (int)(sizeof(SPI_HZ_TAB) / sizeof(SPI_HZ_TAB[0]))) spiHzIdx = 0;
  Serial.println(F("настройки восстановлены из flash (свет/яркость/контраст/громкость/палитра)"));
}

// v9.7.2: запись во flash — как и все остальные писатели: «тихо» (свет/звук/
// усилитель прочь) и с ВЫКЛЮЧЕННЫМИ прерываниями. Прерывание звука само сидит в
// ОЗУ, но зовёт код из flash, а на время стирания flash выключен из шины — без
// защиты чип падал (консоль «перезагружалась» вместо выключения), сектор уже был
// стёрт, и настройки пропадали. Ещё и сверяем запись: если не подтвердилась —
// пробуем ещё раз.
static bool settingsWrite(const uint8_t *page) {
  quietFlashBegin();
  noInterrupts();
  flash_range_erase(SET_OFF, BLK_SECTOR);        // свой сектор, сейвы не трогает
  flash_range_program(SET_OFF, page, 256);
  interrupts();
  quietFlashEnd();
  return memcmp((const void *)(flashBase + SET_OFF), page, 20) == 0;
}

static void settingsStore(void) {
  uint8_t page[256];
  memset(page, 0xFF, sizeof(page));
  uint32_t v = SET_MAGIC; memcpy(page, &v, 4);
  v = 1; memcpy(page + 4, &v, 4);
  page[8]  = lightUser;   page[9]  = bright;    page[10] = contr;
  page[11] = volPct;      page[12] = palIdx;    page[13] = invertShades ? 1 : 0;
  page[14] = soundOn ? 1 : 0;                    page[15] = spiHzIdx;
  v = fnv1a(page, 16); memcpy(page + 16, &v, 4);
  if (!settingsWrite(page)) {
    Serial.println(F("!! запись настроек не подтвердилась — пробую ещё раз"));
    (void)settingsWrite(page);
  }
  Serial.println(F("настройки записаны во flash"));
}

// настройки в ОЗУ отличаются от того, что лежит во flash?
static bool settingsDirty(void) {
  const uint8_t *p = (const uint8_t *)(flashBase + SET_OFF);
  uint32_t magic = 0, crc = 0;
  memcpy(&magic, p, 4); memcpy(&crc, p + 16, 4);
  if (magic != SET_MAGIC || crc != fnv1a(p, 16)) return true;   // пусто или бито
  return p[8] != lightUser || p[9] != bright || p[10] != contr || p[11] != volPct
      || p[12] != palIdx || p[13] != (invertShades ? 1 : 0)
      || p[14] != (soundOn ? 1 : 0) || p[15] != spiHzIdx;
}

static void saveInit(size_t wantBytes, int banks) {
  if (!flashEnd) flashEnd = (uintptr_t)&__flash_binary_end;
  uintptr_t end = (flashEnd + 4095u) & ~(uintptr_t)4095u;
  if (end < flashBase) end = flashBase;
  const uint32_t usedOff = (uint32_t)(end - flashBase);
  // ВАЖНО: место считаем как данные + заголовок, иначе последние 256 байт
  // сохранения не влезали (нашёл и исправил).
  // ВАЖНО: pico-sdk требует, чтобы flash_range_erase() стирал ЦЕЛЫМИ секторами
  // (4096 байт). Поэтому размер области всегда кратен 4096: иначе для картриджа
  // с 32 КиБ SRAM получалось 33024 байта (не кратно сектору) — стирание уезжало.
  size_t need = wantBytes + SAVE_HDR;
  if (need > sizeof(cartRam) + SAVE_HDR) need = sizeof(cartRam) + SAVE_HDR;
  const int want = (int)((need + 4095u) & ~(size_t)4095u);
  // Верхняя граница: при залитом наборе игр — НИЖЕ области картриджей (ROMS_TABLE_OFF, с v9.0 это 0x80000),
  // чтобы сейвы и сейвстейты её никогда не тронули.
  const uint32_t limit = romCount ? ROMS_TABLE_OFF : FLASH_LIMIT;
  if (banks < 1) banks = 1;
  if (banks > SAVE_BANKS) banks = SAVE_BANKS;
  while (banks > 1 && (uint32_t)want * (uint32_t)banks > (limit - usedOff)) banks--;
  if (usedOff + (uint32_t)want > limit) {           // места нет вообще
    saveLen = 0; saveData = 0; bankCount = 0;
    Serial.println(F("Сейвы: НЕТ МЕСТА во flash (образ почти 2 МБ) — сохранение выключено"));
    return;
  }
  if ((uint32_t)want * (uint32_t)banks > (limit - usedOff)) banks = 1;
  bankCount = banks;
  saveLen  = want;
  saveData = want - SAVE_HDR;
  if (saveData > (int)sizeof(cartRam)) saveData = (int)sizeof(cartRam);
  uint32_t maxSeq = 0;
  for (int i = 0; i < bankCount; i++) {
    bankOff[i] = usedOff + (uint32_t)want * (uint32_t)i;
    const uint8_t *p = (const uint8_t *)(flashBase + bankOff[i]);
    uint32_t magic = 0, seq = 0;
    memcpy(&magic, p, 4); memcpy(&seq, p + SAVE_HDR_SEQ, 4);
    if (magic == SAVE_MAGIC && seq != 0xFFFFFFFFu && seq > maxSeq) maxSeq = seq;
  }
  saveSeqMax = maxSeq;
  saveBank = -1; saveHash = 0; saveOff = bankOff[0];
  Serial.print(F("Сейвы: "));
  Serial.print(bankCount); Serial.print(F(" ячеек по "));
  Serial.print(saveLen / 1024); Serial.print(F(" КиБ (данные "));
  Serial.print(saveData / 1024); Serial.print(F(" КиБ), flash 0x"));
  Serial.print((uint32_t)(flashBase + bankOff[0]), HEX);
  Serial.print(F("..0x")); Serial.print((uint32_t)(flashBase + bankOff[bankCount - 1] + (uint32_t)want - 1), HEX);
  Serial.println();
}

// v8.9o: у каждой игры из списка — СВОЯ ячейка. Ячейка узнаётся по клейму (CRC32
// образа); если своей нет, берём пустую или самую давно не писавшуюся.
// «Безымянные» ячейки прежних версий (16 байт заголовка = 0xFF) считаем сейвом
// встроенной игры и бережём до последнего — иначе Zelda из rom.h потеряла бы сейв.
static void saveBind(uint32_t key) {
  saveGameCrc = key; saveHash = 0; saveBank = -1;
  if (!saveLen || bankCount <= 0) return;
  int found = -1, victim = 0;
  uint32_t best = 0xFFFFFFFFu;
  for (int i = 0; i < bankCount; i++) {
    const uint8_t *p = (const uint8_t *)(flashBase + bankOff[i]);
    uint32_t magic = 0, len = 0, k = 0, nk = 0, seq = 0xFFFFFFFFu;
    memcpy(&magic, p, 4); memcpy(&len, p + 4, 4);
    memcpy(&k, p + SAVE_HDR_KEY, 4); memcpy(&nk, p + SAVE_HDR_KEY + 4, 4);
    memcpy(&seq, p + SAVE_HDR_SEQ, 4);
    bool legacy = false;
    if (k == 0xFFFFFFFFu) { k = 0; nk = 0xFFFFFFFFu; legacy = true; }   // ячейка прежних версий
    if (magic == SAVE_MAGIC && len == (uint32_t)saveLen && k == key && nk == ~key) {
      if (found < 0) found = i;
      continue;
    }
    uint32_t rank;
    if (magic != SAVE_MAGIC)                rank = 0u;                 // пустая — берём первой
    else if (legacy)                        rank = 0xFFFFFFFEu;        // «безымянная» — в самый конец
    else {
      if (seq > 0xFFFFFFFDu) seq = 0xFFFFFFFDu;
      rank = 1u + (0xFFFFFFFDu - seq);                                 // чем старше, тем раньше
    }
    if (rank < best) { best = rank; victim = i; }
  }
  saveBank = (found >= 0) ? found : victim;
  saveOff  = bankOff[saveBank];
  Serial.print(F("сейвы: ячейка ")); Serial.print(saveBank + 1); Serial.print(F(" из "));
  Serial.print(bankCount);
  Serial.println(found >= 0 ? F(" — сейв этой игры на месте")
                            : F(" — свободная (у этой игры сейва ещё нет)"));
}

static bool saveLoad(void) {
  if (!saveLen) return false;
  const uint8_t *p = (const uint8_t *)(flashBase + saveOff);
  uint32_t magic, len, hash;
  memcpy(&magic, p, 4); memcpy(&len, p + 4, 4); memcpy(&hash, p + 8, 4);
  if (magic != SAVE_MAGIC || (int)len != saveLen) return false;
  if (saveData <= 0 || saveData > (int)sizeof(cartRam)) return false;
  // v8.9o: в ячейке может лежать сейв ДРУГОЙ игры — такой грузить нельзя (ячейки
  // разные!). Ячейки прежних версий (клейма нет) считаем сейвом встроенной игры.
  uint32_t k = 0, nk = 0;
  memcpy(&k, p + SAVE_HDR_KEY, 4); memcpy(&nk, p + SAVE_HDR_KEY + 4, 4);
  if (k == 0xFFFFFFFFu) { k = 0; nk = 0xFFFFFFFFu; }
  if (k != saveGameCrc || nk != ~saveGameCrc) return false;
  memcpy(cartRam, p + SAVE_HDR, (size_t)saveData);
  if (fnv1a(cartRam, saveData) != hash) return false;
  saveHash = hash; cartDirty = false;
  return true;
}

// pico-sdk требует, чтобы flash_range_program() получал смещение, кратное 256,
// и длину, кратную 256. Поэтому и SRAM-сейв пишем целыми страницами одним
// потоком: первая страница — заголовок, дальше подряд идёт картриджная RAM.
static uint8_t  savePage[256];
static uint32_t savePageOff = 0;
static size_t   savePageFill = 0;

static void savePageWrite(void) {
  wdtFeed();                                  // страница пишется ~1 мс, но кормим на всякий случай
  if (savePageFill < 256) memset(savePage + savePageFill, 0xFF, 256 - savePageFill);
  flash_range_program(savePageOff, savePage, 256);
  savePageOff += 256;
  savePageFill = 0;
}

static void saveStreamBegin(uint32_t off) { savePageOff = off & ~(uint32_t)0xFF; savePageFill = 0; }

static void saveStream(const uint8_t *src, size_t n) {
  while (n) {
    const size_t room = 256 - savePageFill;
    const size_t take = n < room ? n : room;
    memcpy(savePage + savePageFill, src, take);
    savePageFill += take; src += take; n -= take;
    if (savePageFill == 256) savePageWrite();
  }
}

static void saveStreamEnd(void) { if (savePageFill) savePageWrite(); }

static void saveStore(bool verbose) {
  if (!saveLen)     { if (verbose) Serial.println(F("Сохранение недоступно (нет места во flash).")); return; }
  if (!saveActive)  { if (verbose) Serial.println(F("У этой игры нет памяти сохранений — сохранять нечего.")); return; }
  const int dataLen = saveData;
  const uint32_t h = fnv1a(cartRam, dataLen);
  if (!verbose && h == saveHash && !cartDirty) return;

  uint8_t hdr[SAVE_HDR];
  memset(hdr, 0xFF, sizeof(hdr));
  uint32_t magic = SAVE_MAGIC, len = saveLen, hash = h, neg = ~h;
  memcpy(hdr, &magic, 4); memcpy(hdr + 4, &len, 4); memcpy(hdr + 8, &hash, 4); memcpy(hdr + 12, &neg, 4);
  // v8.9o: клеймо игры (CRC32 образа) и поколение записи — по ним ячейка узнаётся,
  // когда игр несколько, и понятно, какую переиспользовать.
  uint32_t key = saveGameCrc, nkey = ~saveGameCrc;
  memcpy(hdr + SAVE_HDR_KEY, &key, 4); memcpy(hdr + SAVE_HDR_KEY + 4, &nkey, 4);
  // Поколение сперва ставим то, что уже лежит в ячейке: тогда сравнение с flash
  // честное и «нечего писать» остаётся «нечего писать». Новое поколение — только
  // если запись правда пошла.
  uint32_t cellSeq = 0;
  memcpy(&cellSeq, (const void *)(flashBase + saveOff + SAVE_HDR_SEQ), 4);
  if (cellSeq == 0xFFFFFFFFu) cellSeq = 0;
  if (cellSeq > saveSeqMax) saveSeqMax = cellSeq;
  memcpy(hdr + SAVE_HDR_SEQ, &cellSeq, 4);

  // БЕРЕЖЁМ FLASH (v8.9o): сперва только СМОТРИМ, есть ли что писать. Если во flash
  // уже ровно то же самое (игра SRAM не меняла), не стираем и не пишем НИЧЕГО.
  {
    const uint32_t nSec = ((uint32_t)saveLen + 4095u) / 4096u;
    bool anyDiff = false;
    for (uint32_t sec = 0; sec < nSec && !anyDiff; sec++) {
      const uint32_t base = sec * 4096u;
      const uint8_t *f = (const uint8_t *)(flashBase + saveOff + base);
      for (uint32_t k = 0; k < 4096u; k++) {
        const uint32_t i = base + k;
        uint8_t want;
        if (i < SAVE_HDR)                        want = hdr[i];
        else if ((int)(i - SAVE_HDR) < dataLen)  want = cartRam[i - SAVE_HDR];
        else                                     want = 0xFF;
        if (want != f[k]) { anyDiff = true; break; }
      }
    }
    if (!anyDiff) {
      saveHash = h; cartDirty = false; lastSaveMs = millis();
      mark(PH_LOOP);
      if (verbose) Serial.println(F("Сохранено: писать нечего — во flash уже всё так (ни стираний, ни записей)"));
      return;
    }
  }
  { const uint32_t seq = ++saveSeqMax; memcpy(hdr + SAVE_HDR_SEQ, &seq, 4); }

  const uint32_t t0 = millis();
  mark(PH_SAVE);
  Serial.print(F("пишу SRAM во flash (")); Serial.print(dataLen / 1024); Serial.print(F(" КиБ)..."));
  Serial.flush();
  quietFlashBegin();                    // v8.9q: тихая запись (свет гаснет, звук молчит)
  noInterrupts();
  // БЕРЕЖЁМ FLASH (v8.9l): совсем не обязательно стирать всю область заново, если игра
  // поменяла пару байт. Сравниваем нужный образ с тем, что лежит во flash, и трогаем
  // только изменившиеся сектора (4 КиБ). Обычно это 1 сектор из 3.
  {
    // байт №i собираемой записи (первые 16 байт — заголовок, дальше SRAM игры)
    struct { const uint8_t *hdr; const int len; } _ss = { hdr, dataLen };
    const uint32_t nSec = ((uint32_t)saveLen + 4095u) / 4096u;
    for (uint32_t sec = 0; sec < nSec; sec++) {
      const uint32_t base = sec * 4096u;
      const uint8_t *f = (const uint8_t *)(flashBase + saveOff + base);
      bool diff = false;
      for (uint32_t k = 0; k < 4096u; k++) {
        const uint32_t i = base + k;
        uint8_t want;
        if (i < SAVE_HDR)              want = _ss.hdr[i];
        else if ((int)(i - SAVE_HDR) < _ss.len) want = cartRam[i - SAVE_HDR];
        else                            want = 0xFF;
        if (want != f[k]) { diff = true; break; }
      }
      if (!diff) continue;                      // сектор не изменился — не стираем и не пишем
      flash_range_erase(saveOff + base, 4096u);
      saveErases++;
      for (uint32_t pg = 0; pg < 16u; pg++) {   // и записываем его страницы заново
        for (uint32_t k = 0; k < 256u; k++) {
          const uint32_t i = base + pg * 256u + k;
          uint8_t want;
          if (i < SAVE_HDR)              want = _ss.hdr[i];
          else if ((int)(i - SAVE_HDR) < _ss.len) want = cartRam[i - SAVE_HDR];
          else                            want = 0xFF;
          savePage[k] = want;
        }
        flash_range_program(saveOff + base + pg * 256u, savePage, 256);
      }
    }
  }
  interrupts();
  quietFlashEnd();

  saveHash = h; cartDirty = false; lastSaveMs = millis();
  mark(PH_LOOP);
  if (verbose) {
    Serial.print(F("Сохранено: ")); Serial.print(dataLen / 1024);
    Serial.print(F(" КиБ за ")); Serial.print(millis() - t0); Serial.println(F(" мс"));
  } else {
    Serial.print(F("автосейв ")); Serial.print(dataLen / 1024); Serial.print(F(" КиБ ("));
    Serial.print(millis() - t0); Serial.println(F(" мс)"));
  }
}

// Версия сборки: одна на весь скетч (баннер, 's' — чтобы в логах не было путаницы).
#define GBEMU_BUILD "v9.7.2"

// (подсветка переехала выше, перед автосбросом нагрузки — v8.9y)

// ============================================================ питание (как в стоке)
static void powerOff(void) {
  mark(PH_POWER);
  Serial.println(F("=== ВЫКЛЮЧЕНИЕ: снимаю ключ питания (GPIO1), как сток ==="));
  Serial.flush(); delay(30);                  // даём USB договорить (в журнале это важно)
  // v8.9q: ПОРЯДОК ВАЖЕН. Сначала гасим панель, подсветку и EN12 (это главные потребители),
  // и только потом пишем во flash. Раньше было наоборот: сначала запись, потом экран —
  // и стирание сектора шло на полной нагрузке. Именно так консоль и сбрасывалась по RUN.
  cmd1(0x28); cmd1(0x10);                     // DISPOFF, SLPIN
  analogWrite(PIN_BL, 0); digitalWrite(PIN_BL, LOW);
  digitalWrite(PIN_EN12, LOW);                // сток делает так же
  gQuietNoLight = true;                       // свет уже погашен — «тихая запись» его не трогает
  delay(30);
  Serial.println(F("=== экран погашен: сохраняю SRAM и отметки, затем снимаю питание ==="));
  saveStore(false);                           // сохраняем SRAM (пишется с выключенными прерываниями)
  romStateFlushAtExit();                      // и «какая игра», если она ждала лучшего питания
  settingsStore();                            // v9.7: настройки пользователя — тоже во flash
  Serial.flush(); delay(30);
  mark(PH_POWERCUT);                          // отметка «это штатное выключение»
  gPowerCutBy++;
  Serial.print(F("СНИМАЮ ПИТАНИЕ (это делает наша прошивка), раз №")); Serial.println(gPowerCutBy);
  Serial.println(F("   если после этого консоль выключилась — это НЕ сбой: так и задумано."));
  battRead(); blkWrite();                     // след в ящике ДО снятия питания
  blkFlush(true);                             // и ВСЁ кольцо ОЗУ — во flash: тут спешить некуда
  Serial.flush();
  watchdog_hw->scratch[5] = WD_POWER;         // её не затирает возврат из powerOff (если питание не снялось)
  for (int i = 0; i < 3; i++) { delay(20); wdtFeed(); }
  digitalWrite(PIN_PWR_HOLD, LOW);            // ключ питания -> питание снимается

  for (int i = 0; i < 8; i++) { delay(100); wdtFeed(); }   // ждём разряда питания
  // Если мы всё ещё живы — GPIO1 здесь не ключ питания: аккуратно возвращаемся.
  digitalWrite(PIN_PWR_HOLD, HIGH);
  digitalWrite(PIN_EN12, HIGH);
  gQuietNoLight = false;
  mark(PH_LOOP);
  Serial.print(F("SPI: ")); Serial.print(spi_get_baudrate(spi0) / 1000000.0f, 1); Serial.println(F(" МГц"));
  lcdInit();
  analogWrite(PIN_BL, backlight);   // v8.9u: родная яркость, а не 200
  Serial.println(F("!! Питание не снялось — вернул всё назад (GPIO1 у вас не ключ?)."));
}

static void printSaveState(void) {
  if (!saveLen) { Serial.println(F("сейвы: выключены (нет места)")); return; }
  Serial.print(F("сейв: ")); Serial.print(saveData / 1024); Serial.print(F(" КиБ, "));
  Serial.print(cartDirty ? F("есть несохранённое; ") : F("актуален; "));
  if (lastSaveMs) { Serial.print(F("последняя запись ")); Serial.print((millis() - lastSaveMs) / 1000); Serial.print(F(" с назад")); }
  else Serial.print(F("ещё не записывался"));
  Serial.println();
}

